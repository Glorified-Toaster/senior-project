			}
		}
		@sidebar.Inset() {
			<div class="flex h-full flex-col">
				<div class="flex h-14 items-center gap-4 px-6">
					@sidebar.Trigger()
					<span class="text-sm text-muted-foreground uppercase tracking-wider font-semibold">Dashboard</span>
				</div>
                <div class="flex-1 p-6 overflow-auto">
                    { children... }
