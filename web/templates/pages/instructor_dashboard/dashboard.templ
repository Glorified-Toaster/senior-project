package instructor_dashboard

import "fmt"
import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/toast"
import "uot-exam/web/templates/components/navbar"
import "uot-exam/web/templates/components/sidebar"
import "uot-exam/web/templates/components/collapsible"
import "uot-exam/web/templates/components/dropdown"
import "uot-exam/web/templates/components/popover"
import "uot-exam/web/templates/components/button"
import "uot-exam/web/templates/components/input"

templ DashboardPage(param DashboardPageParam) {
	<div class="h-screen">
		@sidebar.Script()
		@collapsible.Script()
		@dropdown.Script()
		@popover.Script()
		@toast.Script()
		@input.Script()
		@Navbar([]navbar.BreadPath{
			{
				Path: "Dashboard",
				Href: "/instructor/dashboard",
			},
		}) {

		<!-- Main Content -->
		<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
				<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
					<div>
						<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
							@icon.LayoutPanelTop(icon.Props{Class: "h-8 w-8 text-primary"})
							Instructor Dashboard
						</h1>
						<p class="text-slate-500 mt-1">Manage Your Assigned Subjects</p>
					</div>
					<div class="flex items-center gap-3">
						<div class="text-right hidden md:block">
							<p class="text-sm font-medium text-slate-900">{ param.Instructor.FullName }</p>
							<p class="text-xs text-slate-500">Instructor</p>
						</div>
						<div class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold border border-primary shrink-0">
							@icon.User(icon.Props{Class: "h-5 w-5"})
						</div>
					</div>
				</div>
					<div class="w-full md:w-72 flex items-center gap-2 mb-6">
						@icon.Search(icon.Props{Class: "h-4 w-4 text-slate-500"})
						@input.Input(input.Props{
							Type:        input.TypeText,
							Placeholder: "Search subjects...",
							ID:          "subject-search",
							Name:        "search",
							Class:       "w-full",
							Attributes: templ.Attributes{
								"hx-post":    "/instructor/subjects/search",
								"hx-trigger": "keyup changed delay:300ms",
								"hx-target":  "#subject-grid-container",
								"hx-swap":    "innerHTML",
							},
						})
					</div>

			<div id="subject-grid-container">
				@SubjectGrid(param.Subjects)
			</div>
		</main>}
	</div>
	<div id="toast-container"></div>
}

templ SubjectGrid(subjects []SubjectInfo) {
	if len(subjects) == 0 {
		@card.Card(card.Props{}) {
			@card.Content(card.ContentProps{Class: "p-12 text-center"}) {
				@icon.BookOpen(icon.Props{Class: "h-12 w-12 text-slate-300 mx-auto mb-4 mt-4"})
				<h3 class="text-lg font-semibold text-slate-600 mb-2">No Subjects Found</h3>
				<p class="text-slate-400 mb-4">No subjects match your search or you haven't been assigned to any yet.</p>
			}
		}
	} else {
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			for _, info := range subjects {
				<a href={ templ.SafeURL(fmt.Sprintf("/instructor/subject/%s", info.Subject.ID.String())) }>
					@card.Card(card.Props{
						Class: "h-full hover:shadow-lg hover:border-primary/50 transition-all duration-300 group hover:-translate-y-1",
					}) {
						@card.Header() {
							<div class="flex items-start justify-between">
								<div class="flex-1">
									@card.Title() {
										<span class="group-hover:text-primary transition-colors">{ info.Subject.Title }</span>
									}
									if info.Subject.Description != nil && *info.Subject.Description != "" {
										@card.Description() {
											{ *info.Subject.Description }
										}
									}
								</div>
								<div class="shrink-0 ml-2">
									<div class="p-2 rounded-lg bg-primary/10 text-primary">
										@icon.Book(icon.Props{Class: "h-5 w-5"})
									</div>
								</div>
							</div>
						}
						@card.Content() {
							<div class="space-y-3">
								<div class="flex items-center justify-between text-sm">
									<span class="text-slate-500 flex items-center gap-1.5">
										@icon.FileText(icon.Props{Class: "h-4 w-4"})
										Total Exams
									</span>
									<span class="font-medium">
										{ fmt.Sprintf("%d", info.TotalExams) }
									</span>
								</div>
								<div class="flex items-center justify-between text-sm pt-1">
									<span class="text-slate-500 flex items-center gap-1.5">
										@icon.Clock(icon.Props{Class: "h-4 w-4"})
										Duration
									</span>
									<span class="font-medium">{ fmt.Sprintf("%d min", info.Subject.DurationMinutes) }</span>
								</div>
								<div class="flex items-center justify-between text-sm">
									<span class="text-slate-500 flex items-center gap-1.5">
										@icon.Target(icon.Props{Class: "h-4 w-4"})
										Pass Score
									</span>
									<span class="font-medium">{ fmt.Sprintf("%.2f / %.2f", info.Subject.PassScore, info.Subject.TotalMarks) }</span>
								</div>
								<div class="pt-2">
									@button.Button(button.Props{
										Variant: button.VariantOutline,
										Size:    button.SizeSm,
										Class:   "w-full flex items-center justify-center gap-2 group-hover:bg-primary group-hover:text-white transition-colors",
									}) {
										@icon.Settings(icon.Props{Class: "h-4 w-4"})
										Manage Exams
									}
								</div>
							</div>
						}
					}
				</a>
			}
		</div>
	}
}

templ Navbar(breadPath []navbar.BreadPath) {
	<div class="flex h-full flex-col">
		@navbar.Navbar(navbar.Props{BreadPath: breadPath})
		<div class="flex-1 p-6 overflow-auto">
			{ children... }
		</div>
			</div>
}
