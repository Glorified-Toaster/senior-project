package components

import "uot-exam/internal/domain"
import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/radio"
import "uot-exam/web/templates/components/label"
import "fmt"
import "uot-exam/web/templates/components/aspectratio"
import "uot-exam/web/templates/components/button"
import "uot-exam/web/templates/components/dialog"
import "uot-exam/web/templates/components/input"
import "uot-exam/web/templates/components/textarea"

type QuestionListProps struct {
	Questions []domain.Question
    Choices []domain.Choice
}

templ QuestionList(props QuestionListProps) {
    if len(props.Questions) == 0 {
        // Sample data for empty list
        @QuestionItem(domain.Question{
            QuestionTitle: "Solve the following differential equations:",
            QuestionText: `\[ L(G) = D(G) - A(G) = \begin{pmatrix} \deg(v_1) & -a_{12} & \cdots & -a_{1n} \\ -a_{21} & \deg(v_2) & \cdots & -a_{2n} \\ \vdots & \vdots & \ddots & \vdots \\ -a_{n1} & -a_{n2} & \cdots & \deg(v_n) \end{pmatrix} \]`,
        }, []domain.Choice{
            {ChoiceText: `\( c^2 = a^2 + b^2 \)`},
            {ChoiceText: `\( m = \frac{y_2 - y_1}{x_2 - x_1} \)`},
            {ChoiceText: `\( y = mx + b \)`},
            {ChoiceText: `\( \begin{pmatrix} 1 & 2 \\ 3 & 4 \end{pmatrix} \)`},
        }, 1)

        @QuestionItem(domain.Question{
            QuestionTitle: "What is the spectral radius of a graph?",
            QuestionText: `\[ \rho(G) = \max\{|\lambda_i| : \lambda_i \text{ eigenvalue of } A(G)\} \]`,
        }, []domain.Choice{
            {ChoiceText: "Option A"},
            {ChoiceText: "Option B"},
            {ChoiceText: "Option C"},
            {ChoiceText: "Option D"},
            {ChoiceText: "Option E"},
            {ChoiceText: "Option F"},
        }, 2)

@QuestionCodeItem(domain.Question{
    QuestionTitle: "give the output of the following code",
    QuestionText: `trait Area { fn area(&self) -> f64; }
struct Circle { r: f64 }
impl Area for Circle {
    fn area(&self) -> f64 { std::f64::consts::PI * self.r * self.r }
}
fn print_area<T: Area>(shape: &T) { println!("{}", shape.area()); }`,
}, []domain.Choice{
    {ChoiceText: `3.141592653589793`},
    {ChoiceText: `12.566370614359172`},
    {ChoiceText: `6.283185307179586`},
    {ChoiceText: `9.42477796076938`},
}, 3)

@ImageQuestionItem(domain.Question{
    QuestionTitle: "What is the spectral radius of a graph?",
    QuestionText: `https://media.springernature.com/lw1200/springer-static/image/art%3A10.1007%2Fs00373-021-02369-8/MediaObjects/373_2021_2369_Fig3_HTML.png`,
}, []domain.Choice{
    {ChoiceText: "Option A"},
    {ChoiceText: "Option B"},
    {ChoiceText: "Option C"},
    {ChoiceText: "Option D"},
}, 4)
    } else {
        for i, question := range props.Questions {
            @QuestionItem(question, nil, i+1)
        }
    }
}

templ QuestionItem(question domain.Question, choices []domain.Choice, number int) {
    @card.Card(card.Props{
        Class: "mb-6",
    }){
        @card.Header(){
            @card.Title(){
                <span class="font-bold">Q.{ fmt.Sprint(number) }. </span>
                <span class="latex-content">{question.QuestionTitle}</span>
            }
        }
        @card.Content(){
                <span class="latex-content">{question.QuestionText}</span>
        }

        @card.Footer(){
            <div class="grid grid-cols-2 gap-3 w-full">
            for i, choice := range choices {
                @ChoiceItem(choice, number, fmt.Sprintf("%c", 'A'+i))
            }
            </div>
        }
        @card.Footer(card.FooterProps{
            Class: "flex justify-end",
        }){
            @EditDialog()
            @DeleteDialog()        
        }

    }
}


templ ChoiceItem(choice domain.Choice, qIndex int, cIndex string) {
    @label.Label(label.Props{
        For:   fmt.Sprintf("q%d-option-%s", qIndex, cIndex),
        Class: "block cursor-pointer h-full",
    }) {
        @card.Card(card.Props{
            Class: "hover:border-primary/50 has-[:checked]:ring-1 has-[:checked]:ring-primary has-[:checked]:border-primary transition-all h-full",
        }) {
            @card.Content(card.ContentProps{
                Class: "p-3 flex items-center gap-3 h-full",
            }) {
                @radio.Radio(radio.Props{
                    ID:    fmt.Sprintf("q%d-option-%s", qIndex, cIndex),
                    Name:  fmt.Sprintf("question-%d-options", qIndex),
                    Value: cIndex,
                    Class: "peer hidden",
                })
                <div class="bg-muted peer-checked:bg-primary peer-checked:text-white transition-all text-muted-foreground w-8 h-8 flex items-center justify-center rounded-sm shrink-0">
                    <span>{ cIndex }</span>
                </div>
                <div class="flex-1">
                    <p class="text-md leading-tight font-medium">
                        { choice.ChoiceText }
                    </p>
                </div>
            }
        }
    }
}

templ QuestionCodeItem(question domain.Question, choices []domain.Choice, number int) {
        @card.Card(card.Props{
        Class: "mb-6",
    }){
        @card.Header(){
            @card.Title(){
                <span class="font-bold">Q.{ fmt.Sprint(number) }. </span>
                <span class="latex-content">{question.QuestionTitle}</span>
            }
        }
        @card.Content(){
                <div class="w-full rounded-md overflow-x-auto">
                    <pre><code class="language-rust">{question.QuestionText}</code></pre>
                </div>
        }

        @card.Footer(){
            <div class="grid grid-cols-2 gap-3 w-full">
            for i, choice := range choices {
                @ChoiceItem(choice, number, fmt.Sprintf("%c", 'A'+i))
            }
            </div>
        }
        @card.Footer(card.FooterProps{
            Class: "flex justify-end",
        }){

        @EditDialog()
        @DeleteDialog()
        
        }
    }
}

templ ImageQuestionItem(question domain.Question, choices []domain.Choice, number int) {
    @card.Card(card.Props{
        Class: "mb-6",
    }){
        @card.Header(){
            @card.Title(){
                <span class="font-bold">Q.{ fmt.Sprint(number) }. </span>
                <span class="latex-content">{question.QuestionTitle}</span>
            }
        }
        @card.Content(){
        <div class="w-full rounded-md overflow-x-auto">
	@aspectratio.AspectRatio(aspectratio.Props{
		Ratio: aspectratio.RatioWide,
		Class: "rounded-md overflow-hidden",
	}) {
		<img
			src="https://onlinelibrary.wiley.com/cms/asset/85e9fa0c-319d-4b19-888a-0833b0c72b02/jgt22801-fig-0003-m.jpg"
			alt="Example image"
			class="h-full w-full object-cover "
		/>
	}                </div>
        }

        @card.Footer(){
            <div class="grid grid-cols-2 gap-3 w-full">
            for i, choice := range choices {
                @ChoiceItem(choice, number, fmt.Sprintf("%c", 'A'+i))
            }
            </div>
        }
        @card.Footer(card.FooterProps{
            Class: "flex justify-end",
        }){

        @EditDialog()
        @DeleteDialog()        
        } 
    }
}

templ EditDialog() {
	@dialog.Dialog(dialog.Props{
		ID: "edit-dialog",
	}) {
		@dialog.Trigger() {
			@button.Button(button.Props{
            Variant: button.VariantLink,
            Size: button.SizeSm,
            Class: "text-primary",
        }){
            Edit
        }
		}
		@dialog.Content() {
			@dialog.Title() {
				Edit Question
			}
			@dialog.Description() {
				Edit question information
			}
			@dialog.Content() {
				@input.Input(input.Props{
					ID:    "edit-question-title",
                    Placeholder: "Question Title",
					Value: "",
				})
				@textarea.Textarea(textarea.Props{
					ID:    "edit-question-text",
                    Placeholder: "Question Text",
					Value: "",
				})
				@input.Input(input.Props{
					ID:    "edit-question-choices",
                    Placeholder: "Question Choices",
					Value: "",
				})
			}
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Size:    button.SizeSm,
				}) {
					Save
				}
				@button.Button(button.Props{
					Variant: button.VariantLink,
					Size:    button.SizeSm,
				}) {
					Cancel
				}
			}
		}
	}
}

templ DeleteDialog() {
	@dialog.Dialog(dialog.Props{
		ID: "delete-dialog",
	}) {
		@dialog.Trigger() {
			@button.Button(button.Props{
            Variant: button.VariantLink,
            Size: button.SizeSm,
            Class: "text-destructive",
        }){
            Delete
        }
		}
		@dialog.Content() {
			@dialog.Title() {
				Delete Question
			}
			@dialog.Description() {
				Delete question information
			}
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Size:    button.SizeSm,
				}) {
					Delete
				}
				@button.Button(button.Props{
					Variant: button.VariantLink,
					Size:    button.SizeSm,
                    Class: "flex item-center",
				}) {
					Cancel
				}
			}
		}
	}
}