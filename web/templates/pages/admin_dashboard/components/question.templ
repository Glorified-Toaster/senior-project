package components

import "uot-exam/internal/domain"
import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/radio"
import "uot-exam/web/templates/components/label"
import "fmt"
import "uot-exam/web/templates/components/aspectratio"
import "uot-exam/web/templates/components/button"
import "uot-exam/web/templates/components/dialog"
import "uot-exam/web/templates/components/input"
import "uot-exam/web/templates/utils"
import "uot-exam/web/templates/components/textarea"
import "github.com/google/uuid"
import "strconv"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/tabs"
import "uot-exam/web/templates/components/selectbox"
import "uot-exam/web/templates/components/badge"

type QuestionListProps struct {
	RoutePrefix string
	Questions []domain.Question
}

type EditExamPageParam struct {
	RoutePrefix string
	Exam       domain.Exam
	Questions  []domain.Question
}

templ QuestionList(props QuestionListProps) {
	<div class="space-y-4" id="question-list">
	for i, question := range props.Questions {
		switch question.QuestionType {
			case string(domain.QuestionTypeText):
				@QuestionItem(question, question.Choices, i+1)
			case string(domain.QuestionTypeCode):
				@QuestionCodeItem(question, question.Choices, i+1)
			case string(domain.QuestionTypeImage):
				@ImageQuestionItem(question, question.Choices, i+1)
		}
	}
	</div>
}

templ QuestionItem(question domain.Question, choices []domain.Choice, number int) {
	@card.Card(card.Props{
		Class: "mb-6",
	}) {
		@card.Header() {
			<div class="flex items-center justify-between gap-3 w-full">
				@card.Title() {
					<span class="font-bold">Q.{ fmt.Sprint(number) }. </span>
					<span class="latex-content">{ question.QuestionTitle }</span>
				}
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-auto"}) {
					{ fmt.Sprintf("%.2f", question.Marks) } Marks
				}
			</div>
		}
		@card.Content() {
			<span class="latex-content">{ question.QuestionText }</span>
		}
		@card.Footer() {
			<div class="grid grid-cols-2 gap-3 w-full">
				for i, choice := range choices {
					@ChoiceItem(choice, number, fmt.Sprintf("%c", 'A'+i))
				}
			</div>
		}
		@card.Footer(card.FooterProps{
			Class: "flex justify-end",
		}) {
			@EditDialog(question)
			@DeleteDialog(question.ID, question.ExamID)
		}
	}
}
templ ChoiceItem(choice domain.Choice, qIndex int, cIndex string) {
    @label.Label(label.Props{
        For:   fmt.Sprintf("q%d-option-%s", qIndex, cIndex),
        Class: "block cursor-pointer h-full",
    }) {
        @card.Card(card.Props{
            Class: fmt.Sprintf("hover:border-primary/50 has-[:checked]:ring-1 has-[:checked]:ring-primary has-[:checked]:border-primary transition-all h-full %s",
                templ.SafeClass(map[bool]string{
                    true: "border-green-500",
                }[choice.IsCorrect]),
            ),
        }) {
            @card.Content(card.ContentProps{
                Class: "p-3 flex items-center gap-3 h-full",
            }) {
                @radio.Radio(radio.Props{
                    ID:    fmt.Sprintf("q%d-option-%s", qIndex, cIndex),
                    Name:  fmt.Sprintf("question-%d-options", qIndex),
                    Value: cIndex,
                    Class: "peer hidden",
                })
                <div class={
                    "transition-all w-8 h-8 flex items-center justify-center rounded-sm shrink-0",
                    templ.KV("bg-correct text-white ", choice.IsCorrect),
                    templ.KV("bg-muted text-muted-foreground peer-checked:bg-primary peer-checked:text-white", !choice.IsCorrect),
                }>
                    <span>{ cIndex }</span>
                </div>
                <div class="flex-1">
                    <p class={
                        "text-md leading-tight font-medium",
                        templ.KV("text-green-500", choice.IsCorrect),
                    }>
                        { choice.ChoiceText }
                    </p>
                </div>
            }
        }
    }
}

templ QuestionCodeItem(question domain.Question, choices []domain.Choice, number int) {
	@card.Card(card.Props{
		Class: "mb-6",
	}) {
		@card.Header() {
			<div class="flex items-center justify-between gap-3 w-full">
				@card.Title() {
					<span class="font-bold">Q.{ fmt.Sprint(number) }. </span>
					<span class="latex-content">{ question.QuestionTitle }</span>
				}
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-auto"}) {
					{ fmt.Sprintf("%.2f", question.Marks) } Marks
				}
			</div>
		}
		@card.Content() {
			<div class="w-full rounded-md overflow-x-auto">
				<pre><code class="language-rust">{ question.QuestionText }</code></pre>
			</div>
		}
		@card.Footer() {
			<div class="grid grid-cols-2 gap-3 w-full">
				for i, choice := range choices {
					@ChoiceItem(choice, number, fmt.Sprintf("%c", 'A'+i))
				}
			</div>
		}
		@card.Footer(card.FooterProps{
			Class: "flex justify-end",
		}) {
			@EditDialog(question)
			@DeleteDialog(question.ID, question.ExamID)
		}
	}
}

templ ImageQuestionItem(question domain.Question, choices []domain.Choice, number int) {
	@card.Card(card.Props{
		Class: "mb-6",
	}) {
		@card.Header() {
			<div class="flex items-center justify-between gap-3 w-full">
				@card.Title() {
					<span class="font-bold">Q.{ fmt.Sprint(number) }. </span>
					<span class="latex-content">{ question.QuestionTitle }</span>
				}
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-auto"}) {
					{ fmt.Sprintf("%.2f", question.Marks) } Marks
				}
			</div>
		}
		@card.Content() {
			<div class="w-full rounded-md overflow-x-auto">
				<span class="latex-content">{ question.QuestionText }</span>
				@aspectratio.AspectRatio(aspectratio.Props{
					Ratio: aspectratio.RatioWide,
					Class: "rounded-md overflow-hidden",
				}) {
					<img
						src={ question.QuestionImage }
						alt="Question Image"
						class="h-full w-full object-cover "
					/>
				}
			</div>
		}
		@card.Footer() {
			<div class="grid grid-cols-2 gap-3 w-full">
				for i, choice := range choices {
					@ChoiceItem(choice, number, fmt.Sprintf("%c", 'A'+i))
				}
			</div>
		}
		@card.Footer(card.FooterProps{
			Class: "flex justify-end",
		}) {
			@EditDialog(question)
			@DeleteDialog(question.ID, question.ExamID)
		}
	}
}

templ EditDialog(question domain.Question) {
	@dialog.Dialog(dialog.Props{
		ID: fmt.Sprintf("edit-dialog-%s", question.ID),
	}) {
		@dialog.Trigger() {
			@button.Button(button.Props{
				Variant: button.VariantLink,
				Size:    button.SizeSm,
				Class:   "text-primary",
			}) {
				Edit
			}
		}
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					Edit Question
				}
				@dialog.Description() {
					Edit question information
				}
			}
			<form
				id={ fmt.Sprintf("edit-question-form-%s", question.ID) }
				hx-post={ fmt.Sprintf("/admin/dashboard/questions/edit/%s", question.ID) }
				hx-target="#toast-container"
				hx-swap="beforeend"
				enctype="multipart/form-data"
				hx-encoding="multipart/form-data"
			>
				<input type="hidden" name="question_type" value={ string(question.QuestionType) } />
				switch question.QuestionType {
					case "TEXT":
						@EditQuestionForm(question)
					case "CODE":
						@CodeQuestionForm(question)
					case "IMAGE":
						@ImageQuestionForm(question , false)
				}
			</form>
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Size:    button.SizeSm,
					Type:    "submit",
					Form:    fmt.Sprintf("edit-question-form-%s", question.ID),
				}) {
					Save
				}
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
				}) {
					Cancel
				}
			}
		}
	}
}

templ EditQuestionForm(question domain.Question) {
	@TextQuestionForm(question, "edit-question-preview")
}

templ DeleteDialog(questionID uuid.UUID, examID uuid.UUID) {
	@dialog.Dialog(dialog.Props{
		ID: fmt.Sprintf("delete-dialog-%s", questionID),
	}) {
		@dialog.Trigger() {
			@button.Button(button.Props{
				Variant: button.VariantLink,
				Size:    button.SizeSm,
				Class:   "text-destructive",
			}) {
				Delete
			}
		}
		@dialog.Content() {
			<form
				id={ fmt.Sprintf("delete-question-form-%s", questionID) }
				hx-delete={ fmt.Sprintf("/admin/dashboard/exam/%s/question/delete/%s", examID, questionID) }
				hx-target="#question-list"
				hx-swap="innerHTML"
			>
			@dialog.Title() {
				Delete Question
			}
			@dialog.Description() {
				Delete question information
			}
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant: button.VariantDestructive,
					Size:    button.SizeSm,
					Type:    button.TypeSubmit,
				}) {
					Delete
				}
				@dialog.Close() {
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
					}) {
						Cancel
					}
				}
			}
			</form>
		}
	}
}


templ QuestionPreview(ID , questionTitle, questionText string) {
	<div id={ID} class="latex-content">{ questionTitle }<br/>{ questionText }</div>
}

templ CodeQuestionForm(question domain.Question) {
		<div>
			@label.Label(label.Props{
				For: "question_title",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Pen(icon.Props{
					Class: "h-4 w-4",
				})
				Question Title
			}
			@input.Input(input.Props{
				Type: input.TypeText,
				Placeholder: "Question Title",
				ID: "question_title",
				Name: "question_title",
				Value: question.QuestionTitle,
				Class: "mb-4",
			})
		</div>
		<div>
			@label.Label(label.Props{
				For: "question_marks",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.BadgeCheck(icon.Props{
					Class: "h-4 w-4",
				})
				Question Marks
			}
			@input.Input(input.Props{
				Type: input.TypeNumber,
				ID: "question_marks",
				Name: "question_marks",
				Class: "mb-4",
				Value: fmt.Sprintf("%.2f", utils.IfElse(question.Marks > 0, question.Marks, 1.0)),
				Attributes: templ.Attributes{
					"min": "0.1",
					"step": "0.1",
				},
			})
		</div>
		
		<div>
			@label.Label(label.Props{
				For: "question_text",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Code(icon.Props{
					Class: "h-4 w-4",
				})
				Code Content
			}
			@textarea.Textarea(textarea.Props{
				Placeholder: "Enter code here...",
				ID: "question_text",
				Name: "question_text",
				Rows: 8,
				Value: question.QuestionText,
				Class: "mb-4 font-mono",
			})
		</div>
}

templ ImageQuestionForm(question domain.Question , imgReq bool) {
		<div>
			@label.Label(label.Props{
				For: "question_title",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Pen(icon.Props{
					Class: "h-4 w-4",
				})
				Question Title
			}
			@input.Input(input.Props{
				Type: input.TypeText,
				Placeholder: "Question Title",
				ID: "question_title",
				Name: "question_title",
				Value: question.QuestionTitle,
				Class: "mb-4",
			})
		</div>
		<div>
			@label.Label(label.Props{
				For: "question_marks",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.BadgeCheck(icon.Props{
					Class: "h-4 w-4",
				})
				Question Marks
			}
			@input.Input(input.Props{
				Type: input.TypeNumber,
				ID: "question_marks",
				Name: "question_marks",
				Class: "mb-4",
				Value: fmt.Sprintf("%.2f", utils.IfElse(question.Marks > 0, question.Marks, 1.0)),
				Attributes: templ.Attributes{
					"min": "0.1",
					"step": "0.1",
				},
			})
		</div>
		<div>
			@label.Label(label.Props{
				For: "question_image",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Image(icon.Props{
					Class: "h-4 w-4",
				})
				Question Image
			}
			if imgReq {
			@input.Input(input.Props{
				ID:         "question_image",
				Name:       "question_image",
				Value:      question.QuestionImage,
				Type:       input.TypeFile,
				Required:   true,
				FileAccept: "image/*",
				Class:      "mb-4",
			})
			} else {
			@input.Input(input.Props{
				ID:         "question_image",
				Name:       "question_image",
				Value:      question.QuestionImage,
				Type:       input.TypeFile,
				FileAccept: "image/*",
				Class:      "mb-4",
			})
			}
		</div>
		<div>
			@label.Label(label.Props{
				For: "question_text",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.MessageSquareText(icon.Props{
					Class: "h-4 w-4",
				})
				Description (Optional)
			}
			@textarea.Textarea(textarea.Props{
				Placeholder: "Enter image description...",
				ID: "question_text",
				Name: "question_text",
				Rows: 3,
				Value: question.QuestionText,
				Class: "mb-4",
			})
		</div>
}

templ AddDialog(param EditExamPageParam) {
	@dialog.Dialog(dialog.Props{}) {
		@dialog.Trigger() {
			@button.Button(button.Props{
				Type: button.TypeButton,
			}) {
				@icon.Plus(icon.Props{
					Class: "h-4 w-4",
				})
				Add Question
			}
		}
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					Add Question
				}
				@dialog.Description() {
					Add a new question to the exam.
				}
			}
			@tabs.Tabs(tabs.Props{
				ID: "add_question_tabs",
			}) {
				@tabs.List(tabs.ListProps{
					Class: "w-full max-w-full",
				}) {
					@tabs.Trigger(tabs.TriggerProps{
						Value: "questions",
						IsActive: true,
						TabsID:   "add_question_tabs",
						Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
					}) {
						Question
					}
					@tabs.Trigger(tabs.TriggerProps{
						Value: "choices",
						TabsID:   "add_question_tabs",
						Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
					}) {
						Choices
					}
				}
				@tabs.Content(tabs.ContentProps{
					Value:    "questions",
					TabsID:   "add_question_tabs",
				}) {
					@AddQuestionForm(param)
				}
				@tabs.Content(tabs.ContentProps{
					Value:    "choices",
					TabsID:   "add_question_tabs",
				}) {
					@ChoicesTab()
				}
			}
			@dialog.Footer() {
				@button.Button(button.Props{
					Type: button.TypeSubmit,
					Form: "add_question_form",
				}) {
					Add Question
				}
			@dialog.Close(){
				@button.Button(button.Props{
					Type: button.TypeButton,
					Variant: button.VariantOutline,
				}) {
					Cancel
				}
			}

			}
		}
	}
}

templ AddQuestionForm(param EditExamPageParam) {
	<form id="add_question_form" 
		hx-post={ "/admin/dashboard/exam/"+ param.Exam.ID.String() +"/question/create" }
		hx-target="#question-list" 
		hx-swap="beforeend"
		enctype="multipart/form-data"
		hx-encoding="multipart/form-data"
		class="space-y-4">
		<div class="space-y-4">
			@label.Label(label.Props{
				For: "question_type_select",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Type(icon.Props{
					Class: "h-4 w-4",
				})
				Question Type
			}
			@selectbox.SelectBox() {
				@selectbox.Trigger(selectbox.TriggerProps{
					Name: "question_type",
					Attributes: templ.Attributes{
                        "id": "question_type_select",
						"hx-post": "/admin/dashboard/exam/preview/question-form",
						"hx-target": "#question-form-container",
						"hx-swap": "innerHTML",
                        "hx-trigger": "change",
					},
				}) {
					@selectbox.Value(selectbox.ValueProps{
						Placeholder: "Select Question Type",
					})
				}
				@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
					@selectbox.Group() {
						<div class="p-1">
						@selectbox.Item(selectbox.ItemProps{Value: string(domain.QuestionTypeText), Selected: true}) { Text }
						</div>
						<div class="p-1">
						@selectbox.Item(selectbox.ItemProps{Value: string(domain.QuestionTypeImage)}) { Image }
						</div>
						<div class="p-1">
						@selectbox.Item(selectbox.ItemProps{Value: string(domain.QuestionTypeCode)}) { Code }
						</div>
					}
				}
			}
		</div>
		<div id="question-form-container">
			@TextQuestionForm(domain.Question{}, "question-preview")
		</div>
	</form>
<script>
(function() {
    function initSelectBoxHTMX() {
        const trigger = document.getElementById('question_type_select');
        if (!trigger) return;
        
        const hiddenInput = trigger.querySelector('input[type="hidden"]');
        if (!hiddenInput) return;

        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.type === 'attributes' && mutation.attributeName === 'value') {
                    htmx.trigger(trigger, 'change');
                }
            });
        });

        observer.observe(hiddenInput, { attributes: true });
    }

    initSelectBoxHTMX();
    document.body.addEventListener('htmx:afterSwap', (e) => {
        if (e.detail.target.id === 'add_question_form' || e.detail.target.contains(document.getElementById('question_type_select'))) {
            initSelectBoxHTMX();
        }
    });
})();
</script>
<script>
document.body.addEventListener('htmx:afterSwap', function(event) {
    if (event.detail.target.id === "question-preview") {
        renderMathInElement(event.detail.target, {
            delimiters: [
                {left: '$$', right: '$$', display: true},
                {left: '$', right: '$', display: false},
                {left: '\\[', right: '\\]', display: true},
                {left: '\\(', right: '\\)', display: false}
            ],
            throwOnError: false
        });
    }
});
</script>
}

templ TextQuestionForm(question domain.Question, id string) {
		<div>
			@label.Label(label.Props{
				For: "question_title",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Pen(icon.Props{
					Class: "h-4 w-4",
				})
				Question Title
			}
			@input.Input(input.Props{
				Type: input.TypeText,
				Placeholder: "Question Title",
				ID: "question_title",
				Name: "question_title",
				Value: question.QuestionTitle,
				Class: "mb-4",
				Attributes: templ.Attributes{
					"hx-post": "/admin/dashboard/exam/preview/question-text",
					"hx-trigger": "keyup changed delay:300ms",
					"hx-target": "#question-preview",
					"hx-swap": "innerHTML",
				},
			})
		</div>
		<div>
			@label.Label(label.Props{
				For: "question_marks",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.BadgeCheck(icon.Props{
					Class: "h-4 w-4",
				})
				Question Marks
			}
			@input.Input(input.Props{
				Type: input.TypeNumber,
				ID: "question_marks",
				Name: "question_marks",
				Class: "mb-4",
				Value: "1",
				Attributes: templ.Attributes{
					"min": "0.1",
					"step": "0.1",
				},
			})
		</div>

		<div>
			@label.Label(label.Props{
				For: "question_text",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.MessageSquareText(icon.Props{
					Class: "h-4 w-4",
				})
				Question Text
			}
			@textarea.Textarea(textarea.Props{
				Placeholder: "Question Text",
				ID: "question_text",
				Name: "question_text",
				Rows: 3,
				Value: question.QuestionText,
				Class: "mb-4",
    			Attributes: templ.Attributes{
        "hx-post": "/admin/dashboard/exam/preview/question-text",
        "hx-trigger": "keyup changed delay:300ms",
        "hx-target": "#question-preview",
        "hx-swap": "innerHTML",
    },			})
		</div>
		<div>
			@label.Label(label.Props{
				For: "question_preview",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Eye(icon.Props{
					Class: "h-4 w-4",
				})
				Question Preview
			}
			@card.Card(card.Props{
				Class: "mb-6",
			}){
				@card.Content(){
					@QuestionPreview(id, `\[\text{Question Title}\]`, `\[\text{Question Text}\]`)
				}
			}
		</div>	
}


templ ChoicesTab() {
	<div class="flex flex-col space-y-4">
		@label.Label(label.Props{
			For: "question_choices",
			Class: "flex items-center gap-2 mb-4 mt-4",
		}) {
			@icon.List(icon.Props{
				Class: "h-4 w-4",
			})
			Question Choices
		}
		
		<div id="choices-container" class="space-y-3">
			for i := 1; i <= 4; i++ {
				@choiceItemCheckbox(i, i == 1)
			}
		</div>
		<script>
document.body.addEventListener('htmx:afterSwap', function(event) {
    if (event.detail.target.id === "question-choice-preview") {
        renderMathInElement(event.detail.target, {
            delimiters: [
                {left: '$$', right: '$$', display: true},
                {left: '$', right: '$', display: false},
                {left: '\\[', right: '\\]', display: true},
                {left: '\\(', right: '\\)', display: false}
            ],
            throwOnError: false
        });
    }
});
</script>
	</div>
}

templ choiceItemCheckbox(index int, isCorrect bool) {
	<div class="group flex items-center gap-3 rounded-md" data-index={ strconv.Itoa(index) }>
		<div class="flex-1 flex items-center gap-2">
			@input.Input(input.Props{
				Type: input.TypeText,
				Placeholder: "Choice " + strconv.Itoa(index),
				Name: "choice_" + strconv.Itoa(index),
				Class: "mb-0",
				Form: "add_question_form",
				Attributes: templ.Attributes{
					"hx-post": "/admin/dashboard/exam/preview/question-choice",
					"hx-trigger": "keyup changed delay:300ms",
					"hx-target": "#question-choice-preview-wrapper-" + strconv.Itoa(index),
					"hx-swap": "innerHTML",
				},
			})			
		</div>
		
		<div class="flex items-center gap-2 shrink-0">
			@radio.Radio(radio.Props{
				ID: "correct_choice_" + strconv.Itoa(index),
				Name: "correct_choice",
				Value: "choice_" + strconv.Itoa(index),
				Checked: isCorrect,
				Form: "add_question_form",
				Class: "mb-0",
				Attributes: templ.Attributes{
					"class": "h-4 w-4 cursor-pointer rounded",
					"onchange": "setCorrectChoice(this)",
				},
			})
			<label 
				for={ "correct_choice_" + strconv.Itoa(index) }
				class="text-sm cursor-pointer"
			>
				Correct
			</label>
		</div>
	</div>
<div class="flex justify-center" id={ "question-choice-preview-wrapper-" + strconv.Itoa(index) }>
        @QuestionChoicesPreview(fmt.Sprintf(`$\text{Choice %d}$`, index))
    </div>
	<script>
document.body.addEventListener('htmx:afterSwap', function(event) {
    if (event.detail.target.classList.contains('latex-preview-container') || 
        event.detail.target.querySelector('.latex-content')) {
        
        renderMathInElement(event.detail.target, {
            delimiters: [
                {left: '$$', right: '$$', display: true},
                {left: '$', right: '$', display: false},
                {left: '\\[', right: '\\]', display: true},
                {left: '\\(', right: '\\)', display: false}
            ],
            throwOnError: false
        });
    }
});
	</script>	
}

templ QuestionChoicesPreview(content string) {
    @card.Card(card.Props{
        Class: "mb-6",
    }){
        @card.Content(){
            <span class="latex-content">
                { content }
            </span>
        }
    }
}

templ AddViaCSVDialog(param EditExamPageParam) {

	@dialog.Dialog(dialog.Props{
		ID: "add_via_csv_dialog"}){
			@dialog.Trigger(){
				@button.Button(button.Props{
					Type: button.TypeButton,
					Variant: button.VariantSecondary,
					Size: button.SizeSm,
				}){
					@icon.Upload(icon.Props{
						Class: "h-4 w-4",
					})
					Add Questions via CSV
				}
			}
			
			@dialog.Content(dialog.ContentProps{
				Class: "m-10",
			}){
			<form id="add_via_csv_form"
				hx-post={ "/admin/dashboard/exam/" + param.Exam.ID.String() + "/question/upload-csv" }
				hx-target="#question-list"
				hx-swap="innerHTML"
				enctype="multipart/form-data"
				hx-encoding="multipart/form-data"
			>

			@dialog.Header(){
				@dialog.Title(){
					Add Questions via CSV
				}
				@dialog.Description(){
					Upload a CSV file to add questions to the exam
				}
			}
			@label.Label(label.Props{
				For: "file",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}){
				@icon.File(icon.Props{
					Class: "h-4 w-4",
				})
				CSV File
			}
			@input.Input(input.Props{
				Type: input.TypeFile,
				ID: "file",
				Name: "file",
				FileAccept: ".csv",
				Class: "mb-4",
			})
		
			@dialog.Footer(){
				@dialog.Close(){
					@button.Button(button.Props{
						Type: button.TypeButton,
						Variant: button.VariantOutline,
					}){
						Cancel
					}

				}
				@button.Button(button.Props{
					Type: button.TypeSubmit,
					Form: "add_via_csv_form",
					Variant: button.VariantDefault,
				}){
					Add Questions
				}
			}
			</form>
		}
	}
}