package components
import "strings"

import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/icon"
import "uot-exam/internal/domain"
import "uot-exam/web/templates/components/button"
import "uot-exam/web/templates/components/table"
import "uot-exam/web/templates/components/pagination"
import "uot-exam/web/templates/components/toast"
import "uot-exam/web/templates/components/badge"
import "fmt"
import "time"
import "uot-exam/web/templates/components/input"
import "uot-exam/web/templates/components/dialog"
import "uot-exam/web/templates/components/form"
import "uot-exam/web/templates/components/selectbox"
import "uot-exam/web/templates/components/tabs"
import "uot-exam/web/templates/components/upload"
import "uot-exam/web/templates/utils"

type UserTableProps struct {
	Users         []domain.User
	Title         string
	ID            string
	TotalCount    int64
	Limit         int32
	Offset        int32
	BaseURL       string
	ShowAllButton bool
	Search        bool
	SearchAPI     string
	AddUser       bool
	DeletedButton  bool
	RestoreButton  bool
	AddAPI        string
	AddUserCSV    bool
	HideActions   bool
	AddInstructor bool
	Instructors   []domain.User
	AddInstructorAPI string
	AddStudent bool
	Students []domain.User
	AddStudentAPI string
	InstructorAssignSwapTarget string
	StudentAssignSwapTarget string
	AddStudentCSVAPI string
	ExportURL string
	UnassignAPI string
}

templ UserTableRoot(wrapperID string, props UserTableProps) {
	<div id={ wrapperID }>
		@UserTable(props)
	</div>
}

templ UserTable(props UserTableProps) {
	@card.Card(card.Props{Class: "w-full overflow-hidden"}) {
		@card.Header(card.HeaderProps{Class: "p-0"}) {
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 bg-slate-50/50 p-4 rounded-t-xl">
				<div class="flex items-center gap-3">
					<div class="h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary shadow-sm ">
						@icon.Users(icon.Props{Class: "h-6 w-6"})
					</div>
					<div>
						<h3 class="text-xl font-bold text-slate-800 tracking-tight">
							{ props.Title }
						</h3>
						if props.TotalCount > 0 {
							<p class="text-xs text-slate-500 font-medium">{ fmt.Sprintf("%d total records", props.TotalCount) }</p>
						}
					</div>
				</div>
				<div class="flex flex-wrap items-center gap-2">
					if props.Search {
						<div class="relative group">
							<div class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-primary transition-colors">
								@icon.Search(icon.Props{Class: "h-4 w-4"})
							</div>
							@input.Input(input.Props{
								Type:        input.TypeSearch,
								Name:        "search",
								Placeholder: "Search users...",
								Class:       "pl-9 bg-white border-slate-200 focus:border-primary/50 focus:ring-primary/20 transition-all sm:w-64",
								Attributes: templ.Attributes{
									"hx-post":    props.SearchAPI,
									"hx-trigger": "keyup changed delay:300ms, search",
									"hx-target":  "#" + utils.IfElse(props.ID != "", props.ID, "users-table-container"),
									"hx-swap":    "outerHTML",
								},
							})
						</div>
					}

					<div class="flex items-center gap-2">
						if props.AddStudent {
							@AddStudentDialog(props)
						}

						if props.AddUser {
							@AddUserDialog(props.AddUserCSV)
						}
						
						if props.AddInstructor {
							@AddInstructorDialog(props)
						}
						
						if props.ExportURL != "" {
							@button.Button(button.Props{
								Variant: button.VariantOutline,
								Size:    button.SizeSm,
								Href:    props.ExportURL,
								Class:   "flex items-center gap-2 bg-white hover:bg-slate-50 border-slate-200 text-slate-700 shadow-sm transition-all",
								Attributes: templ.Attributes{
									"download": "",
									"title": "Export to CSV",
								},
							}) {
								@icon.Download(icon.Props{Class: "h-4 w-4"})
								<span class="hidden sm:inline">Export</span>
							}
						}
					</div>
				</div>
			</div>
		}
		@card.Content(card.ContentProps{Class: "p-4"}) {
			@UserTableContainer(props)
			if props.ShowAllButton {
				@button.Button(button.Props{
					Href:  "/admin/dashboard/users",
					Class: "w-full",
				}) {
					All Users
				}
			}
		}
	}
}

templ AddUserDialog(showCSV bool) {
	@dialog.Dialog() {
		@dialog.Trigger() {
			@button.Button(button.Props{
				Variant: button.VariantDefault,
			}) {
				Add User
			}
		}
		@dialog.Content(dialog.ContentProps{Class: "max-w-2xl"}) {
			@dialog.Header() {
				@dialog.Title() {
					Add User
				}
				@dialog.Description() {
					Add a new user to the platform manually or via CSV bulk import.
				}
			}
			if showCSV {
				@tabs.Tabs(tabs.Props{
					ID: "add-user-tabs",
				}) {
					@tabs.List(tabs.ListProps{
						Class: "w-full",
					}) {
						@tabs.Trigger(tabs.TriggerProps{
							Value:    "manual",
							IsActive: true,
							TabsID:   "add-user-tabs",
							Class:    "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
						}) {
							Manual Entry
						}
						@tabs.Trigger(tabs.TriggerProps{
							Value:  "csv",
							TabsID: "add-user-tabs",
							Class:  "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
						}) {
							CSV Import
						}
					}
					<div class="mt-4">
						@tabs.Content(tabs.ContentProps{
							Value:    "manual",
							IsActive: true,
							TabsID:   "add-user-tabs",
						}) {
							@AddUserManualForm()
						}
						@tabs.Content(tabs.ContentProps{
							Value:  "csv",
							TabsID: "add-user-tabs",
						}) {
							@AddUserCSVForm()
						}
					</div>
				}
			} else {
				@AddUserManualForm()
			}
		}
	}
}

templ AddUserManualForm() {
	<form
		id="add-user-form"
		hx-post="/admin/dashboard/users/create"
		hx-target="#users-table-container"
		hx-swap="outerHTML"
	>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4 py-4">
			<div class="space-y-2 mb-4 md:col-span-2">
				@form.Label(form.LabelProps{For: "full_name"}) {
					Full Name
				}
				@input.Input(input.Props{
					ID:          "full_name",
					Name:        "full_name",
					Placeholder: "Enter full name",
					Required:    true,
				})
			</div>
			<div class="space-y-2 mb-4">
				<div class="flex items-center justify-between">
					@form.Label(form.LabelProps{For: "username"}) {
						Username
					}
					@button.Button(button.Props{
						Size:    button.SizeIcon,
						Variant: button.VariantGhost,
						Class:   "h-6 w-6 text-slate-400 hover:text-blue-600",
						Attributes: templ.Attributes{
							"hx-get":                   "/admin/dashboard/users/generate-username",
							"hx-swap":                  "none",
							"hx-on:htmx:after-request": "if(event.detail.xhr.status === 200) { document.getElementById('username').value = event.detail.xhr.responseText }",
							"type":                     "button",
							"title":                    "Randomize Username",
						},
					}) {
						@icon.Dices(icon.Props{Size: 14})
					}
				</div>
				@input.Input(input.Props{
					ID:          "username",
					Name:        "username",
					Placeholder: "Enter username",
					Required:    true,
				})
			</div>
			<div class="space-y-2 mb-4">
				<div class="flex items-center justify-between">
					@form.Label(form.LabelProps{For: "password"}) {
						Password
					}
					@button.Button(button.Props{
						Size:    button.SizeIcon,
						Variant: button.VariantGhost,
						Class:   "h-6 w-6 text-slate-400 hover:text-blue-600",
						Attributes: templ.Attributes{
							"hx-get":                   "/admin/dashboard/users/generate-password",
							"hx-swap":                  "none",
							"hx-on:htmx:after-request": "if(event.detail.xhr.status === 200) { document.getElementById('password').value = event.detail.xhr.responseText }",
							"type":                     "button",
							"title":                    "Randomize Password",
						},
					}) {
						@icon.Dices(icon.Props{Size: 14})
					}
				</div>
				@input.Input(input.Props{
					ID:          "password",
					Name:        "password",
					Placeholder: "Enter password",
					Type:        input.TypePassword,
					Required:    true,
				})
			</div>
			<div class="space-y-2 mb-4">
				@form.Label(form.LabelProps{For: "role"}) {
					Role
				}
				@selectbox.SelectBox() {
					@selectbox.Trigger(selectbox.TriggerProps{
						Name: "role",
					}) {
						@selectbox.Value(selectbox.ValueProps{
							Placeholder: "Select the role",
						})
					}
					@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
						@selectbox.Group() {
							@selectbox.Label() {
								Role
							}
							@selectbox.Item(selectbox.ItemProps{
								Value: "ADMIN",
							}) {
								@badge.Badge(badge.Props{
									Variant: badge.VariantSecondary,
								}) {
									Admin
								}
							}
							@selectbox.Item(selectbox.ItemProps{
								Value: "STUDENT",
							}) {
								@badge.Badge(badge.Props{
									Variant: badge.VariantDestructive,
								}) {
									Student
								}
							}
							@selectbox.Item(selectbox.ItemProps{
								Value: "INSTRUCTOR",
							}) {
								@badge.Badge(badge.Props{
									Variant: badge.VariantDefault,
								}) {
									Instructor
								}
							}
						}
					}
				}
			</div>
		</div>
		@dialog.Footer() {
			@dialog.Close() {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
				}) {
					Cancel
				}
			}
			@button.Button(button.Props{
				Variant: button.VariantDefault,
				Type:    button.TypeSubmit,
			}) {
				Add User
			}
		}
	</form>
}

templ AddUserCSVForm() {
	<form
		id="add-user-csv-form"
		hx-post="/admin/dashboard/users/create-csv"
		hx-encoding="multipart/form-data"
		hx-target="#users-table-container"
		hx-swap="outerHTML"
	>
		<div class="space-y-4 py-4">
			<div class="space-y-2">
				@form.Label(form.LabelProps{For: "csv_file", Class: "text-sm font-medium"}) {
					Select CSV File
				}
				@upload.Upload(upload.Props{
					ID:          "csv_file",
					Name:        "csv_file",
					Accept:      ".csv",
					Placeholder: "Click to browse or drag and drop your CSV file here",
					Required:    true,
				})
				@upload.CSVRequirement("CSV Format Requirement", "The CSV should contain 4 columns in this exact order: username, full_name, role, password")
			</div>
		</div>
		@dialog.Footer() {
			@dialog.Close() {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
				}) {
					Cancel
				}
			}
			@button.Button(button.Props{
				Variant: button.VariantDefault,
				Type:    button.TypeSubmit,
				Form:    "add-user-csv-form",
				Class:   "flex items-center gap-2",
			}) {
				@icon.Check(icon.Props{Class: "h-4 w-4"})
				Import Users
			}
		}
	</form>
}

templ UserTableContainer(props UserTableProps) {
	<div id={ utils.IfElse(props.ID != "", props.ID, "users-table-container") }>
		<div class="overflow-x-auto">
			@table.Table() {
				@table.Header(table.HeaderProps{Class: "border-b border-slate-200 bg-slate-50/50"}) {
					<tr>
						@table.Head(table.HeadProps{Class: "px-6 py-3.5 whitespace-nowrap"}) {
							<span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Name</span>
						}
						@table.Head(table.HeadProps{Class: "px-6 py-3.5 whitespace-nowrap"}) {
							<span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Role</span>
						}
						@table.Head(table.HeadProps{Class: "px-6 py-3.5 whitespace-nowrap"}) {
							<span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Username</span>
						}
						@table.Head(table.HeadProps{Class: "px-6 py-3.5 whitespace-nowrap"}) {
							<span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Status</span>
						}
						@table.Head(table.HeadProps{Class: "px-6 py-3.5 whitespace-nowrap"}) {
							<span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Joined</span>
						}
						@table.Head(table.HeadProps{Class: "px-6 py-3.5 whitespace-nowrap"}) {
							<span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Last Interaction</span>
						}
						if !props.HideActions {
							@table.Head(table.HeadProps{Class: "px-6 py-3.5 whitespace-nowrap text-right"}) {
								<span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Actions</span>
							}
						}
					</tr>
				}
				@table.Body(table.BodyProps{ID: "user-table-body", Class: "divide-y divide-slate-100"}) {
				@UserTableBody(props)
				}
			}
		</div>
		if props.TotalCount > int64(props.Limit) {
			<div id="pagination-container" class="border-t border-slate-200 p-4 bg-slate-50/30">
				@pagination.Pagination(pagination.Props{
					Total:    props.TotalCount,
					Limit:    props.Limit,
					Offset:   props.Offset,
					BaseURL:  props.BaseURL,
					HXTarget: "#" + utils.IfElse(props.ID != "", props.ID, "users-table-container"),
					HXSwap:   "outerHTML",
				})
			</div>
		}
	</div>
}

templ UserTableContainerWithDeleteToast(props UserTableProps) {
	@toast.Toast(toast.Props{
		Title:         "User deleted",
		Description:   "The user has been removed successfully.",
		Variant:       toast.VariantSuccess,
		Position:      toast.PositionBottomRight,
		Duration:      3000,
		Dismissible:   true,
		ShowIndicator: true,
		Icon:          true,
	})
	@UserTableContainer(props)
}

templ UserTableBody(props UserTableProps) {
	@UserTableRows(props.Users, props.HideActions, props.RestoreButton, props.UnassignAPI, "#" + utils.IfElse(props.ID != "", props.ID, "users-table-container"), props.Limit, props.Offset)
}

templ UserTableRows(users []domain.User, hideActions bool, restoreButton bool, unassignAPI string, swapTarget string, limit int32, offset int32) {
	if len(users) == 0 {
		<tr>
			<td colspan="7" class="p-16 text-center">
				<div class="max-w-sm mx-auto flex flex-col items-center justify-center">
					<div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mb-4 text-slate-400">
						@icon.Search()
					</div>
					<h3 class="text-lg font-bold text-slate-700">No users found</h3>
					<p class="text-slate-500 text-sm mt-1">We couldn&apos;t find anyone matching your search criteria. Try adjusting your search term.</p>
				</div>
			</td>
		</tr>
	} else {
		for _, user := range users {
			@table.Row(table.RowProps{Class: "hover:bg-slate-50/80 transition-colors group cursor-default"}) {
				@table.Cell() {
					<span class="font-semibold text-slate-800 flex items-center gap-3">
						<div class="w-8 h-8 rounded-full bg-blue-100 text-primary flex items-center justify-center text-xs font-bold uppercase tracking-wider">{ user.FullName[:2] }</div>
						{ user.FullName }
					</span>
				}
				@table.Cell() {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "uppercase tracking-widest text-[10px] font-bold shadow-sm border border-slate-200/60"}) {
						{ string(user.Role) }
					}
				}
				@table.Cell() {
					<span class="text-slate-500 font-medium font-mono text-sm py-1 px-2 bg-slate-100 rounded-md border border-slate-200">{ user.Username }</span>
				}
				@table.Cell() {
					if user.IsActive {
						<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-green-50 text-green-700 border border-green-200 shadow-sm"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Enabled</span>
					} else {
						<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-slate-50 text-slate-500 border border-slate-200 shadow-sm"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Disabled</span>
					}
				}
				@table.Cell() {
					<span class="text-sm font-medium text-slate-600">{ user.CreatedAt.Format("Jan 02, 2006") }</span>
				}
				@table.Cell() {
					if user.LastLogin != nil {
						<span class="inline-flex items-center gap-2 text-sm text-slate-700 font-medium bg-slate-50 px-2 py-1.5 rounded-lg border border-slate-100" title={ user.LastLogin.Format("Jan 02, 2006 15:04:05") }>
							@icon.Clock(icon.Props{Class: "w-3.5 h-3.5 text-blue-500"})
							{ relativeTime(user.LastLogin) }
						</span>
					} else {
						<span class="inline-flex items-center gap-2 text-sm  px-2 py-1.5 rounded-lg border border-slate-100">
							@icon.Clock(icon.Props{Class: "w-3.5 h-3.5 text-slate-400"})
							<span class="text-slate-500 font-medium">Never logged in</span>
						</span>
					}
				}
				if !hideActions {
					<td class="px-6 py-4 text-right">
						<div class="flex justify-end items-center gap-2">
							<div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
								if restoreButton {
									@button.Button(button.Props{
										Variant: button.VariantGhost,
										Class:   "w-8 h-8 cursor-pointer flex items-center justify-center rounded-lg text-green-500 hover:text-green-700 hover:bg-green-50 transition-all border border-transparent hover:border-green-100",
										Attributes: templ.Attributes{
											"title":     "Restore User",
											"hx-post":   fmt.Sprintf("/users/restore/%s", user.ID.String()),
											"hx-target": "#deleted-users-table-container",
											"hx-swap":   "outerHTML swap:300ms",
										},
									}) {
										@icon.ArchiveRestore(icon.Props{Class: "w-3.5 h-3.5 text-green-500"})
									}
								} else {
									@button.Button(button.Props{
										Variant:    button.VariantGhost,
										Href:       fmt.Sprintf("/admin/dashboard/user/%s", user.ID.String()),
										Class:      "w-8 h-8 cursor-pointer flex items-center justify-center rounded-lg text-slate-400 hover:text-primary hover:bg-blue-50 transition-all border border-transparent hover:border-blue-100",
										Attributes: templ.Attributes{"title": "Edit User Profile/Info"},
									}) {
										@icon.User(icon.Props{Class: "w-3.5 h-3.5 text-primary"})
									}
									if user.ID.String() != "" && user.ID.String() != "00000000-0000-0000-0000-000000000000" {
										@dialog.Trigger(dialog.TriggerProps{For: fmt.Sprintf("delete-user-%s", user.ID.String())}) {
											@button.Button(button.Props{
												Variant:    button.VariantGhost,
												Class:      "w-8 h-8 cursor-pointer flex items-center justify-center rounded-lg text-red-400 hover:text-red-600 hover:bg-red-50 transition-all border border-transparent hover:border-red-100",
												Attributes: templ.Attributes{"title": "Delete User"},
											}) {
												@icon.Trash(icon.Props{Class: "w-3.5 h-3.5 text-red-500"})
											}
										}
									}
								}
							if unassignAPI != "" {
								@button.Button(button.Props{
									Variant:    button.VariantGhost,
									Class:      "w-8 h-8 cursor-pointer flex items-center justify-center rounded-lg text-red-400 hover:text-red-600 hover:bg-red-50 transition-all border border-transparent hover:border-red-100",
									Attributes: templ.Attributes{
										"title":     "Unassign",
										"hx-post":   fmt.Sprintf("%s?limit=%d&offset=%d", strings.Replace(unassignAPI, ":user_id", user.ID.String(), 1), limit, offset),
										"hx-target": swapTarget,
										"hx-swap":   "outerHTML",
										"hx-confirm": "Are you sure you want to unassign this user?",
									},
								}) {
									@icon.UserMinus(icon.Props{Class: "w-3.5 h-3.5 text-red-500"})
								}
							}
						</div>
						if !restoreButton && user.ID.String() != "" && user.ID.String() != "00000000-0000-0000-0000-000000000000" {
								@dialog.Dialog(dialog.Props{ID: fmt.Sprintf("delete-user-%s", user.ID.String())}) {
									@dialog.Content(dialog.ContentProps{HideCloseButton: true, DisableAutoFocus: true}) {
										@dialog.Header() {
											@dialog.Title() {
												Delete User 
											}
											@dialog.Description() {
												Delete user information. 
											}
										}
										@dialog.Footer() {
											@button.Button(button.Props{
												Attributes: templ.Attributes{
													"hx-delete": fmt.Sprintf("/users/delete/%s", user.ID.String()),
													"hx-target": "#users-table-container",
													"hx-swap":   "outerHTML swap:300ms",
												},
												Variant: button.VariantDestructive,
												Class:   "cursor-pointer flex items-center justify-center rounded-lg text-slate-400 transition-all border border-transparent hover:border-blue-100",
											}) {
												<span class="text-white">Delete</span>
											}
										}
									}
								}
							}
						</div>
					</td>
				}
			}
		}
	}
}

func relativeTime(t *time.Time) string {
	if t == nil || t.IsZero() {
		return "Never"
	}
	now := time.Now()
	diff := now.Sub(*t)
	switch {
	case diff < time.Minute:
		return "Just now"
	case diff < time.Hour:
		m := int(diff.Minutes())
		if m == 1 {
			return "1 min ago"
		}
		return fmt.Sprintf("%d min ago", m)
	case diff < 24*time.Hour:
		h := int(diff.Hours())
		if h == 1 {
			return "1 hour ago"
		}
		return fmt.Sprintf("%d hours ago", h)
	case diff < 7*24*time.Hour:
		d := int(diff.Hours() / 24)
		if d == 1 {
			return "Yesterday"
		}
		return fmt.Sprintf("%d days ago", d)
	default:
		return t.Format("Jan 02, 2006")
	}
}


templ AddInstructorDialog(param UserTableProps){
	{{
		assignSwapTarget := param.InstructorAssignSwapTarget
		if assignSwapTarget == "" {
			assignSwapTarget = "#users-table-container"
		}
	}}
	@dialog.Dialog(){
				@dialog.Trigger(){
			@button.Button(button.Props{
				Variant: button.VariantDefault,
			}) {
				Assign instructors
			}
		}
		@dialog.Content(){
			@dialog.Header(){
				@dialog.Title() {
					Add instructors
				}
				@dialog.Description(){
					Select one or more instructors to assign to this subject.
				}
			}

			<form
				id="add-instructor-form"
				hx-post={param.AddInstructorAPI}
				hx-target={ assignSwapTarget }
				hx-swap="outerHTML"
			>

	<div class="w-full mb-4 mt-4">
		@selectbox.SelectBox() {
			@selectbox.Trigger(selectbox.TriggerProps{
				ShowPills:           false,
				Multiple:            true,
				Name:                "instructor_id",
				SelectedCountText:   "{n} instructors selected",
			}) {
				@selectbox.Value(selectbox.ValueProps{
					Placeholder: "Select instructors…",
				})
			}
			@selectbox.Content() {
				@selectbox.Group() {
					@selectbox.Label() {
						Instructors
					}
					for _, instructor := range param.Instructors {
						<div class="mt-2">
						@selectbox.Item(selectbox.ItemProps{
							Value:     instructor.ID.String(),
						}) {
							<div class="flex items-center gap-2">
								{ instructor.FullName }
								@badge.Badge(badge.Props{
									Variant: badge.VariantSecondary,
									Class: "ml-2",
								}) {
									{ instructor.Username }
								}
							</div>
						}
						</div>
					}
				}
			}
		}
	</div>
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
						}) {
							Cancel
						}
					}
					@button.Button(button.Props{
						Variant: button.VariantDefault,
						Type:    button.TypeSubmit,
					}) {
						Assign instructors
					}
				}
			</form>
		}
	}
}

templ AddStudentDialog(param UserTableProps){
	{{
		assignSwapTarget := param.StudentAssignSwapTarget
		if assignSwapTarget == "" {
			assignSwapTarget = "#users-table-container"
		}
	}}

	@dialog.Dialog(){
		@dialog.Trigger(){
			@button.Button(button.Props{
				Variant: button.VariantSecondary,
				Size: button.SizeSm,
			}) {
				@icon.Upload(icon.Props{Class: "h-4 w-4"})
				Assign students via CSV
			}
		}
		@dialog.Content(){
			@dialog.Header(){
				@dialog.Title() {
					Assign students via CSV
				}
				@dialog.Description(){
					Upload a CSV file to assign students to this subject.
				}
			}

			<form
				id="add-student-form-csv"
				hx-post={param.AddStudentCSVAPI}
				hx-target={ assignSwapTarget }
				hx-swap="outerHTML"
				hx-encoding="multipart/form-data"
			>
				@upload.Upload(upload.Props{
					ID:          "student_csv_manual",
					Name:        "student_csv",
					Accept:      ".csv",
					Placeholder: "Click to browse or drag and drop your CSV file here",
					Required:    true,
					Class:       "mb-4 mt-4",
				})
				@upload.CSVRequirement("CSV Format Requirement", "The CSV should have a 'username' column containing student usernames.")

				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
						}) {
							Cancel
						}
					}
					@button.Button(button.Props{
						Variant: button.VariantDefault,
						Type:    button.TypeSubmit,
					}) {
						Assign students
					}
				}
			</form>
		}
	}
	
	@dialog.Dialog(){
		@dialog.Trigger(){
			@button.Button(button.Props{
				Variant: button.VariantDefault,
			}) {
				Assign students
			}
		}
		@dialog.Content(){
			@dialog.Header(){
				@dialog.Title() {
					Add students
				}
				@dialog.Description(){
					Select one or more students to assign to this subject.
				}
			}

			<form
				id="add-student-form"
				hx-post={param.AddStudentAPI}
				hx-target={ assignSwapTarget }
				hx-swap="outerHTML"
			>

	<div class="w-full mb-4 mt-4">
		@selectbox.SelectBox() {
			@selectbox.Trigger(selectbox.TriggerProps{
				ShowPills:           false,
				Multiple:            true,
				Name:                "student_id",
				SelectedCountText:   "{n} students selected",
			}) {
				@selectbox.Value(selectbox.ValueProps{
					Placeholder: "Select students…",
				})
			}
			@selectbox.Content() {
				@selectbox.Group() {
					@selectbox.Label() {
						Students
					}
					for _, student := range param.Students {
						<div class="mt-2">
						@selectbox.Item(selectbox.ItemProps{
							Value:     student.ID.String(),
						}) {
							<div class="flex items-center gap-2">
								{ student.FullName }
								@badge.Badge(badge.Props{
									Variant: badge.VariantSecondary,
									Class: "ml-2",
								}) {
									{ student.Username }
								}
							</div>
						}
						</div>
					}
				}
			}
		}
	</div>
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
						}) {
							Cancel
						}
					}
					@button.Button(button.Props{
						Variant: button.VariantDefault,
						Type:    button.TypeSubmit,
					}) {
						Assign students
					}
				}
			</form>
		}
	}
}
templ AddStudentCSVDialog(param UserTableProps) {
	@dialog.Dialog(dialog.Props{
		ID: "add-student-csv-dialog",
	}) {
		@dialog.Trigger() {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Class:   "flex items-center gap-2 bg-white hover:bg-slate-50 border-slate-200 text-slate-700 shadow-sm transition-all",
				Attributes: templ.Attributes{"title": "Assign via CSV"},
			}) {
				@icon.FileUp(icon.Props{Class: "h-4 w-4"})
				<span class="hidden sm:inline">Assign CSV</span>
			}
		}
		@dialog.Content(dialog.ContentProps{
			Class: "max-w-md",
		}) {
			@dialog.Header() {
				@dialog.Title() {
					Assign Students via CSV
				}
				@dialog.Description() {
					Upload a CSV file containing student usernames to assign them to this subject.
				}
			}
			<form
				id="add-student-csv-form"
				hx-post={ param.AddStudentCSVAPI }
				hx-encoding="multipart/form-data"
				hx-target={ utils.IfElse(param.StudentAssignSwapTarget != "", param.StudentAssignSwapTarget, "#" + utils.IfElse(param.ID != "", param.ID, "users-table-container")) }
				hx-swap="outerHTML"
			>
				<div class="space-y-4 py-4">
					<div class="space-y-2">
						@form.Label(form.LabelProps{For: "student_csv", Class: "text-sm font-medium"}) {
							Select CSV File
						}
						@upload.Upload(upload.Props{
							ID:          "student_csv",
							Name:        "student_csv",
							Accept:      ".csv",
							Placeholder: "Click to browse or drag and drop your CSV file here",
							Required:    true,
						})
						@upload.CSVRequirement("CSV Format Requirement", "The CSV should have a 'username' column containing student usernames.")
					</div>
				</div>
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
						}) {
							Cancel
						}
					}
					@button.Button(button.Props{
						Variant: button.VariantDefault,
						Type:    button.TypeSubmit,
						Form:    "add-student-csv-form",
						Class:   "flex items-center gap-2",
					}) {
						@icon.Check(icon.Props{Class: "h-4 w-4"})
						Upload & Assign
					}
				}
			</form>
		}
	}
}
