package components

import "uot-exam/internal/domain"
import "fmt"
import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/button"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/pagination"
import "uot-exam/web/templates/components/dialog"
import "uot-exam/web/templates/components/form"
import "uot-exam/web/templates/components/input"
import "uot-exam/web/templates/components/badge"
import "uot-exam/web/templates/components/selectbox"
import "uot-exam/web/templates/components/timepicker"
import "uot-exam/web/templates/components/textarea"

type SubjectTableContainerProps struct {
	Subjects   []domain.Subject
	TotalCount int64
	Limit      int32
	Offset     int32
	BaseURL    string
}

templ SubjectTableGrid(subjects []domain.Subject) {
	if len(subjects) == 0 {
		@EmptyState("No subjects found", "We couldn't find any subjects matching your search. Try adjusting your keywords or filters.", true, false)
	} else {
		<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
			for _, subject := range subjects {
				@SubjectCard(subject)
			}
		</div>
	}
}

templ ExamTableGrid(exams []domain.Exam) {
	<div id="exams-table-container">
		if len(exams) == 0 {
			@EmptyState("No exams found", "We couldn't find any exams matching your search. Try adjusting your keywords or filters.", false, true)
		} else {
			<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
				for _, exam := range exams {
					@ExamCard(exam)
				}
			</div>
		}
	</div>
}

templ ExamCard(exam domain.Exam) {
	<div class="w-full max-w-sm">
		@card.Card(card.Props{
			Class: "max-w-sm",
		}) {
			@card.Header() {
				@card.Title() {
					<span class="text-2xl font-bold">
						{ exam.Title }
					</span>
				}
				@card.Description() {
					if exam.Description != nil {
						<span class="text-sm text-muted-foreground">{ truncateText(*exam.Description, 30) }</span>
					} else {
						<span class="text-sm text-slate-400 italic">No description provided</span>
					}
					<br/>
					@badge.Badge(badge.Props{
						Variant: badge.VariantOutline,
						Class:   "mt-2",
					}) {
						@icon.Users(icon.Props{Class: "h-4 w-4"})
						{ 10 }
					}
					@badge.Badge(badge.Props{
						Variant: badge.VariantOutline,
						Class:   "mt-2",
					}) {
						@icon.CircleQuestionMark(icon.Props{Class: "h-4 w-4"})
						{ 30 }
					}

					@badge.Badge(badge.Props{
						Variant: badge.VariantOutline,
						Class:   "mt-2",
					}) {
						@icon.ChartBar(icon.Props{Class: "h-4 w-4"})
						{ fmt.Sprintf("%d", exam.TotalMarks) }
					}
				}
			}
			@card.Footer(card.FooterProps{
				Class: "flex items-center justify-between",
			}) {
				@badge.Badge(badge.Props{
					Variant: badge.VariantSecondary,
					Class:   "mt-2",
				}) {
					{ exam.Status }
				}
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Href:    "/admin/dashboard/exam/" + exam.ID.String(),
				}) {
					@icon.ArrowRight(icon.Props{Class: "h-4 w-4"})
				}
			}
		}
	</div>
}

templ SubjectTableContainer(props SubjectTableContainerProps) {
	<div id="subjects-table-container">
		@SubjectTableGrid(props.Subjects)
		if props.TotalCount > int64(props.Limit) {
			<div id="pagination-container" class="mt-4">
				@pagination.Pagination(pagination.Props{
					Total:    props.TotalCount,
					Limit:    props.Limit,
					Offset:   props.Offset,
					BaseURL:  props.BaseURL,
					HXTarget: "#subjects-table-container",
					HXSwap:   "outerHTML",
				})
			</div>
		}
	</div>
}

templ SubjectCard(subject domain.Subject) {
	<div class="w-full max-w-sm">
		@card.Card(card.Props{
			Class: "max-w-sm",
		}) {
			@card.Header() {
				@card.Title() {
					<span class="text-2xl font-bold">
						{ subject.Title }
					</span>
				}
				@card.Description() {
					if subject.Description != nil {
						<span class="text-sm text-muted-foreground">{ truncateText(*subject.Description, 30) }</span>
					} else {
						<span class="text-sm text-slate-400 italic">...</span>
					}
					<div class="flex flex-wrap gap-2 mt-2">
						@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
							@icon.Clock(icon.Props{Class: "h-3 w-3 mr-1"})
							{ fmt.Sprintf("%d min", subject.DurationMinutes) }
						}
						@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
							@icon.ChartBar(icon.Props{Class: "h-3 w-3 mr-1"})
							{ fmt.Sprintf("%d/%d", subject.PassScore, subject.TotalMarks) }
						}
					</div>
				}
			}
			@card.Footer(card.FooterProps{
				Class: "flex items-center justify-between",
			}) {
				if subject.Status == domain.SubjectStatusActive {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						{ string(subject.Status) }
					}
				} else {
					@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
						{ string(subject.Status) }
					}
				}
				<div class="flex items-center justify-between">
					<span class="text-sm text-muted-foreground">
						@button.Button(button.Props{
							Variant: button.VariantGhost,
							Href:    "/admin/dashboard/subject/" + subject.ID.String(),
						}) {
							@icon.ArrowRight(icon.Props{Class: "h-4 w-4"})
						}
					</span>
				</div>
			}
		}
	</div>
}

templ EmptyState(title string, description string, addSubject bool, addExam bool) {
	@card.Card(card.Props{
		Class: "w-full",
	}) {
		@card.Header(card.HeaderProps{
			Class: "flex flex-col items-center justify-center",
		}) {
			@card.Title(card.TitleProps{
				Class: "flex flex-col items-center justify-center",
			}) {
				<div class="bg-white p-4 rounded-full shadow-sm mb-4">
					@icon.Search(icon.Props{Class: "h-8 w-8 text-slate-400"})
				</div>
				<span class="text-2xl font-bold">
					{ title }
				</span>
			}
			@card.Content(card.ContentProps{
				Class: "flex flex-col items-center justify-center",
			}) {
				<span class="text-sm text-muted-foreground">{ description }</span>
			}
			@card.Footer(card.FooterProps{
				Class: "flex items-center justify-center",
			}) {
				if addSubject {
					@DialogAddSubject()
				} else if addExam {
					//@DialogAddExam()
				}
			}
		}
	}
}

func truncateText(s string, max int) string {
	runes := []rune(s)
	if len(runes) <= max {
		return s
	}
	return string(runes[:max]) + "..."
}

templ DialogAddSubject() {
	@dialog.Dialog(dialog.Props{
		ID: "add-subject-dialog",
	}) {
		@dialog.Trigger() {
			@button.Button(button.Props{
				Variant: button.VariantDefault,
			}) {
				Add Subject
			}
		}
		@dialog.Content(dialog.ContentProps{
			Class: "max-w-md",
		}) {
			@dialog.Header() {
				@dialog.Title() {
					Add Subject
				}
				@dialog.Description() {
					Add a new subject to the platform.
				}
			}
			<form
				id="add-subject-form"
				hx-post="/admin/dashboard/subjects/create"
				hx-target="#subjects-table-container"
				hx-swap="outerHTML"
			>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div class="space-y-2 mb-4 md:col-span-2">
						@form.Label(form.LabelProps{For: "title"}) {
							Title
						}
						@input.Input(input.Props{
							ID:          "title",
							Name:        "title",
							Placeholder: "Enter subject title",
							Required:    true,
						})
					</div>
					<div class="space-y-2 mb-4">
						@form.Label(form.LabelProps{For: "duration_minutes"}) {
							Duration
						}

						@timepicker.TimePicker(timepicker.Props{
							ID:          "duration_minutes",
							Name:        "duration_minutes",
							Placeholder: "Duration",
							Attributes: templ.Attributes{
								"required": "true",
							},
						})
					</div>

					<div class="space-y-2 mb-4">
						@form.Label(form.LabelProps{For: "pass_score"}) {
							Pass Score
						}
						@input.Input(input.Props{
							Type:        input.TypeNumber,
							ID:          "pass_score",
							Name:        "pass_score",
							Placeholder: "Passing score",
							Required:    true,
							Attributes: templ.Attributes{
								"min": "1",
							},
						})
					</div>
					<div class="space-y-2 mb-4">
						@form.Label(form.LabelProps{For: "status"}) {
							Status
						}
			@selectbox.SelectBox() {
				@selectbox.Trigger(selectbox.TriggerProps{
					Name: "status",
				}) {
					@selectbox.Value(selectbox.ValueProps{
						Placeholder: "Select the status",
					})
				}
				@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
					@selectbox.Group() {
						@selectbox.Label() {
							Status
						}
						@selectbox.Item(selectbox.ItemProps{
							Value: "ACTIVE",
						}) {
							@badge.Badge(badge.Props{
								Variant: badge.VariantSecondary,
							}) {
								Active
							}
						}
						@selectbox.Item(selectbox.ItemProps{
							Value: "INACTIVE",
						}) {
							@badge.Badge(badge.Props{
								Variant: badge.VariantDestructive,
							}) {
								Inactive
							}
						}
					}
				}
			}
					</div>

					<div class="space-y-2 mb-4 md:col-span-2">
						@form.Label(form.LabelProps{For: "description"}) {
							Description
						}
						@textarea.Textarea(textarea.Props{
							ID:          "description",
							Name:        "description",
							Placeholder: "Enter subject description",
						})
					</div>

				</div>
				@dialog.Footer(dialog.FooterProps{
					Class: "mt-4",
				}) {
					@dialog.Close() {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
						}) {
							Cancel
						}
					}
					@button.Button(
						button.Props{
							Variant: button.VariantDefault,
							Type:    button.TypeSubmit,
						}) {
						Add Subject
					}
				}
			</form>
		}
	}
}
