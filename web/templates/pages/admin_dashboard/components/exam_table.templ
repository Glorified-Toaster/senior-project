package components

import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/table"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/button"
import "uot-exam/internal/domain"
import "uot-exam/web/templates/components/badge"

import "uot-exam/web/templates/components/pagination"
import "uot-exam/web/templates/components/input"

type ExamTableProps struct {
	Exams         []domain.Exam
	Title         string
	TotalCount    int64
	Limit         int32
	Offset        int32
	BaseURL       string
	ShowAllButton bool
	Search        bool
	SearchAPI     string
	CreateExam    bool
}

templ ExamTable(props ExamTableProps) {
	@card.Card(card.Props{Class: "w-full overflow-hidden"}) {
		@card.Header() {
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-2">
					@icon.Book(icon.Props{Class: "h-7 w-7"})
					<span class="text-2xl font-bold">{ props.Title }</span>
				</div>
				<div class="flex items-center gap-4">
					if props.Search {
						<div class="w-64">
							@input.Input(input.Props{
								Type:        input.TypeSearch,
								Name:        "search",
								Placeholder: "Search exams...",
								Attributes: templ.Attributes{
									"hx-post":    props.SearchAPI,
									"hx-trigger": "keyup changed delay:300ms, search",
									"hx-target":  "#exams-table-container",
									"hx-swap":    "outerHTML",
								},
							})
						</div>
					}
					if props.CreateExam {
						@button.Button(button.Props{
							Href: "/admin/dashboard/exams/create",
						}) {
							Create Exam
						}
					}
				</div>
			</div>
		}
		@card.Content(card.ContentProps{Class: "p-4"}) {
			@ExamTableContainer(props)
			if props.ShowAllButton {
				@button.Button(button.Props{
					Href:  props.BaseURL,
					Class: "w-full",
				}) {
					All Exams
				}
			}
		}
	}
}

templ ExamTableContainer(props ExamTableProps) {
	<div id="exams-table-container">
		<div class="overflow-x-auto">
			@table.Table() {
				@table.Header(table.HeaderProps{Class: "border-b border-slate-200 bg-slate-50/50"}) {
					<tr>
						@table.Head(table.HeadProps{Class: "px-6 py-3.5 whitespace-nowrap"}) {
							<span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Exam Name</span>
						}
						@table.Head(table.HeadProps{Class: "px-6 py-3.5 whitespace-nowrap"}) {
							<span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Status</span>
						}
						@table.Head(table.HeadProps{Class: "px-6 py-3.5 whitespace-nowrap"}) {
							<span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Start Time</span>
						}
						@table.Head(table.HeadProps{Class: "px-6 py-3.5 whitespace-nowrap"}) {
							<span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">End Time</span>
						}
						@table.Head(table.HeadProps{Class: "px-6 py-3.5 whitespace-nowrap text-right"}) {
							<span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Actions</span>
						}
					</tr>
				}
				<tbody id="exam-table-body" class="divide-y divide-slate-100">
					@ExamTableRows(props.Exams)
				</tbody>
			}
		</div>
		if props.TotalCount > int64(props.Limit) {
			<div id="pagination-container" class="border-t border-slate-200 p-4 bg-slate-50/30">
				@pagination.Pagination(pagination.Props{
					Total:    props.TotalCount,
					Limit:    props.Limit,
					Offset:   props.Offset,
					BaseURL:  props.BaseURL,
					HXTarget: "#exams-table-container",
					HXSwap:   "outerHTML",
				})
			</div>
		}
	</div>
}

templ ExamTableRows(exams []domain.Exam) {
	if len(exams) == 0 {
		<tr>
			<td colspan="5" class="p-16 text-center">
				<div class="max-w-sm mx-auto flex flex-col items-center justify-center">
					<div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mb-4 text-slate-400">
						@icon.Search()
					</div>
					<h3 class="text-lg font-bold text-slate-700">No exams found</h3>
					<p class="text-slate-500 text-sm mt-1">We couldn't find any exams matching your search criteria. Try adjusting your search term.</p>
				</div>
			</td>
		</tr>
	} else {
		for _, exam := range exams {
			@table.Row(table.RowProps{Class: "hover:bg-slate-50/80 transition-colors group cursor-default"}) {
				@table.Cell() {
					<span class="font-semibold text-slate-800 flex items-center gap-3 text-sm">
						<div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-[10px] font-black uppercase tracking-wider shadow-sm border border-blue-200/50">{ exam.Title[:2] }</div>
						{ exam.Title }
					</span>
				}
				@table.Cell() {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "uppercase tracking-widest text-[9px] font-bold shadow-sm border border-slate-200/60"}) {
						{ string(exam.Status) }
					}
				}
				@table.Cell() {
					<span class="text-xs font-semibold text-slate-600 bg-slate-100/80 px-2 py-1 rounded border border-slate-200/50">{ exam.StartTime.Format("Jan 02, 2006 15:04") }</span>
				}
				@table.Cell() {
					<span class="text-xs font-semibold text-slate-600 bg-slate-100/80 px-2 py-1 rounded border border-slate-200/50">{ exam.EndTime.Format("Jan 02, 2006 15:04") }</span>
				}
				<td class="px-6 py-4 text-right">
					<div class="flex justify-end items-center gap-2">
						<div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                            @button.Button(button.Props{
                                Variant: button.VariantGhost,
                                Class:   "w-8 h-8 cursor-pointer flex items-center justify-center rounded-lg text-slate-400 hover:text-blue-600 hover:bg-blue-50 transition-all border border-transparent hover:border-blue-100",
                                Attributes: templ.Attributes{"title": "Edit Exam"},
                            }) {
                                @icon.Pencil(icon.Props{Class: "w-3.5 h-3.5"})
                            }
                            @button.Button(button.Props{
                                Variant: button.VariantGhost,
                                Class:   "w-8 h-8 cursor-pointer flex items-center justify-center rounded-lg text-red-400 hover:text-red-600 hover:bg-red-50 transition-all border border-transparent hover:border-red-100",
                                Attributes: templ.Attributes{
                                    "title": "Delete Exam",
                                    "hx-delete": "/admin/dashboard/exams/delete/" + exam.ID.String(),
                                    "hx-target": "#exams-table-container",
                                    "hx-swap": "outerHTML",
                                    "hx-confirm": "Are you sure you want to delete this exam?",
                                },
                            }) {
                                @icon.Trash(icon.Props{Class: "w-3.5 h-3.5"})
                            }
						</div>
					</div>
				</td>
			}
		}
	}
}
