package components

import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/table"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/button"
import "uot-exam/internal/domain"
import "uot-exam/web/templates/components/badge"

templ ExamTable(exams []domain.Exam) {
	@card.Card(card.Props{Class: "w-full"}) {
		@card.Header() {
			<span class="text-2xl font-bold">Recent Exams</span>
		}
		@card.Content() {
			<div id="exams-table-container">
				<div class="overflow-x-auto">
					@table.Table() {
						@table.Header(table.HeaderProps{Class: "border-b border-slate-200"}) {
							<tr>
								@table.Head(table.HeadProps{Class: "px-4 py-2"}) {
									<span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Exam Name</span>
								}
								@table.Head(table.HeadProps{Class: "px-4 py-2"}) {
									<span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Status</span>
								}
								@table.Head(table.HeadProps{Class: "px-4 py-2"}) {
									<span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Start Time</span>
								}
								@table.Head(table.HeadProps{Class: "px-4 py-2"}) {
									<span class="text-xs font-bold text-slate-500 uppercase tracking-wider">End Time</span>
								}
								@table.Head(table.HeadProps{Class: "px-4 py-2"}) {
									<span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Actions</span>
								}
							</tr>
						}
						<tbody id="exam-table-body" class="divide-y divide-slate-100">
							@ExamTableRows(exams)
						</tbody>
					}
				</div>
			</div>
			<div class="grid">
				@button.Button(button.Props{
					Href: "/admin/dashboard/exams",
				}) {
					All Exams
				}
			</div>
		}
	}
}

templ ExamTableRows(exams []domain.Exam) {
	if len(exams) == 0 {
		<tr>
			<td colspan="7" class="p-16 text-center">
				<div class="max-w-sm mx-auto flex flex-col items-center justify-center">
					<div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mb-4 text-slate-400">
						@icon.Search()
					</div>
					<h3 class="text-lg font-bold text-slate-700">No exams found</h3>
					<p class="text-slate-500 text-sm mt-1">We couldn't find any exams matching your search criteria. Try adjusting your search term.</p>
				</div>
			</td>
		</tr>
	} else {
		for _, exam := range exams {
			@table.Row(table.RowProps{Class: "hover:bg-slate-50/80 transition-colors group cursor-default"}) {
				@table.Cell() {
					<span class="font-semibold text-slate-800 flex items-center gap-3">
						<div class="w-8 h-8 rounded-full bg-blue-100 text-primary flex items-center justify-center text-xs font-bold uppercase tracking-wider">{ exam.Title[:2] }</div>
						{ exam.Title }
					</span>
				}
				@table.Cell() {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "uppercase tracking-widest text-[10px] font-bold shadow-sm border border-slate-200/60"}) {
						{ exam.Status }
					}
				}
				@table.Cell() {
					<span class="text-sm font-medium text-slate-600">{ exam.StartTime.Format("Jan 02, 2006 15:04") }</span>
				}
				@table.Cell() {
					<span class="text-sm font-medium text-slate-600">{ exam.EndTime.Format("Jan 02, 2006 15:04") }</span>
				}
				@table.Cell() {
				}
			}
		}
	}
}
