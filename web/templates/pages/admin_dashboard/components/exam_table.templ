package components

import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/button"
import "uot-exam/internal/domain"

import "uot-exam/web/templates/components/pagination"
import "uot-exam/web/templates/components/input"

type ExamTableProps struct {
	Exams         []domain.Exam
	Title         string
	TotalCount    int64
	Limit         int32
	Offset        int32
	BaseURL       string
	ShowAllButton bool
	Search        bool
	SearchAPI     string
	CreateExam    bool
}

templ ExamTable(props ExamTableProps) {
	@card.Card(card.Props{Class: "w-full overflow-hidden"}) {
		@card.Header() {
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-2">
					@icon.Book(icon.Props{Class: "h-7 w-7"})
					<span class="text-2xl font-bold">{ props.Title }</span>
				</div>
				<div class="flex items-center gap-4">
					if props.Search {
						<div class="w-64">
							@input.Input(input.Props{
								Type:        input.TypeSearch,
								Name:        "search",
								Placeholder: "Search exams...",
								Attributes: templ.Attributes{
									"hx-post":    props.SearchAPI,
									"hx-trigger": "keyup changed delay:300ms, search",
									"hx-target":  "#exams-table-container",
									"hx-swap":    "outerHTML",
								},
							})
						</div>
					}
					if props.CreateExam {
						@button.Button(button.Props{
							Href: "/admin/dashboard/exams/create",
						}) {
							Create Exam
						}
					}
				</div>
			</div>
		}
		@card.Content(card.ContentProps{Class: "p-4"}) {
			@ExamTableContainer(props)
			if props.ShowAllButton {
				@button.Button(button.Props{
					Href:  props.BaseURL,
					Class: "w-full",
				}) {
					All Exams
				}
			}
		}
	}
}

templ ExamTableContainer(props ExamTableProps) {
	<div id="exams-table-container">
		<div class="overflow-x-auto">
			@ExamTableGrid(props.Exams)
		</div>
		if props.TotalCount > int64(props.Limit) {
			<div id="pagination-container" class="border-t p-4 mt-4">
				@pagination.Pagination(pagination.Props{
					Total:    props.TotalCount,
					Limit:    props.Limit,
					Offset:   props.Offset,
					BaseURL:  props.BaseURL,
					HXTarget: "#exams-table-container",
					HXSwap:   "outerHTML",
				})
			</div>
		}
	</div>
}
