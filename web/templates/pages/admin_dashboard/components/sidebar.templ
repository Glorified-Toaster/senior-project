package components

import "uot-exam/web/templates/components/sidebar"
import "uot-exam/web/templates/components/collapsible"
import "uot-exam/web/templates/components/dropdown"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/navbar"

templ Sidebar(currentPath string, breadPath []navbar.BreadPath, username string, fullname string, userID string, dashboardPath string) {
	@sidebar.Layout() {
		@sidebar.Sidebar(sidebar.Props{
			Collapsible: sidebar.CollapsibleIcon,
			Variant:     sidebar.VariantFloating,
		}) {
			@sidebar.Header() {
				@sidebar.Menu() {
					@sidebar.MenuItem() {
						@sidebar.MenuButton(sidebar.MenuButtonProps{
							Href:    dashboardPath,
							Tooltip: "Dashboard",
						}) {
							@icon.LayoutPanelLeft(icon.Props{Class: "size-4"})
							<span class="group-data-[tui-sidebar-state=collapsed]:hidden">Dashboard</span>
						}
					}
				}
			}
			@sidebar.Content() {
				@sidebar.Group() {
					@sidebar.GroupLabel() {
						Platform
					}
					@sidebar.Menu() {
						@sidebar.MenuItem() {
							@collapsible.Collapsible(collapsible.Props{
								Open:  true,
								Class: "group/collapsible w-full",
							}) {
								@collapsible.Trigger() {
									@sidebar.MenuButton(sidebar.MenuButtonProps{
										Tooltip: "Users",
									}) {
										@icon.Users(icon.Props{Class: "size-4"})
										<span class="group-data-[tui-sidebar-state=collapsed]:hidden">Users</span>
										@icon.ChevronRight(icon.Props{
											Class: "ml-auto size-4 transition-transform group-data-[tui-collapsible-state=open]/collapsible:rotate-90 group-data-[tui-sidebar-state=collapsed]:hidden",
										})
									}
								}
								@collapsible.Content() {
									@sidebar.MenuSub() {
										@sidebar.MenuSubItem() {
											@sidebar.MenuSubButton(sidebar.MenuSubButtonProps{
												Href:  "/admin/dashboard/users",
												Class: activeClass(currentPath, "/admin/dashboard/users"),
											}) {
												<span>All Users</span>
											}
										}
									}
								}
							}
						}
						@sidebar.MenuItem() {
							@collapsible.Collapsible(collapsible.Props{
								Open:  true,
								Class: "group/collapsible w-full",
							}) {
								@collapsible.Trigger() {
									@sidebar.MenuButton(sidebar.MenuButtonProps{
										Tooltip: "Exams",
									}) {
										@icon.Book(icon.Props{Class: "size-4"})
										<span class="group-data-[tui-sidebar-state=collapsed]:hidden">Exams</span>
										@icon.ChevronRight(icon.Props{
											Class: "ml-auto size-4 transition-transform group-data-[tui-collapsible-state=open]/collapsible:rotate-90 group-data-[tui-sidebar-state=collapsed]:hidden",
										})
									}
								}
								@collapsible.Content() {
									@sidebar.MenuSub() {
										@sidebar.MenuSubItem() {
											@sidebar.MenuSubButton(sidebar.MenuSubButtonProps{
												Href:  "/admin/dashboard/exams",
												Class: activeClass(currentPath, "/admin/dashboard/exams"),
											}) {
												<span>All Exams</span>
											}
										}
									}
								}
							}
						}
						@sidebar.MenuItem() {
							@sidebar.MenuButton(sidebar.MenuButtonProps{
								Href:    "/admin/dashboard/subjects",
								Tooltip: "Subjects",
								Class:   activeClass(currentPath, "/admin/dashboard/subjects"),
							}) {
								@icon.Bookmark(icon.Props{Class: "size-4"})
								<span class="group-data-[tui-sidebar-state=collapsed]:hidden">Subjects</span>
							}
						}
					}
				}
				@sidebar.Separator()
				@sidebar.Group() {
					@sidebar.Menu() {
						@sidebar.MenuItem() {
							@collapsible.Collapsible(collapsible.Props{
								Open:  false,
								Class: "group/collapsible w-full",
							}) {
								@collapsible.Trigger() {
									@sidebar.MenuButton(sidebar.MenuButtonProps{
										Tooltip: "Settings",
									}) {
										@icon.Settings(icon.Props{Class: "size-4"})
										<span class="group-data-[tui-sidebar-state=collapsed]:hidden">Settings</span>
										@icon.ChevronRight(icon.Props{
											Class: "ml-auto size-4 transition-transform group-data-[tui-collapsible-state=open]/collapsible:rotate-90 group-data-[tui-sidebar-state=collapsed]:hidden",
										})
									}
								}
								@collapsible.Content() {
									@sidebar.MenuSub() {
										@sidebar.MenuSubItem() {
											@sidebar.MenuSubButton(sidebar.MenuSubButtonProps{
												Href:  "/admin/settings",
												Class: activeClass(currentPath, "/admin/settings"),
											}) {
												<span>General</span>
											}
										}
									}
								}
							}
						}
					}
				}
			}
			@sidebar.Footer() {
				@sidebar.Menu() {
					@sidebar.MenuItem() {
						@dropdown.Dropdown() {
							@dropdown.Trigger() {
								@sidebar.MenuButton(sidebar.MenuButtonProps{
									Size: sidebar.MenuButtonSizeLg,
								}) {
									<div class="flex items-center text-left text-sm leading-tight">
										@icon.User(icon.Props{Class: "h-8 w-8 mr-2 group-data-[tui-sidebar-state=collapsed]:mr-0"})
										<div class="flex flex-col group-data-[tui-sidebar-state=collapsed]:hidden">
											<span class="truncate font-medium">
												{ fullname }
											</span>
											<span class="truncate text-xs">
												{ username }
											</span>
										</div>
									</div>
									@icon.ChevronsUpDown(icon.Props{Class: "ml-auto size-4 group-data-[tui-sidebar-state=collapsed]:hidden"})
								}
							}
							@dropdown.Content(dropdown.ContentProps{
								Class:     "w-56",
								Placement: dropdown.PlacementTopStart,
								ShowArrow: true,
								Offset:    8,
							}) {
								@dropdown.Label() {
									{ fullname }
								}
								@dropdown.Separator()
								@dropdown.Item(dropdown.ItemProps{
									Href: "/admin/dashboard/user/" + userID,
								}) {
									<span class="flex items-center w-full">
										@icon.User(icon.Props{Size: 16, Class: "mr-2 text-slate-500"})
										Profile
									</span>
								}
								@dropdown.Item(dropdown.ItemProps{
									Href: "/admin/settings",
								}) {
									<span class="flex items-center w-full">
										@icon.Settings(icon.Props{Size: 16, Class: "mr-2 text-slate-500"})
										Settings
									</span>
								}
								@dropdown.Item(dropdown.ItemProps{
									Href: "/logout",
								}) {
									<span class="flex items-center w-full text-red-600">
										@icon.LogOut(icon.Props{Class: "h-4 w-4 mr-2"})
										Log out
									</span>
								}
							}
						}
					}
				}
			}
		}
		@sidebar.Inset() {
			<div class="flex h-full flex-col">
				@navbar.Navbar(navbar.Props{
					BreadPath:      breadPath,
					SidebarTrigger: true,
				})
				<div class="flex-1 p-6 overflow-auto">
					{ children... }
				</div>
			</div>
		}
	}
}

func activeClass(currentPath, targetPath string) string {
	if currentPath == targetPath {
		return "bg-primary text-primary-foreground font-medium shadow-sm"
	}
	return "text-muted-foreground hover:bg-accent hover:text-accent-foreground"
}
