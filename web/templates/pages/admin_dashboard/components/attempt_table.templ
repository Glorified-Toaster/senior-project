package components

import (
	"uot-exam/internal/domain"
	"uot-exam/web/templates/components/card"
	"uot-exam/web/templates/components/badge"
	"uot-exam/web/templates/components/icon"
	"fmt"
)

templ AttemptTable(attempts []domain.ExamAttempt, examStatus string) {
	if len(attempts) == 0 {
		@card.Card() {
			@card.Content(card.ContentProps{
				Class: "flex flex-col items-center justify-center py-12 text-center",
			}) {
				<div class="rounded-full bg-muted p-3 mb-4">
					@icon.Info(icon.Props{Class: "h-6 w-6 text-muted-foreground"})
				</div>
				<h3 class="text-lg font-semibold">
					if examStatus == "DRAFT" {
						Exam Not Started
					} else {
						No Attempts Found
					}
				</h3>
				<p class="text-sm text-muted-foreground max-w-sm mt-2">
					if examStatus == "DRAFT" {
						Students will be able to take the exam once it is published.
					} else {
						No students have attempted this exam yet.
					}
				</p>
			}
		}
	} else {
		<div class="relative overflow-x-auto rounded-lg border border-border">
			<table class="w-full text-sm text-left">
				<thead class="bg-muted/50 text-muted-foreground font-medium border-b border-border">
					<tr>
						<th class="px-4 py-3">Student</th>
						<th class="px-4 py-3">Started At</th>
						<th class="px-4 py-3">Submitted At</th>
						<th class="px-4 py-3">Score</th>
						<th class="px-4 py-3">Status</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border">
					for _, attempt := range attempts {
						<tr class="hover:bg-muted/30 transition-colors">
							<td class="px-4 py-3">
								<div class="flex flex-col">
									<span class="font-medium text-foreground">{ attempt.StudentName }</span>
									<span class="text-xs text-muted-foreground">{ attempt.StudentUsername }</span>
								</div>
							</td>
							<td class="px-4 py-3 text-muted-foreground">
								{ attempt.StartedAt.Format("02 Jan 2006, 15:04") }
							</td>
							<td class="px-4 py-3 text-muted-foreground">
								if attempt.SubmittedAt != nil {
									{ attempt.SubmittedAt.Format("02 Jan 2006, 15:04") }
								} else {
									<span class="italic text-xs">In Progress</span>
								}
							</td>
							<td class="px-4 py-3">
								if attempt.Score != nil {
									<span class="font-semibold text-primary">{ fmt.Sprintf("%.2f", *attempt.Score) }</span>
								} else {
									<span class="text-muted-foreground">-</span>
								}
							</td>
							<td class="px-4 py-3">
								switch string(attempt.Status) {
									case "IN_PROGRESS":
										@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) { In Progress }
									case "SUBMITTED":
										@badge.Badge(badge.Props{Variant: badge.VariantDefault}) { Submitted }
									case "GRADED":
										@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "bg-green-50 text-green-700 border-green-200"}) { Graded }
									case "CANCELLED":
										@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) { Cancelled }
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
