package page

import "uot-exam/internal/domain"
import "uot-exam/web/templates/pages/admin_dashboard/components"
import "uot-exam/web/templates/components/navbar"
import "uot-exam/web/templates/components/sidebar"
import "uot-exam/web/templates/components/collapsible"
import "uot-exam/web/templates/components/dropdown"
import "uot-exam/web/templates/components/popover"
import "uot-exam/web/templates/components/dialog"
import "uot-exam/web/templates/components/toast"
import "uot-exam/web/templates/components/chart"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/tabs"
import "uot-exam/web/templates/components/input"
import "uot-exam/web/templates/components/textarea"
import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/label"
import "uot-exam/web/templates/utils"
import "uot-exam/web/templates/components/button"
import "strconv"

type EditExamPageParam struct {
	Username string
	FullName string
	Subject  domain.Subject
	Instructor domain.User
	Exam domain.Exam
}

templ EditExamPage(param EditExamPageParam) {
	        <!-- KaTeX CSS -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" 
              integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" 
              crossorigin="anonymous"/>
        
        <!-- KaTeX JS -->
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" 
                integrity="sha384-XjKyOOlGwcjNTAIQHIpgOno0Hl1YQqzUOEleOLALmuqehneUG+vnGctmUb0ZY0l8" 
                crossorigin="anonymous"></script>
        
        <!-- KaTeX Auto-render Extension -->
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" 
                integrity="sha384-+VBxd3r6XgURycqtZ117nYw44OOcIax56Z4dCRWbxyPt0Koah1uHoK0o4+/RRE05" 
                crossorigin="anonymous"
                onload="renderMathInElement(document.body, {
                    delimiters: [
                        {left: '$$', right: '$$', display: true},
                        {left: '$', right: '$', display: false},
                        {left: '\\[', right: '\\]', display: true},
                        {left: '\\(', right: '\\)', display: false}
                    ],
                    throwOnError: false
                });"></script>
    @sidebar.Script()
	@tabs.Script()
	@collapsible.Script()
	@dropdown.Script()
	@popover.Script()
    @dialog.Script()
    @toast.Script()
    @chart.Script()
    @input.Script()
	@textarea.Script()
	@chart.Script()

    @components.Sidebar("/admin/dashboard/subjects", []navbar.BreadPath{
        {
            Href: "/admin/dashboard",
            Path: "Dashboard",
        },
        {
            Href: "/admin/dashboard/subjects",
            Path: "Subjects",
        },
        {
            Href: "/admin/dashboard/subject/" + param.Subject.ID.String(),
            Path: param.Subject.Title,
        },
		{
			Href: "/admin/dashboard/subject/" + param.Subject.ID.String() + "/exam/" + param.Exam.ID.String(),
			Path: param.Exam.Title,
		},
    }, param.Username, param.FullName) {

     			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
    				<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
					<div>
						<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
							@icon.Book(icon.Props{Class: "h-8 w-8"})
							{param.Exam.Title}
						</h1>
						<p class="text-slate-500 mt-1">Edit exam information</p>

						// TODO: Remove this
            <div class="text-gray-800 text-lg latex-content">
                { `
					$S = {x \in \mathbb{Z} : x > 0}$
				` }
            </div>
			
					</div>
               </div>
				@TabsExam(param)
			</div>
			<div id="toast-container"></div>
		}
	}

templ TabsExam(param EditExamPageParam) {
	@tabs.Tabs(tabs.Props{
		ID: "account-tabs",
	}) {
		@tabs.List(tabs.ListProps{
			Class: "w-full max-w-full",
		}) {
			@tabs.Trigger(tabs.TriggerProps{
				Value: "questions",
				IsActive: true,
                TabsID:   "account-tabs",
                Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Questions
			}

			@tabs.Trigger(tabs.TriggerProps{
				Value: "students",
                TabsID:   "account-tabs",
                Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Students	
			}

			@tabs.Trigger(tabs.TriggerProps{
				Value:    "analytics",
                TabsID:   "account-tabs",
                Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Exam Analytics
			}

			@tabs.Trigger(tabs.TriggerProps{
				Value:    "information",
                TabsID:   "account-tabs",
                Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Exam Information
			}
		}
		<div class="w-full mt-2">
			@tabs.Content(tabs.ContentProps{
				Value:    "information",
                TabsID:   "account-tabs",
			}) {
				@ExamInformationTab(param)
			}
			@tabs.Content(tabs.ContentProps{
				Value:    "questions",
                TabsID:   "account-tabs",
			}) {
                // TODO: Implement QuestionsTab
			}
			@tabs.Content(tabs.ContentProps{
				Value:    "students",
                TabsID:   "account-tabs",
			}) {
                // TODO: Implement StudentsTab
			}
			@tabs.Content(tabs.ContentProps{
				Value:    "analytics",
                TabsID:   "account-tabs",
			}) {
                // TODO: Implement AnalyticsTab
			}
		</div>
	}
}

templ ExamInformationTab(param EditExamPageParam) {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Exam Information 
			}
			@card.Description() {
				Make changes to your exam here. Click save when you are done.
			}
		}
		<form id="edit_exam_form"
			hx-post={ "/admin/dashboard/exam/edit/" + param.Exam.ID.String() }
			hx-target="#toast-container"
			hx-swap="none">
		@card.Content() {
			<div class="grid grid-cols-2 gap-4">
			<div>
			@label.Label(label.Props{
				For: "exam_name",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Pen(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Name
			}

			@input.Input(input.Props{
				Type: input.TypeText,
				Placeholder: "Exam Name",
				ID: "exam_name",
				Name: "exam_name",
				Value: param.Exam.Title,
				Class: "mb-4",
			})
			</div>
			<div>
			@label.Label(label.Props{
				For: "exam_uuid",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Hash(icon.Props{
					Class: "h-4 w-4",
				})
				Exam UUID 
			}
			@input.Input(input.Props{
				Type: input.TypeText,
				ID: "exam_uuid",
				Value: param.Exam.ID.String(),
				Readonly: true,
				Disabled: true,
				Class: "mb-4",
			})
			</div>
			
			<div>
			@label.Label(label.Props{
				For: "exam_duration",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Clock(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Duration 
			}
			@input.Input(input.Props{
				Type: input.TypeText,
				ID: "exam_duration",
				Value: strconv.Itoa(int(param.Exam.DurationMinutes)),
				Class: "mb-4",
			})
			</div>
			<div>
			@label.Label(label.Props{
				For: "exam_subject_uuid",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Book(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Subject UUID 
			}
			@input.Input(input.Props{
				Type: input.TypeText,
				ID: "exam_subject_uuid",
				Value: param.Exam.SubjectID.String(),
				Readonly: true,
				Disabled: true,
				Class: "mb-4",
			})
			</div>
			<div>
			@label.Label(label.Props{
				For: "exam_pass_score",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Trophy(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Pass Score 
			}
			@input.Input(input.Props{
				Type: input.TypeText,
				ID: "exam_pass_score",
				Value: strconv.Itoa(int(param.Exam.PassScore)),
				Class: "mb-4",
			})
			</div>
			<div>
			@label.Label(label.Props{
				For: "exam_created_by",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.User(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Created By 
			}
			@input.Input(input.Props{
				Type: input.TypeText,
				ID: "exam_created_by",
				Value: param.Exam.CreatedBy.String(),
				Readonly: true,
				Disabled: true,
				Class: "mb-4",
			})
			</div>

			<div>
			@label.Label(label.Props{
				For: "exam_total_marks",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.BadgeCheck(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Total Marks 
			}
			@input.Input(input.Props{
				Type: input.TypeText,
				ID: "exam_total_marks",
				Value: strconv.Itoa(int(param.Exam.TotalMarks)),
				Class: "mb-4",
			})
			</div>
			<div>
			@label.Label(label.Props{
				For: "exam_status",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.BadgeCheck(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Status 
			}
			@input.Input(input.Props{
				Type: input.TypeText,
				ID: "exam_status",
				Value: string(param.Exam.Status),
				Class: "mb-4",
			})
			</div>
			</div>
			@label.Label(label.Props{
				For: "exam_description",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.MessageSquareText(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Description
			}

			@textarea.Textarea(textarea.Props{
				Placeholder: "Exam Description",
				ID: "exam_description",
				Name: "exam_description",
				Rows: 3,
				Value: utils.IfElse(param.Exam.Description != nil, *param.Exam.Description, ""),
				Class: "mb-4",
			})
		}
		@card.Footer(card.FooterProps{
			Class: "flex justify-end gap-2",
		}) {
			@button.Button(button.Props{
				Type: button.TypeButton,
				Class: "bg-red-500 hover:bg-red-600",
				Attributes: templ.Attributes{
					"hx-post": "/admin/dashboard/exam/delete/" + param.Exam.ID.String(),
					"hx-target": "#toast-container",
					"hx-swap": "none",
				},
			}) {
				Delete Exam
			}

			@button.Button(button.Props{
				Type: button.TypeSubmit,
				Form: "edit_exam_form",
				
			}) {
				Save changes
			}
		}
		</form>
	}
}
