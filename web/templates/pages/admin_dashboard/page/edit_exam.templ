package page


import (
 "uot-exam/internal/domain"
 "uot-exam/web/templates/pages/admin_dashboard/components"
 "uot-exam/web/templates/components/navbar"
 "uot-exam/web/templates/components/sidebar"
 "uot-exam/web/templates/components/collapsible"
 "uot-exam/web/templates/components/dropdown"
 "uot-exam/web/templates/components/popover"
 "uot-exam/web/templates/components/toast"
 "uot-exam/web/templates/components/chart"
 "uot-exam/web/templates/components/icon"
 "uot-exam/web/templates/components/tabs"
 "uot-exam/web/templates/components/input"
 "uot-exam/web/templates/components/textarea"
 "uot-exam/web/templates/components/card"
 "uot-exam/web/templates/components/label"
 "uot-exam/web/templates/utils"
 "uot-exam/web/templates/components/button"
 "strconv"
 "uot-exam/web/templates/components/badge"
 "uot-exam/web/templates/components/selectbox"
 "uot-exam/web/templates/components/dialog"
 "fmt"
)

type EditExamPageParam struct {
	Username string
	FullName string
	Subject  domain.Subject
	Instructor domain.User
	Exam domain.Exam
	Questions []domain.Question
	Attempts []domain.ExamAttempt
	Analytics domain.ExamAnalytics
}

templ EditExamPage(param EditExamPageParam) {

	        <!-- KaTeX CSS -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" 
              integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" 
              crossorigin="anonymous"/>
		<link rel="stylesheet" href="/src/katex/katex.min.css" />
        
        <!-- KaTeX JS -->
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" 
                integrity="sha384-XjKyOOlGwcjNTAIQHIpgOno0Hl1YQqzUOEleOLALmuqehneUG+vnGctmUb0ZY0l8" 
                crossorigin="anonymous"></script>
        <script defer src="/src/katex/katex.min.js">
        <!-- KaTeX Auto-render Extension -->
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" 
                integrity="sha384-+VBxd3r6XgURycqtZ117nYw44OOcIax56Z4dCRWbxyPt0Koah1uHoK0o4+/RRE05" 
                crossorigin="anonymous"
                onload="renderMathInElement(document.body, {
                    delimiters: [
                        {left: '$$', right: '$$', display: true},
                        {left: '$', right: '$', display: false},
                        {left: '\\[', right: '\\]', display: true},
                        {left: '\\(', right: '\\)', display: false}
                    ],
                    throwOnError: false
                });"></script>

     <script defer src="/src/katex/contrib/auto-render.min.js" 
                onload="renderMathInElement(document.body, {
                    delimiters: [
                        {left: '$$', right: '$$', display: true},
                        {left: '$', right: '$', display: false},
                        {left: '\\[', right: '\\]', display: true},
                        {left: '\\(', right: '\\)', display: false}
                    ],
                    throwOnError: false
                });"></script>



        <!-- Highlight.js CSS (GitHub Dark theme) -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css"/>
        
        <!-- Highlight.js JavaScript -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>


    @sidebar.Script()
	@tabs.Script()
	@collapsible.Script()
	@dropdown.Script()
	@popover.Script()
	@dialog.Script()
    @toast.Script()
    @input.Script()
	@selectbox.Script()
	@textarea.Script()
	@chart.Script()
	@label.Script()
	<script>
            // Highlight all code blocks on page load
            hljs.highlightAll();
            
            // Re-highlight after HTMX updates
            document.body.addEventListener('htmx:afterSwap', function(event) {
                event.detail.target.querySelectorAll('pre code').forEach((block) => {
                    hljs.highlightElement(block);
                });
            });
        </script>

    @components.Sidebar("/admin/dashboard/subjects", []navbar.BreadPath{
        {
            Href: "/admin/dashboard",
            Path: "Dashboard",
        },
        {
            Href: "/admin/dashboard/subjects",
            Path: "Subjects",
        },
        {
            Href: "/admin/dashboard/subject/" + param.Subject.ID.String(),
            Path: param.Subject.Title,
        },
		{
			Href: "/admin/dashboard/subject/" + param.Subject.ID.String() + "/exam/" + param.Exam.ID.String(),
			Path: param.Exam.Title,
		},
    }, param.Username, param.FullName, "/admin/dashboard") {

     			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
    				<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
					<div>
						<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
							@icon.Book(icon.Props{Class: "h-8 w-8"})
							{param.Exam.Title}
						</h1>
						<p class="text-slate-500 mt-1">Edit exam information</p>
					</div>
               </div>
				@TabsExam(param)
			</div>
			<div id="toast-container"></div>
		}
	}

templ TabsExam(param EditExamPageParam) {
	@tabs.Tabs(tabs.Props{
		ID: "account-tabs",
	}) {
		@tabs.List(tabs.ListProps{
			Class: "w-full max-w-full",
		}) {
			@tabs.Trigger(tabs.TriggerProps{
				Value: "questions",
				IsActive: true,
                TabsID:   "account-tabs",
                Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Questions
			}

			@tabs.Trigger(tabs.TriggerProps{
				Value: "students",
                TabsID:   "account-tabs",
                Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Students	
			}

			@tabs.Trigger(tabs.TriggerProps{
				Value:    "analytics",
                TabsID:   "account-tabs",
                Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Exam Analytics
			}

			@tabs.Trigger(tabs.TriggerProps{
				Value:    "information",
                TabsID:   "account-tabs",
                Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Exam Information
			}
		}
		<div class="w-full mt-2">
			@tabs.Content(tabs.ContentProps{
				Value:    "information",
                TabsID:   "account-tabs",
			}) {
				@ExamInformationTab(param)
			}
			@tabs.Content(tabs.ContentProps{
				Value:    "questions",
                TabsID:   "account-tabs",
			}) {
				@QuestionsTab(param)
			}
			@tabs.Content(tabs.ContentProps{
				Value:    "students",
				TabsID:   "account-tabs",
			}) {
				@ExamStudentsTab(param)
			}
			@tabs.Content(tabs.ContentProps{
				Value:    "analytics",
                TabsID:   "account-tabs",
			}) {
				@AnalyticsTab(param)
			}
		</div>
	}
}

templ ExamInformationTab(param EditExamPageParam) {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Exam Information 
			}
			@card.Description() {
				Make changes to your exam here. Click save when you are done.
			}
		}
		<form id="edit_exam_form"
			hx-post={ "/admin/dashboard/exam/edit/" + param.Exam.ID.String() }
			hx-target="#toast-container"
			hx-swap="none">
		@card.Content() {
			<div class="grid grid-cols-2 gap-4">
			<div>
			@label.Label(label.Props{
				For: "exam_name",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Pen(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Name
			}

			@input.Input(input.Props{
				Type: input.TypeText,
				Placeholder: "Exam Name",
				ID: "exam_name",
				Name: "exam_name",
				Value: param.Exam.Title,
				Class: "mb-4",
				Disabled: string(param.Exam.Status) != "DRAFT",
			})
			</div>
			<div>
			@label.Label(label.Props{
				For: "exam_uuid",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Hash(icon.Props{
					Class: "h-4 w-4",
				})
				Exam UUID 
			}
			@input.Input(input.Props{
				Type: input.TypeText,
				ID: "exam_uuid",
				Value: param.Exam.ID.String(),
				Readonly: true,
				Disabled: true,
				Class: "mb-4",
			})
			</div>
			
			<div>
			@label.Label(label.Props{
				For: "exam_subject_uuid",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.Book(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Subject UUID 
			}
			@input.Input(input.Props{
				Type: input.TypeText,
				ID: "exam_subject_uuid",
				Value: param.Exam.SubjectID.String(),
				Readonly: true,
				Disabled: true,
				Class: "mb-4",
			})
			</div>


			<div>
			@label.Label(label.Props{
				For: "exam_created_by",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.User(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Created By 
			}
			@input.Input(input.Props{
				Type: input.TypeText,
				ID: "exam_created_by",
				Value: param.Exam.CreatedBy.String(),
				Readonly: true,
				Disabled: true,
				Class: "mb-4",
			})
			</div>

			<div>
			@label.Label(label.Props{
				For: "exam_total_marks",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.BadgeCheck(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Total Marks 
			}
			@input.Input(input.Props{
				Type: input.TypeNumber,
				ID: "exam_total_marks",
				Name: "exam_total_marks",
				Value: fmt.Sprintf("%.2f", param.Exam.TotalMarks),
				Class: "mb-4",
				Disabled: string(param.Exam.Status) != "DRAFT",
				Attributes: templ.Attributes{
					"min": "0",
					"step": "0.1",
				},
			})
			</div>
			<div>
			@label.Label(label.Props{
				For: "exam_pass_score",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.BadgeCheck(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Pass Score 
			}
			@input.Input(input.Props{
				Type: input.TypeNumber,
				ID: "exam_pass_score",
				Name: "exam_pass_score",
				Value: fmt.Sprintf("%.2f", param.Exam.PassScore),
				Class: "mb-4",
				Disabled: string(param.Exam.Status) != "DRAFT",
				Attributes: templ.Attributes{
					"min": "0",
					"step": "0.1",
				},
			})
			</div>
			<div>
			@label.Label(label.Props{
				For: "exam_status",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.BadgeCheck(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Status 
			}
		if string(param.Exam.Status) == "DRAFT" {
			@selectbox.SelectBox() {
				@selectbox.Trigger(selectbox.TriggerProps{
					Name: "exam_status",
				}) {
					@selectbox.Value(selectbox.ValueProps{
						Placeholder: "Select the status",
					}) {
						switch string(param.Exam.Status) {
							case "DRAFT":
								@badge.Badge(badge.Props{
									Variant: badge.VariantSecondary,
								}) {
									Draft
								}
							case "PUBLISHED":
								@badge.Badge(badge.Props{
									Variant: badge.VariantDefault,
								}) {
									Published
								}
							case "ARCHIVED", "CLOSED":
								@badge.Badge(badge.Props{
									Variant: badge.VariantDestructive,
								}) {
									{ utils.IfElse(string(param.Exam.Status) == "CLOSED", "Closed", "Archived") }
								}
						}
					}
				}
				@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
					@selectbox.Group() {
						@selectbox.Label() {
							Status
						}
						@selectbox.Item(selectbox.ItemProps{
							Value: "DRAFT",
							Selected: string(param.Exam.Status) == "DRAFT",
							Class: "mb-2 mt-2",
						}) {
							@badge.Badge(badge.Props{
								Variant: badge.VariantSecondary,
							}) {
								Draft
							}
						}
						@selectbox.Item(selectbox.ItemProps{
							Value: "PUBLISHED",
							Selected: string(param.Exam.Status) == "PUBLISHED",
							Class: "mb-2",
						}) {
							@badge.Badge(badge.Props{
								Variant: badge.VariantDefault,
							}) {
								Published
							}
						}
						@selectbox.Item(selectbox.ItemProps{
							Value: "ARCHIVED",
							Selected: string(param.Exam.Status) == "ARCHIVED",
							Class: "mb-2",
						}) {
							@badge.Badge(badge.Props{
								Variant: badge.VariantDestructive,
							}) {
								Archived
							}
						}
					}
				}
			}
		} else {
			@button.Button(button.Props{
				Type:    "button",
				Variant: button.VariantOutline,
				Class: utils.TwMerge(
					"w-full h-9 px-3 py-1 text-base text-black md:text-sm",
					"flex items-center justify-between",
					"rounded-md border border-input bg-transparent shadow-xs outline-none",
					"opacity-50 cursor-not-allowed pointer-events-none bg-muted focus:ring-0",
				),
				Disabled: true,
			}) {
				<div class="flex items-center block truncate select-value text-black">
					switch string(param.Exam.Status) {
						case "PUBLISHED":
							@badge.Badge(badge.Props{
								Variant: badge.VariantDefault,
								Class:   "bg-blue-600 text-black",
							}) {
								Published
							}
						case "CLOSED":
							@badge.Badge(badge.Props{
								Variant: badge.VariantDestructive,
							}) {
								Closed
							}
					}
				</div>
				<span class="pointer-events-none ml-1">
					@icon.ChevronDown(icon.Props{
						Size:  16,
						Class: "text-black",
					})
				</span>
			}
			<input type="hidden" name="exam_status" value={ string(param.Exam.Status) } />
		}
			</div>
			</div>
			@label.Label(label.Props{
				For: "exam_description",
				Class: "flex items-center gap-2 mb-2 mt-4",
			}) {
				@icon.MessageSquareText(icon.Props{
					Class: "h-4 w-4",
				})
				Exam Description
			}

			@textarea.Textarea(textarea.Props{
				Placeholder: "Exam Description",
				ID: "exam_description",
				Name: "exam_description",
				Rows: 3,
				Value: utils.IfElse(param.Exam.Description != nil, *param.Exam.Description, ""),
				Class: "mb-4",
				Disabled: string(param.Exam.Status) != "DRAFT",
			})
		}
		@card.Footer(card.FooterProps{
			Class: "flex justify-end gap-2",
		}) {
			if string(param.Exam.Status) == "DRAFT" {
				@button.Button(button.Props{
					Type: button.TypeButton,
					Class: "bg-red-500 hover:bg-red-600",
					Attributes: templ.Attributes{
						"hx-post": "/admin/dashboard/exam/delete/" + param.Exam.ID.String(),
						"hx-target": "#toast-container",
						"hx-swap": "none",
					},
				}) {
					Delete Exam
				}

				@button.Button(button.Props{
					Type: button.TypeSubmit,
					Form: "edit_exam_form",
					
				}) {
					Save changes
				}
			}
		}
		</form>
	}
}

templ QuestionsTab(param EditExamPageParam) {

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
@components.TotalCard(components.TotalCardProps{
	Title: "Total Questions",
	Description: "Number of questions in this exam.",
	Icon: icon.BadgeQuestionMark(icon.Props{
		Class: "h-10 w-10 text-primary",
	}),
	Value: strconv.Itoa(len(param.Questions)),
})
	@components.TotalCard(components.TotalCardProps{
		Title: "Pass Score",
		Description: "Minimum score required to pass.",
		Icon: icon.CircleCheck(icon.Props{
			Class: "h-10 w-10 text-green-500",
		}),
		Value: fmt.Sprintf("%.2f / %.2f", param.Exam.PassScore, param.Exam.TotalMarks),
	})
	@components.TotalCard(components.TotalCardProps{
		Title: "Status",
		Description: "Current status of the exam.",
		Icon: icon.Activity(icon.Props{
			Class: "h-10 w-10 text-yellow-500",
		}),
		Value: string(param.Exam.Status),
	})
</div>
	@card.Card() {
		@card.Header() {
			@card.Title() {
				<div class="flex items-center gap-2 justify-between w-full">
				Questions
				<div class="flex items-center gap-2">
					@button.Button(button.Props{
						Variant: button.VariantSecondary,
						Size: button.SizeSm,
						Href: "/admin/dashboard/exam/" + param.Exam.ID.String() + "/export-csv",
					}) {
						@icon.Download(icon.Props{
							Class: "h-4 w-4",
						})
						Export As CSV
					}
					if string(param.Exam.Status) == "DRAFT" {
						@components.AddViaCSVDialog(components.EditExamPageParam{
							Exam: param.Exam,
						})
						@components.AddDialog(components.EditExamPageParam{
							Exam: param.Exam,
						})
					}
				</div>
			</div>
			@card.Description() {
				create questions for your exam here.
			}
			}
		}
		@card.Content() {
			@components.QuestionList(components.QuestionListProps{
				Questions: param.Questions,
			})
		}
	}
}

templ ExamStudentsTab(param EditExamPageParam) {
	<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
		@components.TotalCard(components.TotalCardProps{
			Title: "Total Attempts",
			Description: "Total number of student attempts.",
			Icon: icon.Users(icon.Props{
				Class: "h-10 w-10 text-blue-500",
			}),
			Value: strconv.Itoa(len(param.Attempts)),
		})
		@components.TotalCard(components.TotalCardProps{
			Title: "In Progress",
			Description: "Students currently taking the exam.",
			Icon: icon.Clock(icon.Props{
				Class: "h-10 w-10 text-yellow-500",
			}),
			Value: strconv.Itoa(countInProgress(param.Attempts)),
		})
		@components.TotalCard(components.TotalCardProps{
			Title: "Completed",
			Description: "Students who have submitted their exam.",
			Icon: icon.CircleCheck(icon.Props{
				Class: "h-10 w-10 text-green-500",
			}),
			Value: strconv.Itoa(countCompleted(param.Attempts)),
		})
	</div>
	@card.Card() {
		@card.Header() {
			<div class="flex items-center justify-between">
				<div>
					@card.Title() {
						Student Attempts
					}
					@card.Description() {
						Monitor student progress and scores for this exam.
					}
				</div>
				@button.Button(button.Props{
					Variant: button.VariantSecondary,
					Size:    button.SizeSm,
					Href:    fmt.Sprintf("/admin/dashboard/exam/%s/export-pdf", param.Exam.ID.String()),
                    Attributes: templ.Attributes{"download": "true"},
				}) {
					@icon.FileText(icon.Props{Class: "h-4 w-4 mr-1"})
					Export PDF
				}
			</div>
		}
		@card.Content() {
			@components.AttemptTable(param.Attempts, string(param.Exam.Status))
		}
	}
}

func countInProgress(attempts []domain.ExamAttempt) int {
	count := 0
	for _, a := range attempts {
		if a.Status == "IN_PROGRESS" {
			count++
		}
	}
	return count
}

func countCompleted(attempts []domain.ExamAttempt) int {
	count := 0
	for _, a := range attempts {
		if a.Status == "SUBMITTED" || a.Status == "GRADED" {
			count++
		}
	}
	return count
}

templ AnalyticsTab(param EditExamPageParam) {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
		@card.Card() {
			@card.Content(card.ContentProps{Class: "p-6"}) {
				<div class="flex items-center justify-between">
					<div>
						<p class="text-sm font-medium text-slate-500">Average Score</p>
						<h3 class="text-2xl font-bold text-slate-900">{ fmt.Sprintf("%.2f", param.Analytics.AverageScore) }</h3>
					</div>
					<div class="p-3 bg-blue-50 rounded-lg text-blue-600">
						@icon.TrendingUp(icon.Props{Class: "h-6 w-6"})
					</div>
				</div>
			}
		}
		@card.Card() {
			@card.Content(card.ContentProps{Class: "p-6"}) {
				<div class="flex items-center justify-between">
					<div>
						<p class="text-sm font-medium text-slate-500">Pass Rate</p>
						<h3 class="text-2xl font-bold text-slate-900">{ fmt.Sprintf("%.1f%%", param.Analytics.PassRate) }</h3>
					</div>
					<div class="p-3 bg-green-50 rounded-lg text-green-600">
						@icon.CircleCheck(icon.Props{Class: "h-6 w-6"})
					</div>
				</div>
			}
		}
		@card.Card() {
			@card.Content(card.ContentProps{Class: "p-6"}) {
				<div class="flex items-center justify-between">
					<div>
						<p class="text-sm font-medium text-slate-500">Highest Score</p>
						<h3 class="text-2xl font-bold text-slate-900">{ fmt.Sprintf("%.2f", param.Analytics.MaxScore) }</h3>
					</div>
					<div class="p-3 bg-purple-50 rounded-lg text-purple-600">
						@icon.Trophy(icon.Props{Class: "h-6 w-6"})
					</div>
				</div>
			}
		}
		@card.Card() {
			@card.Content(card.ContentProps{Class: "p-6"}) {
				<div class="flex items-center justify-between">
					<div>
						<p class="text-sm font-medium text-slate-500">Total Attempts</p>
						<h3 class="text-2xl font-bold text-slate-900">{ fmt.Sprintf("%d", param.Analytics.TotalAttempts) }</h3>
					</div>
					<div class="p-3 bg-orange-50 rounded-lg text-orange-600">
						@icon.Users(icon.Props{Class: "h-6 w-6"})
					</div>
				</div>
			}
		}
	</div>

	<div class="grid grid-cols-2 gap-6 mb-6">
		@card.Card() {
			@card.Header() {
				@card.Title() { Pass/Fail Distribution }
				@card.Description() { Overview of student success rate. }
			}
			@card.Content() {
				<div class="h-[100px]">
					@chart.Chart(chart.Props{
						Variant: chart.VariantPie,
						Data: chart.Data{
							Labels: []string{"Pass", "Fail"},
							Datasets: []chart.Dataset{
								{
									Label: "Distribution",
									Data: []float64{float64(param.Analytics.PassCount), float64(param.Analytics.FailCount)},
									BackgroundColor: []string{"rgba(34, 197, 94, 0.6)", "rgba(239, 68, 68, 0.6)"},
									BorderColor: []string{"rgb(34, 197, 94)", "rgb(239, 68, 68)"},
								},
							},
						},
						ShowLegend: true,
					})
				</div>
			}
		}
		@card.Card() {
			@card.Header() {
				@card.Title() { Score Summary }
				@card.Description() { Comparison of key score metrics. }
			}
			@card.Content() {
				<div class="h-[100px]">
					@chart.Chart(chart.Props{
						Variant: chart.VariantBar,
						Data: chart.Data{
							Labels: []string{"Min", "Avg", "Max"},
							Datasets: []chart.Dataset{
								{
									Label: "Scores",
									Data: []float64{param.Analytics.MinScore, param.Analytics.AverageScore, param.Analytics.MaxScore},
									BackgroundColor: "rgba(59, 130, 246, 0.6)",
									BorderColor: "rgb(59, 130, 246)",
									BorderWidth: 1,
								},
							},
						},
						ShowXLabels: true,
						ShowYLabels: true,
						BeginAtZero: Ptr(true),
					})
				</div>
			}
		}
	</div>

	@card.Card() {
		@card.Header() {
			@card.Title() { Question-Level Analysis }
			@card.Description() { Detailed performance breakdown for each question. }
		}
		@card.Content(card.ContentProps{Class: "p-0"}) {
			<div class="overflow-x-auto">
				<table class="w-full text-sm text-left">
					<thead class="text-xs text-slate-700 uppercase bg-slate-50">
						<tr>
							<th class="px-6 py-3">Question</th>
							<th class="px-6 py-3 text-center">Type</th>
							<th class="px-6 py-3 text-center">Total Answers</th>
							<th class="px-6 py-3 text-center">Correct</th>
							<th class="px-6 py-3 text-center">Accuracy</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-200">
						for _, stat := range param.Analytics.QuestionStats {
							<tr class="bg-white hover:bg-slate-50 transition-colors">
								<td class="px-6 py-4 font-medium text-slate-900">{ stat.QuestionTitle }</td>
								<td class="px-6 py-4 text-center">
									@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
										{ stat.QuestionType }
									}
								</td>
								<td class="px-6 py-4 text-center">{ fmt.Sprintf("%d", stat.TotalAnswers) }</td>
								<td class="px-6 py-4 text-center text-green-600 font-semibold">{ fmt.Sprintf("%d", stat.CorrectAnswers) }</td>
								<td class="px-6 py-4 text-center">
									<div class="flex items-center justify-center gap-2">
										<div class="w-16 bg-slate-200 rounded-full h-1.5 overflow-hidden">
											<div class="bg-blue-600 h-full" style={ fmt.Sprintf("width: %.1f%%", stat.Accuracy) }></div>
										</div>
										<span class="text-xs font-medium text-slate-600">{ fmt.Sprintf("%.1f%%", stat.Accuracy) }</span>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}



func Ptr[T any](v T) *T {
	return &v
}
