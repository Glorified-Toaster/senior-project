package page

import "uot-exam/internal/domain"
import "uot-exam/web/templates/pages/admin_dashboard/components"
import "uot-exam/web/templates/components/navbar"
import "uot-exam/web/templates/components/sidebar"
import "uot-exam/web/templates/components/collapsible"
import "uot-exam/web/templates/components/dropdown"
import "uot-exam/web/templates/components/popover"
import "uot-exam/web/templates/components/dialog"
import "uot-exam/web/templates/components/toast"
import "uot-exam/web/templates/components/chart"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/tabs"
import "uot-exam/web/templates/components/input"
import "uot-exam/web/templates/components/textarea"

type EditExamPageParam struct {
	Username string
	FullName string
	Subject  domain.Subject
	Instructor domain.User
	Exam domain.Exam
}

templ EditExamPage(param EditExamPageParam) {
	        <!-- KaTeX CSS -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" 
              integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" 
              crossorigin="anonymous"/>
        
        <!-- KaTeX JS -->
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" 
                integrity="sha384-XjKyOOlGwcjNTAIQHIpgOno0Hl1YQqzUOEleOLALmuqehneUG+vnGctmUb0ZY0l8" 
                crossorigin="anonymous"></script>
        
        <!-- KaTeX Auto-render Extension -->
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" 
                integrity="sha384-+VBxd3r6XgURycqtZ117nYw44OOcIax56Z4dCRWbxyPt0Koah1uHoK0o4+/RRE05" 
                crossorigin="anonymous"
                onload="renderMathInElement(document.body, {
                    delimiters: [
                        {left: '$$', right: '$$', display: true},
                        {left: '$', right: '$', display: false},
                        {left: '\\[', right: '\\]', display: true},
                        {left: '\\(', right: '\\)', display: false}
                    ],
                    throwOnError: false
                });"></script>
    @sidebar.Script()
	@tabs.Script()
	@collapsible.Script()
	@dropdown.Script()
	@popover.Script()
    @dialog.Script()
    @toast.Script()
    @chart.Script()
    @input.Script()
	@textarea.Script()
	@chart.Script()

    @components.Sidebar("/admin/dashboard/subjects", []navbar.BreadPath{
        {
            Href: "/admin/dashboard",
            Path: "Dashboard",
        },
        {
            Href: "/admin/dashboard/subjects",
            Path: "Subjects",
        },
        {
            Href: "/admin/dashboard/subject/" + param.Subject.ID.String(),
            Path: param.Subject.Title,
        },
		{
			Href: "/admin/dashboard/subject/" + param.Subject.ID.String() + "/exam/" + param.Exam.ID.String(),
			Path: param.Exam.Title,
		},
    }, param.Username, param.FullName) {

     			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
    				<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
					<div>
						<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
							@icon.Book(icon.Props{Class: "h-8 w-8"})
							{param.Exam.Title}
						</h1>
						<p class="text-slate-500 mt-1">Edit exam information</p>

						// TODO: Remove this
            <div class="text-gray-800 text-lg latex-content">
                { `
					$S = {x \in \mathbb{Z} : x > 0}$
				` }
            </div>
			
					</div>
               </div>
				@TabsExam(param)
			</div>
			<div id="toast-container"></div>
		}
	}

templ TabsExam(param EditExamPageParam) {
	@tabs.Tabs(tabs.Props{
		ID: "account-tabs",
	}) {
		@tabs.List(tabs.ListProps{
			Class: "w-full max-w-full",
		}) {
			@tabs.Trigger(tabs.TriggerProps{
				Value: "questions",
				IsActive: true,
                TabsID:   "account-tabs",
                Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Questions
			}

			@tabs.Trigger(tabs.TriggerProps{
				Value: "students",
                TabsID:   "account-tabs",
                Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Students	
			}

			@tabs.Trigger(tabs.TriggerProps{
				Value:    "analytics",
                TabsID:   "account-tabs",
                Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Exam Analytics
			}

			@tabs.Trigger(tabs.TriggerProps{
				Value:    "information",
                TabsID:   "account-tabs",
                Class: "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Exam Information
			}
		}
		<div class="w-full mt-2">
			@tabs.Content(tabs.ContentProps{
				Value:    "information",
                TabsID:   "account-tabs",
			}) {
                // TODO: Implement InformationTab
			}
			@tabs.Content(tabs.ContentProps{
				Value:    "questions",
                TabsID:   "account-tabs",
			}) {
                // TODO: Implement QuestionsTab
			}
			@tabs.Content(tabs.ContentProps{
				Value:    "students",
                TabsID:   "account-tabs",
			}) {
                // TODO: Implement StudentsTab
			}
			@tabs.Content(tabs.ContentProps{
				Value:    "analytics",
                TabsID:   "account-tabs",
			}) {
                // TODO: Implement AnalyticsTab
			}
		</div>
	}
}

