package page

import "uot-exam/web/templates/pages/admin_dashboard/components"
import "uot-exam/web/templates/components/navbar"
import "uot-exam/web/templates/components/sidebar"
import "uot-exam/web/templates/components/collapsible"
import "uot-exam/web/templates/components/dropdown"
import "uot-exam/web/templates/components/popover"
import "uot-exam/web/templates/components/dialog"
import "uot-exam/web/templates/components/toast"
import "uot-exam/web/templates/components/chart"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/selectbox"
import "uot-exam/web/templates/components/input"
import "uot-exam/web/templates/components/tabs"
import "fmt"

templ AllUsers(params AdminDashboardParam) {
	@sidebar.Script()
	@collapsible.Script()
	@dropdown.Script()
	@popover.Script()
	@dialog.Script()
	@selectbox.Script()
	@input.Script()
	@toast.Script()
	@chart.Script()
	@tabs.Script()
	@components.Sidebar("/admin/dashboard/users", []navbar.BreadPath{
		{
			Href: "/admin/dashboard",
			Path: "Dashboard",
		},
		{
			Href: "/admin/dashboard/users",
			Path: "Users",
		},
	}, params.Username, params.FullName, params.UserID, "/admin/dashboard") {
					<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
				<div>
					<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
						@icon.Users(icon.Props{Class: "h-8 w-8"})
						All Users
					</h1>
					<p class="text-slate-500 mt-1">List of all users on the platform.</p>
				</div>
			</div>
			@UserTabs(params)
		</div>
		<div id="toast-container"></div>
	}
}

templ UserTabs(params AdminDashboardParam) {
	@tabs.Tabs(tabs.Props{
		ID: "account-tabs",
	}) {
		@tabs.List(tabs.ListProps{
			Class: "w-full",
		}) {
			@tabs.Trigger(tabs.TriggerProps{
				Value:    "all_users",
				IsActive: true,
				TabsID:   "account-tabs",
				Class:    "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				All Users
			}
			@tabs.Trigger(tabs.TriggerProps{
				Value:  "deleted_users",
				TabsID: "account-tabs",
				Class:  "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Deleted Users
			}
		}
		<div class="w-full mt-2">
			@tabs.Content(tabs.ContentProps{
				Value:  "all_users",
				TabsID: "account-tabs",
			}) {
				@AllUsersContent(params)
			}
			@tabs.Content(tabs.ContentProps{
				Value:  "deleted_users",
				TabsID: "account-tabs",
			}) {
				@DeletedUsersContent(params)
			}
		</div>
	}
}

templ AllUsersContent(params AdminDashboardParam) {
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
				@components.TotalCard(components.TotalCardProps{
					Title:       "Total Users",
					Description: "Total number of users on the platform.",
					Value:       params.TotalUsers,
					Icon:        icon.Users(icon.Props{Class: "h-8 w-8"}),
					ColorClass:  "bg-blue-50 text-blue-600",
				})
				@components.TotalCard(components.TotalCardProps{
					Title:       "Total Instructors",
					Description: "Total number of instructors on the platform.",
					Value:       params.TotalInstructors,
					Icon:        icon.UserRoundPen(icon.Props{Class: "h-8 w-8"}),
					ColorClass:  "bg-purple-50 text-purple-600",
				})
				@components.TotalCard(components.TotalCardProps{
					Title:       "Total Students",
					Description: "Total number of students on the platform.",
					Value:       params.TotalStudents,
					Icon:        icon.User(icon.Props{Class: "h-8 w-8"}),
					ColorClass:  "bg-green-50 text-green-600",
				})
			</div>

			@components.UserTable(components.UserTableProps{
				Title:      "All Users",
				Users:      params.Users,
				TotalCount: params.TotalUsersCount,
				Limit:      12,
				Offset:     0,
				BaseURL:    "/admin/dashboard/users",
				Search:     true,
				SearchAPI:  "/admin/users/search",
				AddUser:    true,
				AddUserCSV: true,
			})
}

templ DeletedUsersContent(params AdminDashboardParam) {
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
				@components.TotalCard(components.TotalCardProps{
					Title:       "Total Deleted Users",
					Description: "Total number of deleted users on the platform.",
					Value:       fmt.Sprintf("%d", params.DeletedUsersCount),
					Icon:        icon.Users(icon.Props{Class: "h-8 w-8"}),
					ColorClass:  "bg-red-50 text-red-600",
				})
			</div>
			@components.UserTable(components.UserTableProps{
				Title:         "Deleted Users",
				ID:            "deleted-users-table-container",
				Users:         params.DeletedUsers,
				TotalCount:    params.DeletedUsersCount,
				Limit:         12,
				Offset:        0,
				BaseURL:       "/admin/dashboard/users/deleted",
				Search:        true,
				SearchAPI:     "/admin/dashboard/users/deleted/search",
				AddUser:       false,
				DeletedButton: true,
				RestoreButton: true,
			})
}