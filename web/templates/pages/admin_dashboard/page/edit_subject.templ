package page

import "uot-exam/internal/domain"
import "fmt"
import "time"
import "uot-exam/web/templates/pages/admin_dashboard/components"
import "uot-exam/web/templates/components/navbar"
import "uot-exam/web/templates/components/sidebar"
import "uot-exam/web/templates/components/collapsible"
import "uot-exam/web/templates/components/dropdown"
import "uot-exam/web/templates/components/popover"
import "uot-exam/web/templates/components/dialog"
import "uot-exam/web/templates/components/toast"
import "uot-exam/web/templates/components/chart"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/tabs"
import "uot-exam/web/templates/components/input"
import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/button"
import "uot-exam/web/templates/components/label"
import "uot-exam/web/templates/components/textarea"
import "uot-exam/web/templates/utils"
import "uot-exam/web/templates/components/form"
import "uot-exam/web/templates/components/timepicker"
import "github.com/google/uuid"
import "uot-exam/web/templates/components/selectbox"
import "uot-exam/web/templates/components/badge"

type EditSubjectPageParam struct {
	UserID      uuid.UUID
	Username    string
	FullName    string
	Subject     domain.Subject
	Instructors []domain.User
	Exams       []domain.Exam
	AllInstructors []domain.User
	Students    []domain.User
	AllStudents []domain.User
	StudentCount int64
	Analytics    domain.SubjectAnalytics
	Limit       int32
	Offset      int32
}

templ EditSubjectPage(param EditSubjectPageParam) {
	@sidebar.Script()
	@tabs.Script()
	@collapsible.Script()
	@dropdown.Script()
	@popover.Script()
	@dialog.Script()
	@toast.Script()
	@chart.Script()
	@input.Script()
	@textarea.Script()
	@timepicker.Script()
	@selectbox.Script()
	@components.Sidebar("/admin/dashboard/subjects", []navbar.BreadPath{
		{
			Href: "/admin/dashboard",
			Path: "Dashboard",
		},
		{
			Href: "/admin/dashboard/subjects",
			Path: "Subjects",
		},
		{
			Href: "/admin/dashboard/subject/" + param.Subject.ID.String(),
			Path: param.Subject.Title,
		},
	}, param.Username, param.FullName, "/admin/dashboard") {
		<div id="subject-page" data-subject-id={ param.Subject.ID.String() } class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
				<div>
					<div class="flex items-center gap-4">
						<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
							@icon.Bookmark(icon.Props{Class: "h-8 w-8"})
							{ param.Subject.Title }
						</h1>
					</div>
					<p class="text-slate-500 mt-1">Edit subject information</p>
				</div>
				if param.Subject.Status == domain.SubjectStatusPublished {
					<div id="admin-subject-timer" class="flex items-center gap-3 px-4 py-2 rounded-2xl bg-[#F9F8F7] border border-slate-200 shadow-xl shadow-primary/5 transition-all hover:border-primary/30 animate-in fade-in zoom-in duration-500">
						<div class="flex items-center justify-center w-10 h-10 rounded-xl bg-primary/10 text-primary shrink-0">
							@icon.Clock(icon.Props{Class: "h-5 w-5"})
						</div>
						<div class="flex flex-col">
							<span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none mb-1">Time Remaining</span>
							<span id="admin-timer-display" class="text-slate-900 font-mono text-lg font-black tracking-tight leading-none">--:--:--</span>
						</div>
					</div>
				}
			</div>
			@TabsSubject(param)
		</div>
		<div id="toast-container"></div>
		if param.Subject.Status == domain.SubjectStatusPublished {
			<script>
			(function() {
				const subjectPage = document.getElementById('subject-page');
				if (!subjectPage) return;
				const subjectId = subjectPage.dataset.subjectId;
				const timerDisplay = document.getElementById('admin-timer-display');
				let closed = false;

				const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
				const wsUrl = protocol + '//' + window.location.host + '/admin/dashboard/subject/' + subjectId + '/ws';
				let socket = new WebSocket(wsUrl);

				socket.onmessage = function(event) {
					if (closed) return;
					const data = JSON.parse(event.data);
					
					if (data.auto_submit) {
						closed = true;
						if (timerDisplay) timerDisplay.textContent = '00:00:00';
						socket.close();
						return;
					}

					let seconds = data.remaining_seconds;
					if (seconds <= 0) {
						closed = true;
						if (timerDisplay) timerDisplay.textContent = '00:00:00';
						socket.close();
						return;
					}

					let h = Math.floor(seconds / 3600);
					let m = Math.floor((seconds % 3600) / 60);
					let s = seconds % 60;
					
					let timeStr = "";
					// Always show hr for admin dashboard to be clear
					timeStr += h.toString().padStart(2, '0') + ':';
					timeStr += m.toString().padStart(2, '0') + ':' + s.toString().padStart(2, '0');
					
					if (timerDisplay) timerDisplay.textContent = timeStr;
				};

				socket.onclose = function() {
					console.log('Admin timer disconnected');
				};
			})();
			</script>
		}
	}
}

templ TabsSubject(param EditSubjectPageParam) {
	@tabs.Tabs(tabs.Props{
		ID: "account-tabs",
	}) {
		@tabs.List(tabs.ListProps{
			Class: "w-full",
		}) {
			@tabs.Trigger(tabs.TriggerProps{
				Value:    "exams",
				IsActive: true,
				TabsID:   "account-tabs",
				Class:    "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Exams
			}
			@tabs.Trigger(tabs.TriggerProps{
				Value:  "instructors",
				TabsID: "account-tabs",
				Class:  "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Instructors
			}
			@tabs.Trigger(tabs.TriggerProps{
				Value:  "students",
				TabsID: "account-tabs",
				Class:  "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Students
			}
			@tabs.Trigger(tabs.TriggerProps{
				Value:  "analytics",
				TabsID: "account-tabs",
				Class:  "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Analytics
			}
			@tabs.Trigger(tabs.TriggerProps{
				Value:  "information",
				TabsID: "account-tabs",
				Class:  "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Information
			}
		}
		<div class="w-full mt-2">
			@tabs.Content(tabs.ContentProps{
				Value:  "information",
				TabsID: "account-tabs",
			}) {
				@InformationTab(param)
			}
			@tabs.Content(tabs.ContentProps{
				Value:  "exams",
				TabsID: "account-tabs",
			}) {
				@ExamTab(param)
			}
			@tabs.Content(tabs.ContentProps{
				Value:  "students",
				TabsID: "account-tabs",
			}) {
				@SubjectStudentsTab(param)
			}
			@tabs.Content(tabs.ContentProps{
				Value:  "instructors",
				TabsID: "account-tabs",
			}) {
				@InstructorsTab(param)
			}
			@tabs.Content(tabs.ContentProps{
				Value:  "analytics",
				TabsID: "account-tabs",
			}) {
				@SubjectAnalyticsTab(param)
			}
		</div>
	}
}

templ InformationTab(param EditSubjectPageParam) {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Information 
			}
			@card.Description() {
				Make changes to your subject here. Click save when you are done.
			}
		}
		<form
			id="edit_subject_form"
			hx-post={ "/admin/dashboard/subject/edit/" + param.Subject.ID.String() }
			hx-target="#toast-container"
			hx-swap="none"
		>
			@card.Content() {
				@label.Label(label.Props{
					For:   "subject_name",
					Class: "flex items-center gap-2 mb-2 mt-4",
				}) {
					@icon.Pen(icon.Props{
						Class: "h-4 w-4",
					})
					Subject Name
				}
				@input.Input(input.Props{
					Type:        input.TypeText,
					Placeholder: "Subject Name",
					ID:          "subject_name",
					Name:        "subject_name",
					Value:       param.Subject.Title,
					Class:       "mb-4",
					Disabled:    param.Subject.Status == domain.SubjectStatusPublished,
				})
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div class="space-y-2 mb-4">
						@label.Label(label.Props{For: "duration_minutes", Class: "mb-2"}) {
							Duration (HH:MM)
						}
						@timepicker.TimePicker(timepicker.Props{
							ID:          "duration_minutes",
							Name:        "duration_minutes",
							Value:       time.Date(0, 1, 1, int(param.Subject.DurationMinutes/60), int(param.Subject.DurationMinutes%60), 0, 0, time.UTC),
							Use12Hours:  false,
							Placeholder: "Select duration",
							Disabled:    param.Subject.Status == domain.SubjectStatusPublished,
						})
					</div>
					<div class="space-y-2 mb-4">
						@label.Label(label.Props{For: "total_marks", Class: "mb-2"}) {
							Total Marks (auto-computed)
						}
						@input.Input(input.Props{
							Type:        input.TypeNumber,
							ID:          "total_marks",
							Value:       fmt.Sprintf("%.2f", param.Subject.TotalMarks),
							Disabled:    true,
							Attributes:  templ.Attributes{"readonly": "true", "step": "0.1"},
							Class:       "bg-muted text-muted-foreground",
						})
					</div>
					<div class="space-y-2 mb-4">
						@label.Label(label.Props{For: "pass_score", Class: "mb-2"}) {
							Pass Score
						}
						@input.Input(input.Props{
							Type:        input.TypeNumber,
							ID:          "pass_score",
							Name:        "pass_score",
							Value:       fmt.Sprintf("%.2f", param.Subject.PassScore),
							Required:    true,
							Disabled:    param.Subject.Status == domain.SubjectStatusPublished,
							Attributes:  templ.Attributes{"step": "0.1"},
						})
					</div>
					<div class="space-y-2 mb-4">
						@label.Label(label.Props{For: "status", Class: "mb-2"}) {
							Status
						}
						if param.Subject.Status != domain.SubjectStatusPublished {
							@selectbox.SelectBox() {
								@selectbox.Trigger(selectbox.TriggerProps{
									Name: "status",
								}) {
									@selectbox.Value(selectbox.ValueProps{
										Placeholder: "Select the status",
									}) {
										switch param.Subject.Status {
											case domain.SubjectStatusActive:
												@badge.Badge(badge.Props{
													Variant: badge.VariantDefault,
												}) {
													Active
												}
											case domain.SubjectStatusInactive:
												@badge.Badge(badge.Props{
													Variant: badge.VariantDestructive,
												}) {
													Inactive
												}
										}
									}
								}
								@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
									@selectbox.Group() {
										@selectbox.Label() {
											Status
										}
										@selectbox.Item(selectbox.ItemProps{
											Value:    "ACTIVE",
											Selected: param.Subject.Status == domain.SubjectStatusActive,
											Class:    "mb-2 mt-2",
										}) {
											@badge.Badge(badge.Props{
												Variant: badge.VariantDefault,
											}) {
												Active
											}
										}
										@selectbox.Item(selectbox.ItemProps{
											Value:    "INACTIVE",
											Selected: param.Subject.Status == domain.SubjectStatusInactive,
											Class:    "mb-2 mt-2",
										}) {
											@badge.Badge(badge.Props{
												Variant: badge.VariantDestructive,
											}) {
												Inactive
											}
										}
									}
								}
							}
						} else {
							@button.Button(button.Props{
								Type:    "button",
								Variant: button.VariantOutline,
								Class: utils.TwMerge(
									"w-full h-9 px-3 py-1 text-base text-black md:text-sm",
									"flex items-center justify-between",
									"rounded-md border border-input bg-transparent shadow-xs outline-none",
									"opacity-50 cursor-not-allowed pointer-events-none bg-muted focus:ring-0",
								),
								Disabled: true,
							}) {
								<div class="flex items-center block truncate select-value text-black">
									@badge.Badge(badge.Props{
										Variant: badge.VariantDefault,
										Class:   "bg-blue-600 text-black",
									}) {
										Published
									}
								</div>
								<span class="pointer-events-none ml-1">
									@icon.ChevronDown(icon.Props{
										Size:  16,
										Class: "text-black",
									})
								</span>
							}
							<input type="hidden" name="status" value="PUBLISHED" />
						}
					</div>

				</div>
				@label.Label(label.Props{
					For:   "subject_uuid",
					Class: "flex items-center gap-2 mb-2 mt-4",
				}) {
					@icon.Hash(icon.Props{
						Class: "h-4 w-4",
					})
					Subject UUID 
				}
				@input.Input(input.Props{
					Type:     input.TypeText,
					ID:       "subject_uuid",
					Value:    param.Subject.ID.String(),
					Readonly: true,
					Disabled: true,
					Class:    "mb-4",
				})

				@label.Label(label.Props{
					For:   "subject_description",
					Class: "flex items-center gap-2 mb-2 mt-4",
				}) {
					@icon.MessageSquareText(icon.Props{
						Class: "h-4 w-4",
					})
					Subject Description
				}
				@textarea.Textarea(textarea.Props{
					Placeholder: "Subject Description",
					ID:          "subject_description",
					Name:        "subject_description",
					Rows:        3,
					Value:       utils.IfElse(param.Subject.Description != nil, *param.Subject.Description, ""),
					Class:       "mb-4",
					Disabled:    param.Subject.Status == domain.SubjectStatusPublished,
				})
			}
			@card.Footer(card.FooterProps{
				Class: "flex justify-end gap-2",
			}) {
				if param.Subject.Status != domain.SubjectStatusPublished {
					@button.Button(button.Props{
						Type:  button.TypeButton,
						Class: "bg-red-500 hover:bg-red-600",
						Attributes: templ.Attributes{
							"hx-post":   "/admin/dashboard/subject/delete/" + param.Subject.ID.String(),
							"hx-target": "#toast-container",
							"hx-swap":   "none",
						},
					}) {
						Delete Subject
					}
					@button.Button(button.Props{
						Type:  button.TypeButton,
						Class: "bg-green-500 hover:bg-green-600 text-white",
						Attributes: templ.Attributes{
							"hx-post":   "/admin/dashboard/subject/publish/" + param.Subject.ID.String(),
							"hx-target": "#toast-container",
							"hx-swap":   "none",
						},
					}) {
						Publish Subject
					}
					@button.Button(button.Props{
						Type: button.TypeSubmit,
						Form: "edit_subject_form",
					}) {
						Save changes
					}
				}
			}
		</form>
	}
}

templ InstructorsTab(param EditSubjectPageParam) {
	<div class="flex flex-col gap-4">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-2">
			@components.TotalCard(components.TotalCardProps{
				Title:       "Instructors",
				Description: "Instructors for this subject",
				Icon: icon.UserPen(icon.Props{
					Class: "h-8 w-8",
				}),
				Value:      fmt.Sprintf("%d", len(param.Instructors)),
				ColorClass: "bg-purple-50 text-purple-600",
			})
		</div>
		@components.UserTableRoot("instructors-user-table-root", components.UserTableProps{
			Users:     param.Instructors,
			Title:     "Instructors",
			BaseURL:   "/admin/dashboard/subject/" + param.Subject.ID.String() + "/instructors/search",
			ID:        "instructors-table",
			Search:    true,
			SearchAPI: "/admin/dashboard/subject/" + param.Subject.ID.String() + "/instructors/search",
			AddUser:   false,
			AddInstructor: true,
			Instructors: param.AllInstructors,
			AddInstructorAPI: "/admin/dashboard/subject/" + param.Subject.ID.String() + "/instructors/assign",
			InstructorAssignSwapTarget: "#instructors-user-table-root",
			UnassignAPI: "/admin/dashboard/subject/" + param.Subject.ID.String() + "/instructors/unassign/:user_id",
		})
	</div>
}



templ ExamTab(param EditSubjectPageParam) {
	<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
		@components.TotalCard(components.TotalCardProps{
			Title:       "Total Exams",
			Value:       fmt.Sprintf("%d", len(param.Exams)),
			Description: "Published and draft exams",
			Icon:        icon.Book(icon.Props{Class: "h-8 w-8"}),
			ColorClass:  "bg-primary/10 text-primary",
		})
		@components.TotalCard(components.TotalCardProps{
			Title:       "Pass Score",
			Value:       fmt.Sprintf("%.2f / %.2f", param.Subject.PassScore, param.Subject.TotalMarks),
			Description: "Minimum score to pass",
			Icon:        icon.CircleCheck(icon.Props{Class: "h-8 w-8"}),
			ColorClass:  "bg-green-50 text-green-600",
		})
		@components.TotalCard(components.TotalCardProps{
			Title:       "Students",
			Value:       fmt.Sprintf("%d", param.StudentCount),
			Description: "Total enrolled students",
			Icon:        icon.Users(icon.Props{Class: "h-8 w-8"}),
			ColorClass:  "bg-blue-50 text-blue-600",
		})
	</div>

	@card.Card() {
		@card.Header() {
			@card.Title() {
				<div class="flex items-center gap-2">
					@icon.Book(icon.Props{
						Class: "h-8 w-8",
					})
					<span class="text-xl font-bold">Exams</span>
					<div class="flex-1 flex justify-end gap-2">
						<div class="w-64">
							@input.Input(input.Props{
								Type:        input.TypeSearch,
								Name:        "search",
								Placeholder: "Search exams...",
								Attributes: templ.Attributes{
									"hx-post":    "/admin/dashboard/subject/" + param.Subject.ID.String() + "/exams/search",
									"hx-trigger": "keyup changed delay:300ms, search",
									"hx-target":  "#exams-table-container",
									"hx-swap":    "outerHTML",
								},
							})
						</div>
						@DialogAddExam(param)
					</div>
				</div>
			}
		}
		@card.Content() {
			@components.ExamTableGrid(param.Exams)
		}
		@card.Footer(card.FooterProps{
			Class: "flex justify-end gap-2",
		})
	}
}

templ DialogAddExam(param EditSubjectPageParam) {
	@dialog.Dialog(dialog.Props{
		ID: "add-exam-dialog",
	}) {
		@dialog.Trigger() {
			@button.Button(button.Props{
				Variant: button.VariantDefault,
			}) {
				Add Exam
			}
		}
		@dialog.Content(dialog.ContentProps{
			Class: "max-w-md",
		}) {
			@dialog.Header() {
				@dialog.Title() {
					Add Exam
				}
				@dialog.Description() {
					Add a new exam to the platform.
				}
			}
			<form
				id="add-exam-form"
				hx-post="/admin/dashboard/exams/create"
				hx-target="#exams-table-container"
				hx-swap="outerHTML"
			>
				<div class="space-y-4">
					<div class="space-y-2 mb-4">
						@ExamForm(param)
					</div>
				</div>
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
						}) {
							Cancel
						}
					}
					@button.Button(
						button.Props{
							Variant: button.VariantDefault,
							Type:    button.TypeSubmit,
							Form:    "add-exam-form",
						}) {
						Add Exam
					}
				}
			</form>
		}
	}
}

templ ExamForm(param EditSubjectPageParam) {
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
		<div class="space-y-2 mb-4">
			@form.Label(form.LabelProps{For: "title", Class: "block text-sm font-medium mb-2"}) {
				Title
			}
			@input.Input(input.Props{
				ID:          "title",
				Name:        "title",
				Required:    true,
				Placeholder: "Enter exam title",
			})
		</div>
		<div class="space-y-2 mb-4">
			@form.Label(form.LabelProps{For: "subject_id", Class: "block text-sm font-medium mb-2"}) {
				Subject
			}
			@input.Input(input.Props{
				ID:       "subject_id",
				Name:     "subject_id",
				Required: true,
				Value:    param.Subject.ID.String(),
				Readonly: true,
			})
		</div>
		<div class="space-y-2 mb-4">
			@form.Label(form.LabelProps{For: "created_by", Class: "block text-sm font-medium mb-2"}) {
				Created By
			}
			@input.Input(input.Props{
				ID:       "created_by",
				Name:     "created_by",
				Required: true,
				Value:    param.UserID.String(),
				Readonly: true,
			})
		</div>
		<div class="space-y-2 mb-4">
			@form.Label(form.LabelProps{For: "total_marks", Class: "block text-sm font-medium mb-2"}) {
				Total Marks
			}
			@input.Input(input.Props{
				Type:        input.TypeNumber,
				ID:          "total_marks",
				Name:        "total_marks",
				Required:    true,
				Placeholder: "Enter total marks",
				Attributes:  templ.Attributes{
					"min": "0", 
					"step": "0.1",
				},
			})
		</div>

		<div class="space-y-2 mb-4">
			@form.Label(form.LabelProps{For: "status", Class: "block text-sm font-medium mb-2"}) {
				Status
			}
			@selectbox.SelectBox() {
				@selectbox.Trigger(selectbox.TriggerProps{
					Name: "exam_status",
				}) {
					@selectbox.Value(selectbox.ValueProps{
						Placeholder: "Select the status",
					}) {
						@badge.Badge(badge.Props{
							Variant: badge.VariantSecondary,
						}) {
							Draft
						}
					}
				}
				@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
					@selectbox.Group() {
						@selectbox.Label() {
							Status
						}
						@selectbox.Item(selectbox.ItemProps{
							Value:    "DRAFT",
							Selected: true,
						}) {
							@badge.Badge(badge.Props{
								Variant: badge.VariantSecondary,
							}) {
								Draft
							}
						}
						@selectbox.Item(selectbox.ItemProps{
							Value: "PUBLISHED",
						}) {
							@badge.Badge(badge.Props{
								Variant: badge.VariantDefault,
							}) {
								Published
							}
						}
						@selectbox.Item(selectbox.ItemProps{
							Value: "ARCHIVED",
						}) {
							@badge.Badge(badge.Props{
								Variant: badge.VariantDestructive,
							}) {
								Archived
							}
						}
					}
				}
			}
		</div>
		<div class="space-y-2 mb-4 md:col-span-2">
			@form.Label(form.LabelProps{For: "description", Class: "block text-sm font-medium mb-2"}) {
				Description
			}
			@textarea.Textarea(textarea.Props{
				ID:          "description",
				Name:        "description",
				Placeholder: "Enter exam description",
				Rows:        3,
			})
		</div>
	</div>
}

templ SubjectStudentsTab(param EditSubjectPageParam) {
		<div class="flex flex-col gap-4">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-2">
			@components.TotalCard(components.TotalCardProps{
				Title:       "Students",
				Description: "Students for this subject",
				Icon: icon.User(icon.Props{
					Class: "h-8 w-8",
				}),
				Value:      fmt.Sprintf("%d", param.StudentCount),
				ColorClass: "bg-green-50 text-green-600",
			})
		</div>
		@components.UserTableRoot("students-user-table-root", components.UserTableProps{
			Users:     param.Students,
			Title:     "Students",
			BaseURL:   "/admin/dashboard/subject/" + param.Subject.ID.String() + "/students/search",
			ID:        "students-table",
			Search:    true,
			SearchAPI: "/admin/dashboard/subject/" + param.Subject.ID.String() + "/students/search",
			AddUser:   false,
			AddInstructor: false,
			AddStudent: true,
			Students: param.AllStudents,
			AddStudentAPI: "/admin/dashboard/subject/" + param.Subject.ID.String() + "/students/assign",
			StudentAssignSwapTarget: "#students-user-table-root",
			TotalCount: param.StudentCount,
			Limit:      param.Limit,
			Offset:     param.Offset,
			AddStudentCSVAPI: "/admin/dashboard/subject/" + param.Subject.ID.String() + "/students/assign-csv",
			ExportURL:   "/admin/dashboard/subject/" + param.Subject.ID.String() + "/students/export",
			UnassignAPI: "/admin/dashboard/subject/" + param.Subject.ID.String() + "/students/unassign/:user_id",
		})
	</div>

}

templ SubjectAnalyticsTab(param EditSubjectPageParam) {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
		@card.Card() {
			@card.Content(card.ContentProps{Class: "p-6"}) {
				<div class="flex items-center justify-between">
					<div>
						<p class="text-sm font-medium text-slate-500">Average Score</p>
						<h3 class="text-2xl font-bold text-slate-900">{ fmt.Sprintf("%.2f", param.Analytics.AverageScore) }</h3>
					</div>
					<div class="p-3 bg-blue-50 rounded-lg text-blue-600">
						@icon.TrendingUp(icon.Props{Class: "h-8 w-8"})
					</div>
				</div>
			}
		}
		@card.Card() {
			@card.Content(card.ContentProps{Class: "p-6"}) {
				<div class="flex items-center justify-between">
					<div>
						<p class="text-sm font-medium text-slate-500">Pass Rate</p>
						<h3 class="text-2xl font-bold text-slate-900">{ fmt.Sprintf("%.1f%%", param.Analytics.PassRate) }</h3>
					</div>
					<div class="p-3 bg-green-50 rounded-lg text-green-600">
						@icon.CircleCheck(icon.Props{Class: "h-8 w-8"})
					</div>
				</div>
			}
		}
		@card.Card() {
			@card.Content(card.ContentProps{Class: "p-6"}) {
				<div class="flex items-center justify-between">
					<div>
						<p class="text-sm font-medium text-slate-500">Highest Score</p>
						<h3 class="text-2xl font-bold text-slate-900">{ fmt.Sprintf("%.2f", param.Analytics.MaxScore) }</h3>
					</div>
					<div class="p-3 bg-purple-50 rounded-lg text-purple-600">
						@icon.Trophy(icon.Props{Class: "h-8 w-8"})
					</div>
				</div>
			}
		}
		@card.Card() {
			@card.Content(card.ContentProps{Class: "p-6"}) {
				<div class="flex items-center justify-between">
					<div>
						<p class="text-sm font-medium text-slate-500">Total Attempts</p>
						<h3 class="text-2xl font-bold text-slate-900">{ fmt.Sprintf("%d", param.Analytics.TotalAttempts) }</h3>
					</div>
					<div class="p-3 bg-orange-50 rounded-lg text-orange-600">
						@icon.Users(icon.Props{Class: "h-8 w-8"})
					</div>
				</div>
			}
		}
	</div>

	<div class="grid grid-cols-2 gap-6 mb-6">
		@card.Card() {
			@card.Header() {
				@card.Title() { Pass/Fail Distribution }
				@card.Description() { Overview of subject success rate across all exams. }
			}
			@card.Content() {
				<div class="h-[300px]">
					@chart.Chart(chart.Props{
						Variant: chart.VariantPie,
						Data: chart.Data{
							Labels: []string{"Pass", "Fail"},
							Datasets: []chart.Dataset{
								{
									Label: "Distribution",
									Data: []float64{float64(param.Analytics.PassCount), float64(param.Analytics.FailCount)},
									BackgroundColor: []string{"rgba(34, 197, 94, 0.6)", "rgba(239, 68, 68, 0.6)"},
									BorderColor: []string{"rgb(34, 197, 94)", "rgb(239, 68, 68)"},
								},
							},
						},
						ShowLegend: true,
					})
				</div>
			}
		}
		@card.Card() {
			@card.Header() {
				@card.Title() { Score Summary }
				@card.Description() { Comparison of key score metrics across all exams. }
			}
			@card.Content() {
				<div class="h-[300px]">
					@chart.Chart(chart.Props{
						Variant: chart.VariantBar,
						Data: chart.Data{
							Labels: []string{"Min", "Avg", "Max"},
							Datasets: []chart.Dataset{
								{
									Label: "Scores",
									Data: []float64{param.Analytics.MinScore, param.Analytics.AverageScore, param.Analytics.MaxScore},
									BackgroundColor: "rgba(59, 130, 246, 0.6)",
									BorderColor: "rgb(59, 130, 246)",
									BorderWidth: 1,
								},
							},
						},
						ShowXLabels: true,
						ShowYLabels: true,
						BeginAtZero: Ptr(true),
					})
				</div>
			}
		}
	</div>

	@card.Card() {
		@card.Header() {
			@card.Title() { Exam-Level Analysis }
			@card.Description() { Performance breakdown for each exam in this subject. }
		}
		@card.Content(card.ContentProps{Class: "p-0"}) {
			<div class="overflow-x-auto">
				<table class="w-full text-sm text-left">
					<thead class="text-xs text-slate-700 uppercase bg-slate-50">
						<tr>
							<th class="px-6 py-3">Exam Title</th>
							<th class="px-6 py-3 text-center">Total Attempts</th>
							<th class="px-6 py-3 text-center">Pass Rate</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-200">
						for _, stat := range param.Analytics.ExamStats {
							<tr class="bg-white hover:bg-slate-50 transition-colors">
								<td class="px-6 py-4 font-medium text-slate-900">{ stat.Title }</td>
								<td class="px-6 py-4 text-center">{ fmt.Sprintf("%d", stat.TotalAttempts) }</td>
								<td class="px-6 py-4 text-center">
									<div class="flex items-center justify-center gap-2">
										<div class="w-16 bg-slate-200 rounded-full h-1.5 overflow-hidden">
											<div class={ getPassRateColor(stat.PassRate), "h-full" } style={ fmt.Sprintf("width: %.1f%%", stat.PassRate) }></div>
										</div>
										<span class="text-xs font-medium text-slate-600">{ fmt.Sprintf("%.1f%%", stat.PassRate) }</span>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}


func getPassRateColor(rate float64) string {
	if rate >= 75 {
		return "bg-green-500"
	}
	if rate >= 50 {
		return "bg-yellow-500"
	}
	return "bg-red-500"
}
