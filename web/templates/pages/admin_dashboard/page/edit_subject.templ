package page

import "uot-exam/internal/domain"
import "fmt"
import "uot-exam/web/templates/pages/admin_dashboard/components"
import "uot-exam/web/templates/components/navbar"
import "uot-exam/web/templates/components/sidebar"
import "uot-exam/web/templates/components/collapsible"
import "uot-exam/web/templates/components/dropdown"
import "uot-exam/web/templates/components/popover"
import "uot-exam/web/templates/components/dialog"
import "uot-exam/web/templates/components/toast"
import "uot-exam/web/templates/components/chart"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/tabs"
import "uot-exam/web/templates/components/input"
import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/button"
import "uot-exam/web/templates/components/label"
import "uot-exam/web/templates/components/textarea"
import "uot-exam/web/templates/utils"
import "uot-exam/web/templates/components/form"
import "uot-exam/web/templates/components/timepicker"
import "github.com/google/uuid"
import "uot-exam/web/templates/components/selectbox"
import "uot-exam/web/templates/components/badge"

type EditSubjectPageParam struct {
	UserID      uuid.UUID
	Username    string
	FullName    string
	Subject     domain.Subject
	Instructors []domain.User
	Exams       []domain.Exam
}

templ EditSubjectPage(param EditSubjectPageParam) {
	@sidebar.Script()
	@tabs.Script()
	@collapsible.Script()
	@dropdown.Script()
	@popover.Script()
	@dialog.Script()
	@toast.Script()
	@chart.Script()
	@input.Script()
	@textarea.Script()
	@timepicker.Script()
	@selectbox.Script()
	@components.Sidebar("/admin/dashboard/subjects", []navbar.BreadPath{
		{
			Href: "/admin/dashboard",
			Path: "Dashboard",
		},
		{
			Href: "/admin/dashboard/subjects",
			Path: "Subjects",
		},
		{
			Href: "/admin/dashboard/subject/" + param.Subject.ID.String(),
			Path: param.Subject.Title,
		},
	}, param.Username, param.FullName) {
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
				<div>
					<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
						@icon.Bookmark(icon.Props{Class: "h-8 w-8"})
						{ param.Subject.Title }
					</h1>
					<p class="text-slate-500 mt-1">Edit subject information</p>
				</div>
			</div>
			@TabsSubject(param)
		</div>
		<div id="toast-container"></div>
	}
}

templ TabsSubject(param EditSubjectPageParam) {
	@tabs.Tabs(tabs.Props{
		ID: "account-tabs",
	}) {
		@tabs.List(tabs.ListProps{
			Class: "w-full",
		}) {
			@tabs.Trigger(tabs.TriggerProps{
				Value:    "exams",
				IsActive: true,
				TabsID:   "account-tabs",
				Class:    "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Exams
			}
			@tabs.Trigger(tabs.TriggerProps{
				Value:  "instructors",
				TabsID: "account-tabs",
				Class:  "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Instructors
			}
			@tabs.Trigger(tabs.TriggerProps{
				Value:  "students",
				TabsID: "account-tabs",
				Class:  "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Students
			}
			@tabs.Trigger(tabs.TriggerProps{
				Value:  "information",
				TabsID: "account-tabs",
				Class:  "data-[tui-tabs-state=active]:bg-primary data-[tui-tabs-state=active]:text-primary-foreground",
			}) {
				Information
			}
		}
		<div class="w-full mt-2">
			@tabs.Content(tabs.ContentProps{
				Value:  "information",
				TabsID: "account-tabs",
			}) {
				@InformationTab(param)
			}
			@tabs.Content(tabs.ContentProps{
				Value:  "exams",
				TabsID: "account-tabs",
			}) {
				@ExamTab(param)
			}
			@tabs.Content(tabs.ContentProps{
				Value:  "students",
				TabsID: "account-tabs",
			}) {
				@StudentsTab(param)
			}
			@tabs.Content(tabs.ContentProps{
				Value:  "instructors",
				TabsID: "account-tabs",
			}) {
				@InstructorsTab(param)
			}
		</div>
	}
}

templ InformationTab(param EditSubjectPageParam) {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Information 
			}
			@card.Description() {
				Make changes to your subject here. Click save when you are done.
			}
		}
		<form
			id="edit_subject_form"
			hx-post={ "/admin/dashboard/subject/edit/" + param.Subject.ID.String() }
			hx-target="#toast-container"
			hx-swap="none"
		>
			@card.Content() {
				@label.Label(label.Props{
					For:   "subject_name",
					Class: "flex items-center gap-2 mb-2 mt-4",
				}) {
					@icon.Pen(icon.Props{
						Class: "h-4 w-4",
					})
					Subject Name
				}
				@input.Input(input.Props{
					Type:        input.TypeText,
					Placeholder: "Subject Name",
					ID:          "subject_name",
					Name:        "subject_name",
					Value:       param.Subject.Title,
					Class:       "mb-4",
				})
				@label.Label(label.Props{
					For:   "subject_description",
					Class: "flex items-center gap-2 mb-2 mt-4",
				}) {
					@icon.MessageSquareText(icon.Props{
						Class: "h-4 w-4",
					})
					Subject Description
				}
				@textarea.Textarea(textarea.Props{
					Placeholder: "Subject Description",
					ID:          "subject_description",
					Name:        "subject_description",
					Rows:        3,
					Value:       utils.IfElse(param.Subject.Description != nil, *param.Subject.Description, ""),
					Class:       "mb-4",
				})
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div class="space-y-2 mb-4">
						@label.Label(label.Props{For: "duration_minutes", Class: "mb-2"}) {
							Duration (Minutes)
						}
						@input.Input(input.Props{
							Type:        input.TypeNumber,
							ID:          "duration_minutes",
							Name:        "duration_minutes",
							Value:       fmt.Sprintf("%d", param.Subject.DurationMinutes),
							Required:    true,
						})
					</div>
					<div class="space-y-2 mb-4">
						@label.Label(label.Props{For: "total_marks", Class: "mb-2"}) {
							Total Marks (auto-computed)
						}
						@input.Input(input.Props{
							Type:        input.TypeNumber,
							ID:          "total_marks",
							Value:       fmt.Sprintf("%d", param.Subject.TotalMarks),
							Disabled:    true,
							Attributes:  templ.Attributes{"readonly": "true"},
							Class:       "bg-muted text-muted-foreground",
						})
					</div>
					<div class="space-y-2 mb-4">
						@label.Label(label.Props{For: "pass_score", Class: "mb-2"}) {
							Pass Score
						}
						@input.Input(input.Props{
							Type:        input.TypeNumber,
							ID:          "pass_score",
							Name:        "pass_score",
							Value:       fmt.Sprintf("%d", param.Subject.PassScore),
							Required:    true,
						})
					</div>
					<div class="space-y-2 mb-4">
						@label.Label(label.Props{For: "status", Class: "mb-2"}) {
							Status
						}
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{
								Name: "status",
							}) {
								@selectbox.Value(selectbox.ValueProps{
									Placeholder: "Select the status",
								}) {
									switch param.Subject.Status {
										case domain.SubjectStatusActive:
											@badge.Badge(badge.Props{
												Variant: badge.VariantDefault,
											}) {
												Active
											}
										case domain.SubjectStatusInactive:
											@badge.Badge(badge.Props{
												Variant: badge.VariantDestructive,
											}) {
												Inactive
											}
									}
								}
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								@selectbox.Group() {
									@selectbox.Label() {
										Status
									}
									@selectbox.Item(selectbox.ItemProps{
										Value:    "ACTIVE",
										Selected: param.Subject.Status == domain.SubjectStatusActive,
										Class:    "mb-2 mt-2",
									}) {
										@badge.Badge(badge.Props{
											Variant: badge.VariantDefault,
										}) {
											Active
										}
									}
									@selectbox.Item(selectbox.ItemProps{
										Value:    "INACTIVE",
										Selected: param.Subject.Status == domain.SubjectStatusInactive,
										Class:    "mb-2 mt-2",
									}) {
										@badge.Badge(badge.Props{
											Variant: badge.VariantDestructive,
										}) {
											Inactive
										}
									}
								}
							}
						}
					</div>

				</div>
				@label.Label(label.Props{
					For:   "subject_uuid",
					Class: "flex items-center gap-2 mb-2 mt-4",
				}) {
					@icon.Hash(icon.Props{
						Class: "h-4 w-4",
					})
					Subject UUID 
				}
				@input.Input(input.Props{
					Type:     input.TypeText,
					ID:       "subject_uuid",
					Value:    param.Subject.ID.String(),
					Readonly: true,
					Disabled: true,
					Class:    "mb-4",
				})
			}
			@card.Footer(card.FooterProps{
				Class: "flex justify-end gap-2",
			}) {
				@button.Button(button.Props{
					Type:  button.TypeButton,
					Class: "bg-red-500 hover:bg-red-600",
					Attributes: templ.Attributes{
						"hx-post":   "/admin/dashboard/subject/delete/" + param.Subject.ID.String(),
						"hx-target": "#toast-container",
						"hx-swap":   "none",
					},
				}) {
					Delete Subject
				}
				@button.Button(button.Props{
					Type: button.TypeSubmit,
					Form: "edit_subject_form",
				}) {
					Save changes
				}
			}
		</form>
	}
}

templ InstructorsTab(param EditSubjectPageParam) {
	<div class="flex flex-col gap-4">
		@components.TotalCard(components.TotalCardProps{
			Title:       "Instructors",
			Description: "Instructors for this subject",
			Icon: icon.User(icon.Props{
				Class: "h-6 w-6",
			}),
			Value: "10",
		})
		@components.UserTable(components.UserTableProps{
			Users:     param.Instructors,
			Title:     "Instructors",
			BaseURL:   "/admin/dashboard/subject/" + param.Subject.ID.String() + "/instructors",
			ID:        "instructors-table",
			Search:    true,
			SearchAPI: "/admin/dashboard/subject/" + param.Subject.ID.String() + "/instructors/search",
			AddUser:   true,
			AddAPI:    "/admin/dashboard/subject/" + param.Subject.ID.String() + "/instructors/add",
		})
	</div>
}

templ ExamPassChart(title string, description string) {
	@card.Card(card.Props{Class: "w-full"}) {
		@card.Header() {
			@card.Title() {
				{ title }
			}
			@card.Description() {
				{ description }
			}
		}
		@card.Content() {
			@chart.Chart(chart.Props{
				Variant: chart.VariantDoughnut,
				Data: chart.Data{
					Labels: []string{"Pass", "Fail"},
					Datasets: []chart.Dataset{
						{
							Label:           "Students",
							Data:            []float64{85, 15},
							BackgroundColor: []string{"#10b981", "#ef4444"},
						},
					},
				},
				Options: chart.Options{
					Responsive: true,
					Legend:     true,
				},
			})
		}
	}
}

templ AttendanceRateChart(title string, description string) {
	@card.Card(card.Props{Class: "w-full"}) {
		@card.Header() {
			@card.Title() {
				{ title }
			}
			@card.Description() {
				{ description }
			}
		}
		@card.Content() {
			@chart.Chart(chart.Props{
				Variant:     chart.VariantLine,
				ShowYGrid:   true,
				ShowXLabels: true,
				Data: chart.Data{
					Labels: []string{"TOC-2026-1", "TOC-2026-2", "TOC-2026-3", "TOC-2026-4", "TOC-2026-5", "TOC-2026-6"},
					Datasets: []chart.Dataset{
						{
							Data:        []float64{3, 9, 3, 12, 7, 8},
							BorderWidth: 1,
							Fill:        true,
						},
						{
							Data:        []float64{10, 12, 13, 12, 17, 18},
							BorderWidth: 1,
							Fill:        true,
						},
					},
				},
			})
		}
	}
}

templ ExamPassRateChart(title string, description string) {
	{{
		passRates := []float64{90, 80, 40, 60, 30}
		var colors []string
		for _, val := range passRates {
			if val <= 50.0 {
				colors = append(colors, "#ef4444")
			} else {
				colors = append(colors, "#67b5e1")
			}
		}
	}}
	@card.Card(card.Props{Class: "w-full"}) {
		@card.Header() {
			@card.Title() {
				{ title }
			}
			@card.Description() {
				{ description }
			}
		}
		@card.Content() {
			@chart.Chart(chart.Props{
				Variant:     chart.VariantBar,
				Horizontal:  true,
				ShowXGrid:   false,
				ShowYLabels: true,
				Data: chart.Data{
					Labels: []string{"TOC-2026-1", "TOC-2026-2", "TOC-2026-3", "TOC-2026-4", "TOC-2026-5"},
					Datasets: []chart.Dataset{
						{
							Label:           "Pass Rate",
							Data:            passRates,
							BackgroundColor: colors,
						},
					},
				},
			})
		}
	}
}

templ ExamTab(param EditSubjectPageParam) {
	<div class="flex gap-4">
		<div class="w-full mb-4">
			@components.TotalCard(components.TotalCardProps{
				Title:       "Total Exams",
				Value:       "0",
				Description: "Total exams in this subject",
				Icon:        icon.Book(icon.Props{Class: "h-10 w-10"}),
			})
		</div>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-2 w-full mb-4 gap-4">
		@ExamPassRateChart("Pass Rate", "Past Exams Pass Rate")
		@AttendanceRateChart("Attendance Rate", "Past Exams Attendance Rate")
	</div>
	@card.Card() {
		@card.Header() {
			@card.Title() {
				<div class="flex items-center gap-2">
					@icon.Book(icon.Props{
						Class: "h-6 w-6",
					})
					<span class="text-xl font-bold">Exams</span>
					<div class="flex-1 flex justify-end gap-2">
						<div class="w-64">
							@input.Input(input.Props{
								Type:        input.TypeSearch,
								Name:        "search",
								Placeholder: "Search exams...",
								Attributes: templ.Attributes{
									"hx-post":    "/admin/dashboard/subject/" + param.Subject.ID.String() + "/exams/search",
									"hx-trigger": "keyup changed delay:300ms, search",
									"hx-target":  "#exams-table-container",
									"hx-swap":    "outerHTML",
								},
							})
						</div>
						@DialogAddExam(param)
					</div>
				</div>
			}
		}
		@card.Content() {
			@components.ExamTableGrid(param.Exams)
		}
		@card.Footer(card.FooterProps{
			Class: "flex justify-end gap-2",
		})
	}
}

templ DialogAddExam(param EditSubjectPageParam) {
	@dialog.Dialog(dialog.Props{
		ID: "add-exam-dialog",
	}) {
		@dialog.Trigger() {
			@button.Button(button.Props{
				Variant: button.VariantDefault,
			}) {
				Add Exam
			}
		}
		@dialog.Content(dialog.ContentProps{
			Class: "max-w-md",
		}) {
			@dialog.Header() {
				@dialog.Title() {
					Add Exam
				}
				@dialog.Description() {
					Add a new exam to the platform.
				}
			}
			<form
				id="add-exam-form"
				hx-post="/admin/dashboard/exams/create"
				hx-target="#exams-table-container"
				hx-swap="outerHTML"
			>
				<div class="space-y-4">
					<div class="space-y-2 mb-4">
						@ExamForm(param)
					</div>
				</div>
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
						}) {
							Cancel
						}
					}
					@button.Button(
						button.Props{
							Variant: button.VariantDefault,
							Type:    button.TypeSubmit,
							Form:    "add-exam-form",
						}) {
						Add Exam
					}
				}
			</form>
		}
	}
}

templ ExamForm(param EditSubjectPageParam) {
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
		<div class="space-y-2 mb-4">
			@form.Label(form.LabelProps{For: "title", Class: "block text-sm font-medium mb-2"}) {
				Title
			}
			@input.Input(input.Props{
				ID:          "title",
				Name:        "title",
				Required:    true,
				Placeholder: "Enter exam title",
			})
		</div>
		<div class="space-y-2 mb-4">
			@form.Label(form.LabelProps{For: "subject_id", Class: "block text-sm font-medium mb-2"}) {
				Subject
			}
			@input.Input(input.Props{
				ID:       "subject_id",
				Name:     "subject_id",
				Required: true,
				Value:    param.Subject.ID.String(),
				Readonly: true,
			})
		</div>
		<div class="space-y-2 mb-4">
			@form.Label(form.LabelProps{For: "created_by", Class: "block text-sm font-medium mb-2"}) {
				Created By
			}
			@input.Input(input.Props{
				ID:       "created_by",
				Name:     "created_by",
				Required: true,
				Value:    param.UserID.String(),
				Readonly: true,
			})
		</div>
		<div class="space-y-2 mb-4">
			@form.Label(form.LabelProps{For: "total_marks", Class: "block text-sm font-medium mb-2"}) {
				Total Marks
			}
			@input.Input(input.Props{
				Type:        input.TypeNumber,
				ID:          "total_marks",
				Name:        "total_marks",
				Required:    true,
				Placeholder: "Enter total marks",
				Attributes:  templ.Attributes{"min": "0"},
			})
		</div>

		<div class="space-y-2 mb-4">
			@form.Label(form.LabelProps{For: "status", Class: "block text-sm font-medium mb-2"}) {
				Status
			}
			@selectbox.SelectBox() {
				@selectbox.Trigger(selectbox.TriggerProps{
					Name: "exam_status",
				}) {
					@selectbox.Value(selectbox.ValueProps{
						Placeholder: "Select the status",
					}) {
						@badge.Badge(badge.Props{
							Variant: badge.VariantSecondary,
						}) {
							Draft
						}
					}
				}
				@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
					@selectbox.Group() {
						@selectbox.Label() {
							Status
						}
						@selectbox.Item(selectbox.ItemProps{
							Value:    "DRAFT",
							Selected: true,
						}) {
							@badge.Badge(badge.Props{
								Variant: badge.VariantSecondary,
							}) {
								Draft
							}
						}
						@selectbox.Item(selectbox.ItemProps{
							Value: "PUBLISHED",
						}) {
							@badge.Badge(badge.Props{
								Variant: badge.VariantDefault,
							}) {
								Published
							}
						}
						@selectbox.Item(selectbox.ItemProps{
							Value: "ARCHIVED",
						}) {
							@badge.Badge(badge.Props{
								Variant: badge.VariantDestructive,
							}) {
								Archived
							}
						}
					}
				}
			}
		</div>
		<div class="space-y-2 mb-4 md:col-span-2">
			@form.Label(form.LabelProps{For: "description", Class: "block text-sm font-medium mb-2"}) {
				Description
			}
			@textarea.Textarea(textarea.Props{
				ID:          "description",
				Name:        "description",
				Placeholder: "Enter exam description",
				Rows:        3,
			})
		</div>
	</div>
}

templ StudentsTab(param EditSubjectPageParam) {

}
