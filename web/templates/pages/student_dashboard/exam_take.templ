package student_dashboard

import "fmt"
import "strconv"
import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/button"
import "uot-exam/web/templates/components/toast"
import "uot-exam/web/templates/components/badge"
import "uot-exam/web/templates/components/label"
import "uot-exam/web/templates/components/aspectratio"
import "uot-exam/web/templates/components/dialog"
import "uot-exam/internal/domain"
import "github.com/google/uuid"

templ ExamTakePage(param ExamTakeParam) {
	@toast.Script()
	@dialog.Script()

	<!-- KaTeX CSS (local) -->
	<link rel="stylesheet" href="/src/katex/katex.min.css" />

	<!-- KaTeX JS (local) -->
	<script defer src="/src/katex/katex.min.js"></script>

	<!-- KaTeX Auto-render Extension (local) -->
	<script defer src="/src/katex/contrib/auto-render.min.js"
			onload="renderMathInElement(document.body, {
				delimiters: [
					{left: '$$', right: '$$', display: true},
					{left: '$', right: '$', display: false},
					{left: '\\[', right: '\\]', display: true},
					{left: '\\(', right: '\\)', display: false}
				],
				throwOnError: false
			});"></script>

	<!-- Highlight.js CSS (GitHub Dark theme, local) -->
	<link rel="stylesheet" href="/src/highlight/styles/github-dark.min.css"/>

	<!-- Highlight.js JavaScript (local) -->
	<script src="/src/highlight/highlight.min.js"></script>

	<div class="min-h-screen" id="exam-page" 
		data-exam-id={ param.Exam.ID.String() }
		data-subject-id={ param.Subject.ID.String() }
		data-duration={ strconv.Itoa(int(param.Subject.DurationMinutes)) }>
		
		<!-- Sticky Header with Timer -->
		<header class="sticky top-0 z-50 border-b bg-slate-50 shadow-sm">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between">
				<div class="flex items-center gap-3">
					@icon.FileText(icon.Props{Class: "h-5 w-5 text-primary"})
					<div>
						<h1 class="text-lg font-bold text-slate-900">{ param.Exam.Title }</h1>
						<p class="text-xs text-slate-500">{ param.Subject.Title }</p>
					</div>
				</div>
				<div class="flex items-center gap-4">
					<!-- Timer -->
					<div id="exam-timer" class="flex items-center gap-2 px-4 py-2 rounded-lg bg-primary/5 border border-primary/10 text-primary transition-all duration-300">
						@icon.Clock(icon.Props{Class: "h-4 w-4"})
						<span id="timer-display" class="font-mono text-sm font-bold tracking-tight">--:--:--</span>
					</div>
					<!-- Submit Button -->
					@dialog.Trigger(dialog.TriggerProps{For: "submit-exam-dialog"}) {
						@button.Button(button.Props{
							Variant: button.VariantDefault,
							Class: "flex items-center gap-2",
							Attributes: templ.Attributes{
								"id": "submit-exam-btn",
							},
						}) {
							@icon.Send(icon.Props{Class: "h-4 w-4"})
							Submit Exam
						}
					}
				</div>
			</div>
			<!-- Progress bar -->
			<div class="h-1 bg-slate-100">
				<div id="progress-bar" class="h-full bg-primary transition-all duration-300" style="width: 0%"></div>
			</div>
			<!-- Question Navigation Indicator -->
			<div class="bg-white border-b shadow-sm overflow-x-auto py-2 px-4 text-center">
				<div class="inline-flex items-center gap-2">
					for qIndex, question := range param.Questions {
						<a href={ templ.SafeURL("#question-" + question.ID.String()) }
							id={ "nav-indicator-" + question.ID.String() }
							class={
								"flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-md text-sm font-medium transition-colors border shadow-sm",
								templ.KV("bg-primary text-white border-primary", isAnswered(param.AnsweredChoices, question.ID)),
								templ.KV("bg-slate-50 text-slate-500 border-slate-200 hover:bg-slate-100", !isAnswered(param.AnsweredChoices, question.ID)),
							}>
							{ fmt.Sprint(qIndex + 1) }
						</a>
					}
				</div>
			</div>
		</header>

		<!-- Questions -->
		<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
			<div class="space-y-6" id="question-list">
				for qIndex, question := range param.Questions {
					<div class="animate-in fade-in slide-in-from-bottom-4 duration-500"
						style={ fmt.Sprintf("animation-delay: %dms", (qIndex+1)*80) }
						id={ "question-" + question.ID.String() }>
						switch question.QuestionType {
							case string(domain.QuestionTypeText):
								@ExamQuestionItem(question, question.Choices, qIndex+1, param)
							case string(domain.QuestionTypeCode):
								@ExamQuestionCodeItem(question, question.Choices, qIndex+1, param)
							case string(domain.QuestionTypeImage):
								@ExamImageQuestionItem(question, question.Choices, qIndex+1, param)
						}
					</div>
				}
			</div>

			<!-- Bottom submit button -->
			<div class="mt-8 flex justify-center pb-8">
				@dialog.Trigger(dialog.TriggerProps{For: "submit-exam-dialog"}) {
					@button.Button(button.Props{
						Variant: button.VariantDefault,
						Class: "flex items-center gap-2 px-8 py-3",
					}) {
						@icon.Send(icon.Props{Class: "h-4 w-4"})
						Submit Exam
					}
				}
			</div>
		</main>
	</div>
	<div id="toast-container"></div>
	
	@dialog.Dialog(dialog.Props{ID: "submit-exam-dialog"}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() { Submit Exam }
				@dialog.Description() { Are you sure you want to submit this exam? You cannot change your answers after submission. If you submit, you will be automatically redirected to the subject page when other exams are available, or the results page if all are completed. }
			}
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						Close
					}
				}
				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Attributes: templ.Attributes{
						"hx-post": fmt.Sprintf("/student/exam/%s/submit", param.Exam.ID.String()),
						"hx-swap": "none",
					},
				}) {
					Submit
				}
			}
		}
	}

	<!-- Highlight.js init + Timer & Auto-submit Script -->
	<script>
	(function() {
		// Highlight all code blocks on page load
		if (typeof hljs !== 'undefined') {
			hljs.highlightAll();
		}

		const examPage = document.getElementById('exam-page');
		const examId = examPage.dataset.examId;
		const subjectId = examPage.dataset.subjectId;
		const durationMinutes = parseInt(examPage.dataset.duration);
		const timerDisplay = document.getElementById('timer-display');
		const timerContainer = document.getElementById('exam-timer');
		const progressBar = document.getElementById('progress-bar');
		
		let warningShown5 = false;
		let warningShown1 = false;
		let submitted = false;

		const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
		const wsUrl = protocol + '//' + window.location.host + '/student/subject/' + subjectId + '/ws';
		let socket = new WebSocket(wsUrl);

		function showToast(title, description, variant) {
			const container = document.getElementById('toast-container');
			if (!container) return;
			const colors = {
				warning: 'border-yellow-400 bg-yellow-50',
				error: 'border-red-400 bg-red-50'
			};
			const toast = document.createElement('div');
			toast.className = 'fixed top-4 right-4 z-[100] p-4 rounded-lg border shadow-lg ' + (colors[variant] || 'border-slate-200 bg-white');
			toast.innerHTML = '<div class="font-semibold text-sm">' + title + '</div><div class="text-sm mt-1">' + description + '</div>';
			document.body.appendChild(toast);
			setTimeout(() => toast.remove(), 5000);
		}

		socket.onmessage = function(event) {
			if (submitted) return;
			const data = JSON.parse(event.data);
			
			if (data.auto_submit) {
				submitted = true;
				timerDisplay.textContent = '00:00:00';
				socket.close();
				
				showToast('Exam Auto-Submitted', 'Time is up. Your exam has been automatically submitted.', 'warning');
				
				setTimeout(function() {
					window.location.href = '/student/subject/' + subjectId;
				}, 2000);
				return;
			}

			const totalSeconds = data.remaining_seconds;
			if (totalSeconds < 0) return;

			const hours = Math.floor(totalSeconds / 3600);
			const minutes = Math.floor((totalSeconds % 3600) / 60);
			const seconds = totalSeconds % 60;

			timerDisplay.textContent = String(hours).padStart(2, '0') + ':' + String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');

			// Progress bar
			const totalDuration = durationMinutes * 60;
			const elapsed = Math.max(0, totalDuration - totalSeconds);
			const pct = Math.min(100, (elapsed / totalDuration) * 100);
			progressBar.style.width = pct + '%';

			// Color coding
			if (totalSeconds <= 60) {
				timerContainer.className = timerContainer.className.replace(/bg-\S+/g, '').trim();
				timerContainer.classList.add('bg-red-100', 'text-red-700');
				progressBar.classList.remove('bg-primary', 'bg-yellow-500');
				progressBar.classList.add('bg-red-500');
			} else if (totalSeconds <= 300) {
				timerContainer.className = timerContainer.className.replace(/bg-\S+/g, '').trim();
				timerContainer.classList.add('bg-yellow-100', 'text-yellow-800');
				progressBar.classList.remove('bg-primary', 'bg-red-500');
				progressBar.classList.add('bg-yellow-500');
			}

			// Warnings
			if (totalSeconds <= 300 && totalSeconds > 295 && !warningShown5) {
				warningShown5 = true;
				showToast('Warning', '5 minutes remaining!', 'warning');
			}
			if (totalSeconds <= 60 && totalSeconds > 55 && !warningShown1) {
				warningShown1 = true;
				showToast('Warning', '1 minute remaining! Your exam will be auto-submitted.', 'error');
			}
		};

		socket.onerror = function(error) {
			console.error('Timer connection error');
		};

		// Update answered indicators on htmx:afterRequest
		document.body.addEventListener('htmx:afterRequest', function(event) {
			if (event.detail.successful && event.detail.requestConfig) {
				const body = event.detail.requestConfig.parameters;
				if (body && body.question_id) {
					const indicator = document.getElementById('answered-indicator-' + body.question_id);
					if (indicator) {
						indicator.classList.remove('bg-slate-200');
						indicator.classList.add('bg-primary');
					}
					const navIndicator = document.getElementById('nav-indicator-' + body.question_id);
					if (navIndicator) {
						navIndicator.classList.remove('bg-slate-50', 'text-slate-500', 'border-slate-200', 'hover:bg-slate-100');
						navIndicator.classList.add('bg-primary', 'text-white', 'border-primary');
					}
					updateAnsweredCount();
				}
			}
		});

		function updateAnsweredCount() {
			const cards = document.querySelectorAll('.question-card');
			let answered = 0;
			cards.forEach(function(card) {
				const checked = card.querySelector('input[type="radio"]:checked');
				if (checked) answered++;
			});
		}
	})();
	</script>
}

// Text question card (same style as admin QuestionItem)
templ ExamQuestionItem(question domain.Question, choices []domain.Choice, number int, param ExamTakeParam) {
	@card.Card(card.Props{
		Class: "question-card mb-6",
	}) {
		@card.Header() {
			<div class="flex items-center justify-between gap-3 w-full">
				@card.Title() {
					<span class="font-bold">Q.{ fmt.Sprint(number) }. </span>
					<span class="latex-content">{ question.QuestionTitle }</span>
				}
				<div class="flex items-center gap-2">
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-auto"}) {
						{ fmt.Sprintf("%.2f", question.Marks) } Marks
					}
					<span id={ "answered-indicator-" + question.ID.String() }
						class={ "h-2 w-2 rounded-full transition-colors", templ.KV("bg-primary", isAnswered(param.AnsweredChoices, question.ID)), templ.KV("bg-slate-200", !isAnswered(param.AnsweredChoices, question.ID)) }>
					</span>
				</div>
			</div>
		}
		@card.Content() {
			<span class="latex-content">{ question.QuestionText }</span>
		}
		@card.Footer() {
			<div class="grid grid-cols-2 gap-3 w-full">
				for i, choice := range choices {
					@ExamChoiceItem(choice, question, number, fmt.Sprintf("%c", 'A'+i), param)
				}
			</div>
		}
	}
}

// Code question card (same style as admin QuestionCodeItem)
templ ExamQuestionCodeItem(question domain.Question, choices []domain.Choice, number int, param ExamTakeParam) {
	@card.Card(card.Props{
		Class: "question-card mb-6",
	}) {
		@card.Header() {
			<div class="flex items-center justify-between gap-3 w-full">
				@card.Title() {
					<span class="font-bold">Q.{ fmt.Sprint(number) }. </span>
					<span class="latex-content">{ question.QuestionTitle }</span>
				}
				<div class="flex items-center gap-2">
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-auto"}) {
						{ fmt.Sprintf("%.2f", question.Marks) } Marks
					}
					<span id={ "answered-indicator-" + question.ID.String() }
						class={ "h-2 w-2 rounded-full transition-colors", templ.KV("bg-primary", isAnswered(param.AnsweredChoices, question.ID)), templ.KV("bg-slate-200", !isAnswered(param.AnsweredChoices, question.ID)) }>
					</span>
				</div>
			</div>
		}
		@card.Content() {
			<div class="w-full rounded-md overflow-x-auto">
				<pre><code class="language-rust">{ question.QuestionText }</code></pre>
			</div>
		}
		@card.Footer() {
			<div class="grid grid-cols-2 gap-3 w-full">
				for i, choice := range choices {
					@ExamChoiceItem(choice, question, number, fmt.Sprintf("%c", 'A'+i), param)
				}
			</div>
		}
	}
}

// Image question card (same style as admin ImageQuestionItem)
templ ExamImageQuestionItem(question domain.Question, choices []domain.Choice, number int, param ExamTakeParam) {
	@card.Card(card.Props{
		Class: "question-card mb-6",
	}) {
		@card.Header() {
			<div class="flex items-center justify-between gap-3 w-full">
				@card.Title() {
					<span class="font-bold">Q.{ fmt.Sprint(number) }. </span>
					<span class="latex-content">{ question.QuestionTitle }</span>
				}
				<div class="flex items-center gap-2">
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-auto"}) {
						{ fmt.Sprintf("%.2f", question.Marks) } Marks
					}
					<span id={ "answered-indicator-" + question.ID.String() }
						class={ "h-2 w-2 rounded-full transition-colors", templ.KV("bg-primary", isAnswered(param.AnsweredChoices, question.ID)), templ.KV("bg-slate-200", !isAnswered(param.AnsweredChoices, question.ID)) }>
					</span>
				</div>
			</div>
		}
		@card.Content() {
			<div class="w-full rounded-md overflow-x-auto">
				<span class="latex-content">{ question.QuestionText }</span>
				@aspectratio.AspectRatio(aspectratio.Props{
					Ratio: aspectratio.RatioWide,
					Class: "rounded-md overflow-hidden",
				}) {
					<img
						src={ question.QuestionImage }
						alt="Question Image"
						class="h-full w-full object-cover"
					/>
				}
			</div>
		}
		@card.Footer() {
			<div class="grid grid-cols-2 gap-3 w-full">
				for i, choice := range choices {
					@ExamChoiceItem(choice, question, number, fmt.Sprintf("%c", 'A'+i), param)
				}
			</div>
		}
	}
}

// Choice item for exam taking - styled like admin ChoiceItem but with htmx answer submission
templ ExamChoiceItem(choice domain.Choice, question domain.Question, qIndex int, cIndex string, param ExamTakeParam) {
	@label.Label(label.Props{
		For:   fmt.Sprintf("q%d-option-%s", qIndex, cIndex),
		Class: "block cursor-pointer h-full",
	}) {
		@card.Card(card.Props{
			Class: "hover:border-primary/50 has-[:checked]:ring-1 has-[:checked]:ring-primary has-[:checked]:border-primary transition-all h-full",
		}) {
			@card.Content(card.ContentProps{
				Class: "p-3 flex items-center gap-3 h-full",
			}) {
				<input type="radio"
					id={ fmt.Sprintf("q%d-option-%s", qIndex, cIndex) }
					name={ fmt.Sprintf("question-%s", question.ID.String()) }
					value={ choice.ID.String() }
					class="peer hidden"
					checked?={ isSelected(param.AnsweredChoices, question.ID, choice.ID) }
					hx-post={ fmt.Sprintf("/student/exam/%s/answer", param.Exam.ID.String()) }
					hx-vals={ fmt.Sprintf(`{"question_id": "%s", "choice_id": "%s"}`, question.ID.String(), choice.ID.String()) }
					hx-swap="none"
					hx-trigger="change"
				/>
				<div class="transition-all w-8 h-8 flex items-center justify-center rounded-sm shrink-0 bg-muted text-muted-foreground peer-checked:bg-primary peer-checked:text-white">
					<span>{ cIndex }</span>
				</div>
				<div class="flex-1">
					<p class="text-md leading-tight font-medium">
						{ choice.ChoiceText }
					</p>
				</div>
			}
		}
	}
}

func isAnswered(answeredChoices map[uuid.UUID]uuid.UUID, questionID uuid.UUID) bool {
	_, ok := answeredChoices[questionID]
	return ok
}

func isSelected(answeredChoices map[uuid.UUID]uuid.UUID, questionID uuid.UUID, choiceID uuid.UUID) bool {
	selected, ok := answeredChoices[questionID]
	return ok && selected == choiceID
}
