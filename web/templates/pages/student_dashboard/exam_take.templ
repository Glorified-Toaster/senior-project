package student_dashboard

import "fmt"
import "strconv"
import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/button"
import "uot-exam/web/templates/components/toast"
import "uot-exam/web/templates/components/badge"
import "uot-exam/web/templates/components/label"
import "uot-exam/web/templates/components/aspectratio"
import "uot-exam/web/templates/components/dialog"
import "uot-exam/internal/domain"
import "github.com/google/uuid"

templ ExamTakePage(param ExamTakeParam) {
	@toast.Script()
	@dialog.Script()

	<!-- KaTeX CSS (local) -->
	<link rel="stylesheet" href="/src/katex/katex.min.css" />

	<!-- KaTeX JS (local) -->
	<script defer src="/src/katex/katex.min.js"></script>

	<!-- KaTeX Auto-render Extension (local) -->
	<script defer src="/src/katex/contrib/auto-render.min.js"
			onload="renderMathInElement(document.body, {
				delimiters: [
					{left: '$$', right: '$$', display: true},
					{left: '$', right: '$', display: false},
					{left: '\\[', right: '\\]', display: true},
					{left: '\\(', right: '\\)', display: false}
				],
				throwOnError: false
			});"></script>

	<!-- Highlight.js CSS (GitHub Dark theme, local) -->
	<link rel="stylesheet" href="/src/highlight/styles/github-dark.min.css"/>

	<!-- Highlight.js JavaScript (local) -->
	<script src="/src/highlight/highlight.min.js"></script>

	<div class="min-h-screen" id="exam-page" 
		data-exam-id={ param.Exam.ID.String() }
		data-subject-id={ param.Subject.ID.String() }
		data-duration={ strconv.Itoa(int(param.Subject.DurationMinutes)) }>
		
		<!-- Sticky Header with Timer -->
		<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur-md shadow-sm w-full">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between w-full">
				<div class="flex items-center gap-4">
					<a href={ templ.URL(fmt.Sprintf("/student/subject/%s", param.Subject.ID.String())) } class="p-2 rounded-full hover:bg-slate-100 text-slate-500 transition-colors" title="Back to Subject">
						@icon.ArrowLeft(icon.Props{Class: "h-5 w-5"})
					</a>
					<div class="h-8 w-px bg-slate-200 hidden sm:block"></div>
					<div class="flex items-center gap-3">
						<div class="p-2 rounded-xl bg-primary/10 text-primary hidden sm:flex">
							@icon.FileText(icon.Props{Class: "h-5 w-5"})
						</div>
						<div>
							<h1 class="text-base font-bold text-slate-900 leading-none mb-1">{ param.Exam.Title }</h1>
							<p class="text-[11px] font-medium text-slate-500 uppercase tracking-wider leading-none">{ param.Subject.Title }</p>
						</div>
					</div>
				</div>
				<div class="flex items-center gap-4">
					<!-- Timer -->
					<div id="exam-timer" class="flex items-center gap-2 px-4 py-2 rounded-lg bg-primary/5 border border-primary/10 text-primary transition-all duration-300">
						@icon.Clock(icon.Props{Class: "h-4 w-4"})
						<span id="timer-display" class="font-mono text-sm font-bold tracking-tight">--:--:--</span>
					</div>
					<!-- Submit Button -->
					@dialog.Trigger(dialog.TriggerProps{For: "submit-exam-dialog"}) {
						@button.Button(button.Props{
							Variant: button.VariantDefault,
							Class: "flex items-center gap-2",
							Attributes: templ.Attributes{
								"id": "submit-exam-btn",
							},
						}) {
							@icon.Send(icon.Props{Class: "h-4 w-4"})
							Submit Exam
						}
					}
				</div>
			</div>
			<!-- Timer Indicator Line (Decreasing) -->
			<div class="h-1.5 bg-slate-100 w-full overflow-hidden">
				<div id="progress-bar" class="h-full bg-primary transition-all duration-1000 ease-linear" style="width: 100%"></div>
			</div>
		</header>

		<!-- Questions -->
		<main class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
			<div class="w-full flex flex-col lg:flex-row gap-8 items-start">
				<!-- Questions -->
				<div class="flex-1 space-y-6 order-2 lg:order-1">
					<div class="space-y-6" id="question-list">
						for qIndex, question := range param.Questions {
							<div class="animate-in fade-in slide-in-from-bottom-4 duration-500"
								style={ fmt.Sprintf("animation-delay: %dms", (qIndex+1)*80) }
								id={ "question-" + question.ID.String() }>
								switch question.QuestionType {
									case string(domain.QuestionTypeText):
										@ExamQuestionItem(question, question.Choices, qIndex+1, param)
									case string(domain.QuestionTypeCode):
										@ExamQuestionCodeItem(question, question.Choices, qIndex+1, param)
									case string(domain.QuestionTypeImage):
										@ExamImageQuestionItem(question, question.Choices, qIndex+1, param)
								}
							</div>
						}
					</div>

					<!-- Bottom submit button -->
					<div class="mt-8 flex justify-center pb-8">
						@dialog.Trigger(dialog.TriggerProps{For: "submit-exam-dialog"}) {
							@button.Button(button.Props{
								Variant: button.VariantDefault,
								Class: "flex items-center gap-2 px-8 py-3",
							}) {
								@icon.Send(icon.Props{Class: "h-4 w-4"})
								Submit Exam
							}
						}
					</div>
				</div>

				<!-- Sidebar Indicator (Sticky) -->
				<aside class="w-full lg:w-80 shrink-0 order-1 lg:order-2 lg:sticky lg:top-24">
					<div class="bg-[#F9F8F7] rounded-lg p-6 border border-slate-200 shadow-sm">
						<div class="flex items-center justify-between mb-4">
							<h3 class="font-bold text-slate-900 flex items-center gap-2">
								@icon.LayoutGrid(icon.Props{Class: "h-4 w-4 text-primary"})
								Questions
							</h3>
							<span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">{ fmt.Sprintf("%d Total", len(param.Questions)) }</span>
						</div>
						
						<div class="grid grid-cols-5 sm:grid-cols-8 lg:grid-cols-5 gap-2">
							for qIndex, question := range param.Questions {
								@QuestionIndicator(question, qIndex, param)
							}
						</div>

						<div class="mt-6 pt-6 border-t border-slate-200/60">
							<div class="flex items-center justify-between text-xs mb-4">
								<span class="flex items-center gap-1.5 text-slate-500">
									<span class="w-2 h-2 rounded-full bg-primary"></span>
									Answered
								</span>
								<span class="flex items-center gap-1.5 text-slate-500">
									<span class="w-2 h-2 rounded-full bg-white border border-slate-200"></span>
									Pending
								</span>
							</div>
						</div>
					</div>
				</aside>
			</div>
		</main>
	</div>
	<div id="toast-container"></div>
	
	@dialog.Dialog(dialog.Props{ID: "submit-exam-dialog"}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() { Submit Exam }
				@dialog.Description() { Are you sure you want to submit this exam? You cannot change your answers after submission. }
			}
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						Close
					}
				}
				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Attributes: templ.Attributes{
						"hx-post": fmt.Sprintf("/student/exam/%s/submit", param.Exam.ID.String()),
						"hx-swap": "none",
					},
				}) {
					Submit
				}
			}
		}
	}

	<!-- Highlight.js init + Timer & Auto-submit Script -->
	<script>
	(function() {
		// Highlight all code blocks on page load
		if (typeof hljs !== 'undefined') {
			hljs.highlightAll();
		}

		const examPage = document.getElementById('exam-page');
		const examId = examPage.dataset.examId;
		const subjectId = examPage.dataset.subjectId;
		const durationMinutes = parseInt(examPage.dataset.duration);
		const timerDisplay = document.getElementById('timer-display');
		const timerContainer = document.getElementById('exam-timer');
		const progressBar = document.getElementById('progress-bar');
		
		let warningShown5 = false;
		let warningShown1 = false;
		let submitted = false;

		const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
		const wsUrl = protocol + '//' + window.location.host + '/student/subject/' + subjectId + '/ws';
		let socket = new WebSocket(wsUrl);

		function showToast(title, description, variant) {
			const toast = document.createElement('div');
			const duration = 5000;
			
			toast.setAttribute('data-tui-toast', '');
			toast.setAttribute('data-tui-toast-duration', duration.toString());
			toast.setAttribute('data-position', 'bottom-right');
			toast.setAttribute('data-variant', variant);
			
			// Base classes for the toast container to match templui
			toast.className = 'z-50 fixed pointer-events-auto p-4 w-full md:max-w-[420px] animate-in fade-in slide-in-from-bottom-4 duration-300 data-[position=bottom-right]:bottom-0 data-[position=bottom-right]:right-0';
			
			const icons = {
				warning: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-500 mr-3 flex-shrink-0"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>',
				error: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-500 mr-3 flex-shrink-0"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>',
				success: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500 mr-3 flex-shrink-0"><path d="M20 6 9 17l-5-5"/></svg>',
				info: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500 mr-3 flex-shrink-0"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>'
			};

			const progressClass = {
				warning: 'bg-yellow-500',
				error: 'bg-red-500',
				success: 'bg-green-500',
				info: 'bg-blue-500'
			};

			toast.innerHTML = `
				<div class="w-full bg-popover text-popover-foreground rounded-lg shadow-xs border pt-5 pb-4 px-4 flex items-center justify-center relative overflow-hidden group">
					<div class="absolute top-0 left-0 right-0 h-1 overflow-hidden">
						<div class="toast-progress h-full origin-left transition-transform ease-linear ${progressClass[variant] || 'bg-gray-500'}" 
							 data-variant="${variant}" data-duration="${duration}"></div>
					</div>
					${icons[variant] || ''}
					<span class="flex-1 min-w-0">
						<p class="text-sm font-semibold truncate">${title}</p>
						<p class="text-sm opacity-90 mt-1">${description}</p>
					</span>
					<button type="button" aria-label="Close" data-tui-toast-dismiss="" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground h-9 w-9">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-75 hover:opacity-100"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
					</button>
				</div>
			`;
			
			document.body.appendChild(toast);
		}

		socket.onmessage = function(event) {
			if (submitted) return;
			const data = JSON.parse(event.data);
			
			if (data.auto_submit) {
				submitted = true;
				timerDisplay.textContent = '00:00:00';
				socket.close();
				
				showToast('Exam Auto-Submitted', 'Time is up. Your exam has been automatically submitted.', 'warning');
				
				setTimeout(function() {
					window.location.href = '/student/subject/' + subjectId;
				}, 2000);
				return;
			}

			const totalSeconds = data.remaining_seconds;
			if (totalSeconds < 0) return;

			const hours = Math.floor(totalSeconds / 3600);
			const minutes = Math.floor((totalSeconds % 3600) / 60);
			const seconds = totalSeconds % 60;

			timerDisplay.textContent = String(hours).padStart(2, '0') + ':' + String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');

			// Timer Indicator Line (Decreasing only in the final minute/red state)
			let pct = 100;
			if (totalSeconds <= 60) {
				pct = Math.min(100, (totalSeconds / 60) * 100);
			}
			progressBar.style.width = pct + '%';

			// Color coding
			if (totalSeconds <= 60) {
				timerContainer.className = timerContainer.className.replace(/bg-\S+/g, '').trim();
				timerContainer.classList.add('bg-red-100', 'text-red-700');
				progressBar.classList.remove('bg-primary', 'bg-yellow-500');
				progressBar.classList.add('bg-red-500');
			} else if (totalSeconds <= 300) {
				timerContainer.className = timerContainer.className.replace(/bg-\S+/g, '').trim();
				timerContainer.classList.add('bg-yellow-100', 'text-yellow-800');
				progressBar.classList.remove('bg-primary', 'bg-red-500');
				progressBar.classList.add('bg-yellow-500');
			} else {
				timerContainer.className = timerContainer.className.replace(/bg-\S+/g, '').trim();
				timerContainer.classList.add('bg-primary/5', 'text-primary');
				progressBar.classList.remove('bg-red-500', 'bg-yellow-500');
				progressBar.classList.add('bg-primary');
				warningShown5 = false;
				warningShown1 = false;
			}

			// Warnings
			if (totalSeconds <= 300 && totalSeconds > 295 && !warningShown5) {
				warningShown5 = true;
				showToast('Warning', '5 minutes remaining!', 'warning');
			}
			if (totalSeconds <= 60 && totalSeconds > 55 && !warningShown1) {
				warningShown1 = true;
				showToast('Warning', '1 minute remaining! Your exam will be auto-submitted.', 'warning');
			}
		};

		socket.onerror = function(error) {
			console.error('Timer connection error');
		};

		// Update answered indicators on htmx:afterRequest
		document.body.addEventListener('htmx:afterRequest', function(event) {
			if (event.detail.successful && event.detail.requestConfig) {
				const body = event.detail.requestConfig.parameters;
				if (body && body.question_id) {
					const indicator = document.getElementById('answered-indicator-' + body.question_id);
					if (indicator) {
						indicator.classList.remove('bg-slate-200');
						indicator.classList.add('bg-primary');
					}
					const navIndicator = document.getElementById('nav-indicator-' + body.question_id);
					if (navIndicator) {
						navIndicator.classList.remove('bg-white', 'text-slate-400', 'border-slate-200', 'hover:border-primary/30', 'hover:text-primary', 'hover:bg-primary/5');
						navIndicator.classList.add('bg-primary', 'text-white', 'border-primary', 'shadow-primary/20', 'scale-105');
					}
					updateAnsweredCount();
				}
			}
		});

		function updateAnsweredCount() {
			const cards = document.querySelectorAll('.question-card');
			let answered = 0;
			cards.forEach(function(card) {
				const checked = card.querySelector('input[type="radio"]:checked');
				if (checked) answered++;
			});
		}
	})();
	</script>
}

// Text question card (same style as admin QuestionItem)
templ ExamQuestionItem(question domain.Question, choices []domain.Choice, number int, param ExamTakeParam) {
	@card.Card(card.Props{
		Class: "question-card mb-6",
	}) {
		@card.Header() {
			<div class="flex items-center justify-between gap-3 w-full">
				@card.Title() {
					<span class="font-bold">Q.{ fmt.Sprint(number) }. </span>
					<span class="latex-content">{ question.QuestionTitle }</span>
				}
				<div class="flex items-center gap-2">
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-auto"}) {
						{ fmt.Sprintf("%.2f", question.Marks) } Marks
					}
					<span id={ "answered-indicator-" + question.ID.String() }
						class={ "h-2 w-2 rounded-full transition-colors", templ.KV("bg-primary", isAnswered(param.AnsweredChoices, question.ID)), templ.KV("bg-slate-200", !isAnswered(param.AnsweredChoices, question.ID)) }>
					</span>
				</div>
			</div>
		}
		@card.Content() {
			<span class="latex-content">{ question.QuestionText }</span>
		}
		@card.Footer() {
			<div class="grid grid-cols-2 gap-3 w-full">
				for i, choice := range choices {
					@ExamChoiceItem(choice, question, number, fmt.Sprintf("%c", 'A'+i), param)
				}
			</div>
		}
	}
}

// Code question card (same style as admin QuestionCodeItem)
templ ExamQuestionCodeItem(question domain.Question, choices []domain.Choice, number int, param ExamTakeParam) {
	@card.Card(card.Props{
		Class: "question-card mb-6",
	}) {
		@card.Header() {
			<div class="flex items-center justify-between gap-3 w-full">
				@card.Title() {
					<span class="font-bold">Q.{ fmt.Sprint(number) }. </span>
					<span class="latex-content">{ question.QuestionTitle }</span>
				}
				<div class="flex items-center gap-2">
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-auto"}) {
						{ fmt.Sprintf("%.2f", question.Marks) } Marks
					}
					<span id={ "answered-indicator-" + question.ID.String() }
						class={ "h-2 w-2 rounded-full transition-colors", templ.KV("bg-primary", isAnswered(param.AnsweredChoices, question.ID)), templ.KV("bg-slate-200", !isAnswered(param.AnsweredChoices, question.ID)) }>
					</span>
				</div>
			</div>
		}
		@card.Content() {
			<div class="w-full rounded-md overflow-x-auto">
				<pre><code class="language-rust">{ question.QuestionText }</code></pre>
			</div>
		}
		@card.Footer() {
			<div class="grid grid-cols-2 gap-3 w-full">
				for i, choice := range choices {
					@ExamChoiceItem(choice, question, number, fmt.Sprintf("%c", 'A'+i), param)
				}
			</div>
		}
	}
}

// Image question card (same style as admin ImageQuestionItem)
templ ExamImageQuestionItem(question domain.Question, choices []domain.Choice, number int, param ExamTakeParam) {
	@card.Card(card.Props{
		Class: "question-card mb-6",
	}) {
		@card.Header() {
			<div class="flex items-center justify-between gap-3 w-full">
				@card.Title() {
					<span class="font-bold">Q.{ fmt.Sprint(number) }. </span>
					<span class="latex-content">{ question.QuestionTitle }</span>
				}
				<div class="flex items-center gap-2">
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-auto"}) {
						{ fmt.Sprintf("%.2f", question.Marks) } Marks
					}
					<span id={ "answered-indicator-" + question.ID.String() }
						class={ "h-2 w-2 rounded-full transition-colors", templ.KV("bg-primary", isAnswered(param.AnsweredChoices, question.ID)), templ.KV("bg-slate-200", !isAnswered(param.AnsweredChoices, question.ID)) }>
					</span>
				</div>
			</div>
		}
		@card.Content() {
			<div class="w-full rounded-md overflow-x-auto">
				<span class="latex-content">{ question.QuestionText }</span>
				@aspectratio.AspectRatio(aspectratio.Props{
					Ratio: aspectratio.RatioWide,
					Class: "rounded-md overflow-hidden",
				}) {
					<img
						src={ question.QuestionImage }
						alt="Question Image"
						class="h-full w-full object-cover"
					/>
				}
			</div>
		}
		@card.Footer() {
			<div class="grid grid-cols-2 gap-3 w-full">
				for i, choice := range choices {
					@ExamChoiceItem(choice, question, number, fmt.Sprintf("%c", 'A'+i), param)
				}
			</div>
		}
	}
}

// Choice item for exam taking - styled like admin ChoiceItem but with htmx answer submission
templ ExamChoiceItem(choice domain.Choice, question domain.Question, qIndex int, cIndex string, param ExamTakeParam) {
	@label.Label(label.Props{
		For:   fmt.Sprintf("q%d-option-%s", qIndex, cIndex),
		Class: "block cursor-pointer h-full",
	}) {
		@card.Card(card.Props{
			Class: "hover:border-primary/50 has-[:checked]:ring-1 has-[:checked]:ring-primary has-[:checked]:border-primary transition-all h-full",
		}) {
			@card.Content(card.ContentProps{
				Class: "p-3 flex items-center gap-3 h-full",
			}) {
				<input type="radio"
					id={ fmt.Sprintf("q%d-option-%s", qIndex, cIndex) }
					name={ fmt.Sprintf("question-%s", question.ID.String()) }
					value={ choice.ID.String() }
					class="peer hidden"
					checked?={ isSelected(param.AnsweredChoices, question.ID, choice.ID) }
					hx-post={ fmt.Sprintf("/student/exam/%s/answer", param.Exam.ID.String()) }
					hx-vals={ fmt.Sprintf(`{"question_id": "%s", "choice_id": "%s"}`, question.ID.String(), choice.ID.String()) }
					hx-swap="none"
					hx-trigger="change"
				/>
				<div class="transition-all w-8 h-8 flex items-center justify-center rounded-sm shrink-0 bg-muted text-muted-foreground peer-checked:bg-primary peer-checked:text-white">
					<span>{ cIndex }</span>
				</div>
				<div class="flex-1">
					<p class="text-md leading-tight font-medium">
						{ choice.ChoiceText }
					</p>
				</div>
			}
		}
	}
}

func isAnswered(answeredChoices map[uuid.UUID]uuid.UUID, questionID uuid.UUID) bool {
	_, ok := answeredChoices[questionID]
	return ok
}

func isSelected(answeredChoices map[uuid.UUID]uuid.UUID, questionID uuid.UUID, choiceID uuid.UUID) bool {
	selected, ok := answeredChoices[questionID]
	return ok && selected == choiceID
}

templ QuestionIndicator(question domain.Question, qIndex int, param ExamTakeParam) {
	<a href={ templ.SafeURL("#question-" + question.ID.String()) }
		id={ "nav-indicator-" + question.ID.String() }
		class={
			"flex items-center justify-center w-10 h-10 rounded-xl text-sm font-bold transition-all border shadow-sm",
			templ.KV("bg-primary text-white border-primary shadow-primary/20 scale-105", isAnswered(param.AnsweredChoices, question.ID)),
			templ.KV("bg-white text-slate-400 border-slate-200 hover:border-primary/30 hover:text-primary hover:bg-primary/5", !isAnswered(param.AnsweredChoices, question.ID)),
		}>
		{ fmt.Sprint(qIndex + 1) }
	</a>
}
