package student_dashboard

import "fmt"
import "uot-exam/internal/domain"
import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/badge"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/button"
import "uot-exam/web/templates/components/toast"
import "uot-exam/web/templates/components/sidebar"
import "uot-exam/web/templates/components/collapsible"
import "uot-exam/web/templates/components/dropdown"
import "uot-exam/web/templates/components/popover"
import "uot-exam/web/templates/components/navbar"

templ SubjectViewPage(param SubjectViewParam) {
	<div class="h-screen">
		@sidebar.Script()
		@collapsible.Script()
		@dropdown.Script()
		@popover.Script()
		@toast.Script()
		@Navbar([]navbar.BreadPath{
			{
				Path: "Dashboard",
				Href: "/student/dashboard",
			},
			{
				Path: param.Subject.Title,
				Href: fmt.Sprintf("/student/subject/%s", param.Subject.ID.String()),
			},
		}) {

			{{
				attrs := templ.Attributes{
					"id": "subject-page",
					"data-subject-id": param.Subject.ID.String(),
				}
				if param.ExamEndTime != nil {
					attrs["data-end-time"] = param.ExamEndTime.Format("2006-01-02T15:04:05Z07:00")
				}
			}}
		<!-- Main Content -->
		<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" { attrs... }>
			<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
					@icon.BookOpen(icon.Props{Class: "h-8 w-8 text-primary"})
					{ param.Subject.Title }
				</h1>
				if param.ExamEndTime != nil && !param.AllSubmitted {
					<div id="subject-timer" class="flex items-center gap-3 px-4 py-2 rounded-2xl bg-[#F9F8F7] border border-slate-200 shadow-xl shadow-primary/5 transition-all hover:border-primary/30 animate-in fade-in zoom-in duration-500">
						<div class="flex items-center justify-center w-10 h-10 rounded-xl bg-primary/10 text-primary shrink-0">
							@icon.Clock(icon.Props{Class: "h-5 w-5"})
						</div>
						<div class="flex flex-col">
							<span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none mb-1">Time Remaining</span>
							<span id="timer-display" class="text-slate-900 font-mono text-lg font-black tracking-tight leading-none">--:--:--</span>
						</div>
					</div>
				}
			</div>

			<!-- Subject Info Card -->
			<div class="mb-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
				@card.Card() {
					@card.Content(card.ContentProps{Class: "p-6"}) {
						<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
							<div class="text-center">
								<p class="text-sm text-slate-500 mb-1">Duration</p>
								<p class="text-2xl font-bold text-slate-900 flex items-center justify-center gap-2">
									@icon.Clock(icon.Props{Class: "h-5 w-5 text-primary"})
									{ fmt.Sprintf("%d min", param.Subject.DurationMinutes) }
								</p>
							</div>
							<div class="text-center border-x border-slate-100">
								<p class="text-sm text-slate-500 mb-1">Total Marks</p>
								<p class="text-2xl font-bold text-slate-900">{ fmt.Sprintf("%.2f", param.Subject.TotalMarks) }</p>
							</div>
							<div class="text-center">
								<p class="text-sm text-slate-500 mb-1">Pass Score</p>
								<p class="text-2xl font-bold text-slate-900">{ fmt.Sprintf("%.2f", param.Subject.PassScore) }</p>
							</div>
						</div>

						{{
							var hasAttempt bool
							var submittedCount int
							for _, info := range param.Exams {
								if info.Attempt != nil {
									hasAttempt = true
									if info.Attempt.Status == domain.AttemptStatusSubmitted || info.Attempt.Status == domain.AttemptStatusGraded {
										submittedCount++
									}
								}
							}
							progressPercent := 0
							if len(param.Exams) > 0 {
								progressPercent = int((float64(submittedCount) / float64(len(param.Exams))) * 100)
							}
						}}
						if hasAttempt {
							<div class="mt-4 pt-6 border-t border-slate-100">
								<div class="flex items-center justify-end text-sm mb-2">
									<span class="text-slate-500">{ fmt.Sprintf("%d/%d Exams", submittedCount, len(param.Exams)) }</span>
								</div>
								<div class="w-full bg-slate-100 rounded-full h-2.5">
									<div class="bg-primary h-2.5 rounded-full transition-all duration-500" style={ fmt.Sprintf("width: %d%%", progressPercent) }></div>
								</div>
							</div>
						}
					}
				}
			</div>

			<!-- Exams List -->
			<div class="mb-4 mt-6">
				<h2 class="text-2xl font-bold text-slate-900 mb-4">Exams</h2>
			</div>

			if len(param.Exams) == 0 {
				@card.Card(card.Props{Class: "animate-in fade-in slide-in-from-bottom-4 duration-500 p-5"}) {
					@card.Content(card.ContentProps{Class: "p-12 text-center"}) {
						@icon.FileText(icon.Props{Class: "h-12 w-12 text-slate-300 mx-auto mb-4"})
						<h3 class="text-lg font-semibold text-slate-600 mb-2">No Exams Available</h3>
						<p class="text-slate-400">No published exams for this subject yet.</p>
					}
				}
			} else {
				<div class="space-y-4">
					for i, info := range param.Exams {
						<div class={ fmt.Sprintf("animate-in fade-in slide-in-from-bottom-4 duration-500 delay-%d", (i+1)*100) }>
							@ExamCard(info, param.AllSubmitted, param.Subject.DurationMinutes)
						</div>
					}
				</div>
			}
		</main>
		}
	</div>
	<div id="toast-container"></div>
	if param.ExamEndTime != nil && !param.AllSubmitted {
		<script>
		(function() {
			const subjectPage = document.getElementById('subject-page');
			if (!subjectPage) return;
			const subjectId = subjectPage.dataset.subjectId;
			const timerDisplay = document.getElementById('timer-display');
			const timerContainer = document.getElementById('subject-timer');
			let submitted = false;

			const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
			const wsUrl = protocol + '//' + window.location.host + '/student/subject/' + subjectId + '/ws';
			let socket = new WebSocket(wsUrl);

			socket.onmessage = function(event) {
				if (submitted) return;
				const data = JSON.parse(event.data);
				
				if (data.auto_submit) {
					submitted = true;
					if (timerDisplay) timerDisplay.textContent = '00:00:00';
					socket.close();
					window.location.reload();
					return;
				}

				const totalSeconds = data.remaining_seconds;
				if (totalSeconds < 0) return;

				const hours = Math.floor(totalSeconds / 3600);
				const minutes = Math.floor((totalSeconds % 3600) / 60);
				const seconds = totalSeconds % 60;
				
				timerDisplay.textContent = String(hours).padStart(2, '0') + ':' + String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');

				// Color coding
				if (totalSeconds <= 60 && timerContainer) {
					timerContainer.className = timerContainer.className.replace(/bg-\S+/g, '').trim();
					timerContainer.classList.add('bg-red-100', 'text-red-700');
				}
			};

			socket.onerror = function(error) {
				console.error('Timer connection error');
			};
		})();
		</script>
	}
}

templ ExamCard(info ExamInfo, allSubmitted bool, durationMinutes int32) {
	@card.Card(card.Props{
		Class: "hover:shadow-md transition-shadow",
	}) {
		@card.Content(card.ContentProps{Class: "p-5"}) {
			<div class="flex items-center justify-between">
				<div class="flex-1">
					<div class="flex items-center gap-3 mb-1">
						<h3 class="font-semibold text-lg text-slate-900">{ info.Exam.Title }</h3>
						@ExamStatusBadge(info)
					</div>
					if info.Exam.Description != nil && *info.Exam.Description != "" {
						<p class="text-sm text-slate-500 mb-3">{ *info.Exam.Description }</p>
					}
					<div class="flex items-center gap-4 text-sm mt-2 text-slate-500">
						<span class="flex items-center gap-1">
							@icon.Target(icon.Props{Class: "h-3.5 w-3.5"})
							{ fmt.Sprintf("%.2f marks", info.Exam.TotalMarks) }
						</span>
						if info.Attempt != nil && allSubmitted && info.Attempt.Score != nil {
							<span class="flex items-center gap-1 font-medium text-primary">
								@icon.Award(icon.Props{Class: "h-3.5 w-3.5"})
								{ fmt.Sprintf("Score: %.2f / %.2f", *info.Attempt.Score, info.Exam.TotalMarks) }
							</span>
						}
					</div>
				</div>
				<div class="shrink-0 ml-4">
					if info.Attempt == nil {
						<!-- Not started -->
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Class: "flex items-center gap-2",
							Attributes: templ.Attributes{
								"hx-post": fmt.Sprintf("/student/exam/%s/start", info.Exam.ID.String()),
								"hx-swap": "none",
							},
						}) {
							@icon.Play(icon.Props{Class: "h-4 w-4"})
							Start Exam
						}
					} else if info.Attempt.Status == domain.AttemptStatusInProgress {
						<!-- In progress - resume -->
						@button.Button(button.Props{
							Variant: button.VariantSecondary,
							Class: "flex items-center gap-2",
							Attributes: templ.Attributes{
								"hx-post": fmt.Sprintf("/student/exam/%s/start", info.Exam.ID.String()),
								"hx-swap": "none",
							},
						}) {
							@icon.RotateCcw(icon.Props{Class: "h-4 w-4"})
							Resume
						}
					} else {
						<!-- Submitted -->
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Disabled: true,
							Class: "flex items-center gap-2",
						}) {
							@icon.Check(icon.Props{Class: "h-4 w-4"})
							Submitted
						}
					}
				</div>
			</div>
		}
	}
}

templ ExamStatusBadge(info ExamInfo) {
	if info.Attempt == nil {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
			Not Started
		}
	} else if info.Attempt.Status == domain.AttemptStatusInProgress {
		@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
			In Progress
		}
	} else if info.Attempt.Status == domain.AttemptStatusSubmitted {
		@badge.Badge(badge.Props{Variant: badge.VariantDefault}) {
			Submitted
		}
	} else if info.Attempt.Status == domain.AttemptStatusGraded {
		@badge.Badge(badge.Props{Class: "bg-blue-500 text-white border-transparent"}) {
			Graded
		}
	}
}
