package student_dashboard

import "fmt"
import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/badge"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/button"
import "uot-exam/web/templates/components/toast"
import "uot-exam/web/templates/components/navbar"

templ ResultPage(param ResultParam) {
	@toast.Script()
	<div class="min-h-screen bg-slate-50/50">
		@Navbar([]navbar.BreadPath{
			{
				Path: "Dashboard",
				Href: "/student/dashboard",
			},
			{
				Path: param.Subject.Title + " Results",
				Href: fmt.Sprintf("/student/subject/%s/result", param.Subject.ID.String()),
			},
		}) {
			<div class="max-w-5xl mx-auto space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
				<!-- Success Header -->
				<div class="text-center space-y-4">
					<div class="inline-flex items-center justify-center p-3 bg-green-100 rounded-full text-green-600 mb-2">
						@icon.Trophy(icon.Props{Class: "h-12 w-12"})
					</div>
					<h1 class="text-4xl font-extrabold text-slate-900 tracking-tight">Congratulations!</h1>
					<p class="text-lg text-slate-500 max-w-2xl mx-auto">
						You have successfully completed all exams for <span class="font-semibold text-slate-900">{ param.Subject.Title }</span>. 
						Below is a summary of your performance.
					</p>
				</div>

				<!-- Stats Overview -->
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					@card.Card(card.Props{Class: "bg-white shadow-sm border-slate-200/60"}) {
						@card.Content(card.ContentProps{Class: "p-6 flex flex-col items-center justify-center text-center"}) {
							<p class="text-sm font-medium text-slate-500 mb-1">Total Score</p>
							<div class="flex items-baseline gap-1">
								<span class="text-4xl font-bold text-primary">{ fmt.Sprintf("%d", param.TotalSubjectScore) }</span>
								<span class="text-slate-400 font-medium">/ { fmt.Sprintf("%d", param.MaxPossibleScore) }</span>
							</div>
						}
					}
					@card.Card(card.Props{Class: "bg-white shadow-sm border-slate-200/60"}) {
						@card.Content(card.ContentProps{Class: "p-6 flex flex-col items-center justify-center text-center"}) {
							<p class="text-sm font-medium text-slate-500 mb-1">Percentage</p>
							<div class="text-4xl font-bold text-slate-900">
								if param.MaxPossibleScore > 0 {
									{ fmt.Sprintf("%.1f%%", float64(param.TotalSubjectScore) / float64(param.MaxPossibleScore) * 100) }
								} else {
									0%
								}
							</div>
						}
					}
					@card.Card(card.Props{Class: "bg-white shadow-sm border-slate-200/60"}) {
						@card.Content(card.ContentProps{Class: "p-6 flex flex-col items-center justify-center text-center"}) {
							<p class="text-sm font-medium text-slate-500 mb-1">Status</p>
							if param.TotalSubjectScore >= param.Subject.PassScore {
								@badge.Badge(badge.Props{Class: "bg-green-100 text-green-700 border-green-200 px-4 py-1 text-sm"}) {
									Passed
								}
							} else {
								@badge.Badge(badge.Props{Variant: badge.VariantDestructive, Class: "px-4 py-1 text-sm"}) {
									Failed
								}
							}
						}
					}
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
					<!-- Radar Chart -->
					@card.Card(card.Props{Class: "bg-white shadow-sm border-slate-200/60"}) {
						@card.Header() {
							@card.Title() { Performance Analysis }
							@card.Description() { Score distribution across individual exams }
						}
						@card.Content(card.ContentProps{Class: "p-6 aspect-square max-w-md mx-auto"}) {
							<canvas id="performanceRadarChart"></canvas>
						}
					}

					<!-- Exam List -->
					@card.Card(card.Props{Class: "bg-white shadow-sm border-slate-200/60"}) {
						@card.Header() {
							@card.Title() { Exam Breakdown }
							@card.Description() { Detailed scores for each completed component }
						}
						@card.Content(card.ContentProps{Class: "p-0"}) {
							<div class="divide-y divide-slate-100">
								for _, res := range param.ExamResults {
									<div class="p-4 flex items-center justify-between hover:bg-slate-50/50 transition-colors">
										<div class="flex items-center gap-3">
											<div class="p-2 bg-slate-100 rounded-lg text-slate-500">
												@icon.FileText(icon.Props{Class: "h-5 w-5"})
											</div>
											<div>
												<p class="font-medium text-slate-900">{ res.Title }</p>
												<p class="text-xs text-slate-500">{ fmt.Sprintf("%d possible marks", res.TotalMarks) }</p>
											</div>
										</div>
										<div class="text-right">
											<p class="font-bold text-slate-900">{ fmt.Sprintf("%d", res.Score) }</p>
											if res.TotalMarks > 0 {
												<p class="text-xs text-slate-500">{ fmt.Sprintf("%.0f%%", float64(res.Score) / float64(res.TotalMarks) * 100) }</p>
											}
										</div>
									</div>
								}
							</div>
						}
					}
				</div>

				<!-- Actions -->
				<div class="flex items-center justify-center gap-4 pt-4 pb-12">
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Class: "flex items-center gap-2 h-12 px-6",
						Attributes: templ.Attributes{
							"onclick": fmt.Sprintf("window.location.href='/student/subject/%s/pdf'", param.Subject.ID.String()),
						},
					}) {
						@icon.Download(icon.Props{Class: "h-5 w-5"})
						Download PDF Report
					}
					@button.Button(button.Props{
						Class: "flex items-center gap-2 h-12 px-6",
						Attributes: templ.Attributes{
							"onclick": "window.location.href='/student/dashboard'",
						},
					}) {
						@icon.LayoutDashboard(icon.Props{Class: "h-5 w-5"})
						Back to Dashboard
					}
				</div>
			</div>
		}
	</div>

	<!-- Chart.js and Initialization -->
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const ctx = document.getElementById('performanceRadarChart').getContext('2d');
			
			// Extract data from server-side rendering
			const labels = [];
			const scores = [];
			
			// These will be populated by Templ Loop (simulated here with injected JS)
			{
				for _, res := range param.ExamResults {
					labels.push(res.Title);
					if res.TotalMarks > 0 {
						scores.push((res.Score / res.TotalMarks) * 100);
					} else {
						scores.push(0);
					}
				}
			}

			new Chart(ctx, {
				type: 'radar',
				data: {
					labels: labels,
					datasets: [{
						label: 'Performance %',
						data: scores,
						fill: true,
						backgroundColor: 'rgba(59, 130, 246, 0.2)',
						borderColor: 'rgb(59, 130, 246)',
						pointBackgroundColor: 'rgb(59, 130, 246)',
						pointBorderColor: '#fff',
						pointHoverBackgroundColor: '#fff',
						pointHoverBorderColor: 'rgb(59, 130, 246)'
					}]
				},
				options: {
					elements: {
						line: {
							borderWidth: 3
						}
					},
					scales: {
						r: {
							angleLines: {
								display: true
							},
							suggestedMin: 0,
							suggestedMax: 100,
							ticks: {
								stepSize: 20
							}
						}
					},
					plugins: {
						legend: {
							display: false
						}
					}
				}
			});
		});
	</script>
}
