package student_dashboard

import "fmt"
import "uot-exam/web/templates/components/card"
import "uot-exam/web/templates/components/badge"
import "uot-exam/web/templates/components/icon"
import "uot-exam/web/templates/components/button"
import "uot-exam/web/templates/components/toast"
import "uot-exam/web/templates/components/navbar"
import "uot-exam/web/templates/components/chart"

templ ResultPage(param ResultParam) {
	@toast.Script()
	@chart.Script()
	<div class="h-screen">
		@Navbar([]navbar.BreadPath{
			{
				Path: "Dashboard",
				Href: "/student/dashboard",
			},
			{
				Path: param.Subject.Title + " Results",
				Href: fmt.Sprintf("/student/subject/%s/result", param.Subject.ID.String()),
			},
		}) {
			<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
				<!-- Result Header -->
				<div class="text-center space-y-4">
					if param.TotalSubjectScore >= param.Subject.PassScore {
						<div class="inline-flex items-center justify-center p-4 bg-green-100 rounded-full text-green-600 mb-2 shadow-sm ring-4 ring-green-50">
							@icon.CircleCheckBig(icon.Props{Class: "h-12 w-12"})
						</div>
						<h1 class="text-4xl font-extrabold text-slate-900 tracking-tight">Congratulations!</h1>
						<p class="text-lg text-slate-500 max-w-2xl mx-auto">
							You have successfully completed all exams for <span class="font-semibold text-slate-900">{ param.Subject.Title }</span> and reached the passing score.
						</p>
					} else {
						<div class="inline-flex items-center justify-center p-4 bg-red-100 rounded-full text-red-600 mb-2 shadow-sm ring-4 ring-red-50">
							@icon.CircleX(icon.Props{Class: "h-12 w-12"})
						</div>
						<h1 class="text-4xl font-extrabold text-slate-900 tracking-tight">Results Published</h1>
						<p class="text-lg text-slate-500 max-w-2xl mx-auto">
							You have completed the exams for <span class="font-semibold text-slate-900">{ param.Subject.Title }</span>. 
							Unfortunately, you didn't reach the required passing score this time.
						</p>
					}
				</div>

				<!-- Stats Overview -->
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					@card.Card(card.Props{Class: "bg-white shadow-sm border-slate-200/60"}) {
						@card.Content(card.ContentProps{Class: "p-6 flex flex-col items-center justify-center text-center"}) {
							<p class="text-sm font-medium text-slate-500 mb-1">Total Score</p>
							<div class="flex items-baseline gap-1">
								<span class="text-4xl font-bold text-primary">{ fmt.Sprintf("%.2f", param.TotalSubjectScore) }</span>
								<span class="text-slate-400 font-medium">/ { fmt.Sprintf("%.2f", param.Subject.TotalMarks) }</span>
							</div>
						}
					}
					@card.Card(card.Props{Class: "bg-white shadow-sm border-slate-200/60"}) {
						@card.Content(card.ContentProps{Class: "p-6 flex flex-col items-center justify-center text-center"}) {
							<p class="text-sm font-medium text-slate-500 mb-1">Percentage</p>
							<div class="text-4xl font-bold text-slate-900">
								if param.Subject.TotalMarks > 0 {
									{ fmt.Sprintf("%.2f%%", param.TotalSubjectScore / param.Subject.TotalMarks * 100) }
								} else {
									0%
								}
							</div>
						}
					}
					@card.Card(card.Props{Class: "bg-white shadow-sm border-slate-200/60"}) {
						@card.Content(card.ContentProps{Class: "p-6 flex flex-col items-center justify-center text-center"}) {
							<p class="text-sm font-medium text-slate-500 mb-1">Status</p>
							if param.TotalSubjectScore >= param.Subject.PassScore {
								@badge.Badge(badge.Props{Variant: badge.VariantSuccess, Class: "px-4 py-1 text-sm"}) {
									Passed
								}
							} else {
								@badge.Badge(badge.Props{Variant: badge.VariantDestructive, Class: "px-4 py-1 text-sm"}) {
									Failed
								}
							}
						}
					}
				</div>
				<div>
				
					<!-- Exam List -->
					@card.Card(card.Props{Class: "bg-white shadow-sm border-slate-200/60 mt-6 md:col-span-2"}) {
						@card.Header() {
							@card.Title() { Exam Breakdown }
							@card.Description() { Detailed scores for each completed component }
						}
						@card.Content(card.ContentProps{Class: "p-0"}) {
							<div class="divide-y divide-slate-100">
								for _, res := range param.ExamResults {
									<details class="group hover:bg-slate-50/50 transition-colors border-b border-slate-100 last:border-0">
										<summary class="p-4 flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden">
											<div class="flex items-center gap-3">
												<div class="p-2 bg-slate-100 rounded-lg text-slate-500 group-open:bg-primary/10 group-open:text-primary transition-colors">
													@icon.FileText(icon.Props{Class: "h-5 w-5"})
												</div>
												<div>
													<p class="font-medium text-slate-900">{ res.Title }</p>
													<p class="text-xs text-slate-500">{ fmt.Sprintf("%.2f possible marks", res.TotalMarks) }</p>
												</div>
											</div>
											<div class="text-right flex items-center gap-4">
												<div>
													<p class="font-bold text-slate-900">{ fmt.Sprintf("%.2f", res.Score) }</p>
													if res.TotalMarks > 0 {
														<p class="text-xs text-slate-500">{ fmt.Sprintf("%.2f%%", res.Score / res.TotalMarks * 100) }</p>
													}
												</div>
												@icon.ChevronDown(icon.Props{Class: "h-5 w-5 text-slate-400 group-open:rotate-180 transition-transform"})
											</div>
										</summary>
										<div class="px-4 pb-4 pt-2 border-t border-slate-100/50 bg-slate-50/30">
											<div class="space-y-2">
												for _, q := range res.Questions {
													<div class="flex items-center justify-between p-2 rounded-lg hover:bg-white/50 transition-colors">
														<p class="text-sm text-slate-600 font-medium">{ q.Title }</p>
														if q.IsCorrect {
															<div class="flex items-center justify-center w-7 h-7 rounded-full bg-green-50 text-green-600 border border-green-100">
																@icon.CircleCheck(icon.Props{Class: "h-4 w-4"})
															</div>
														} else {
															<div class="flex items-center justify-center w-7 h-7 rounded-full bg-red-50 text-red-600 border border-red-100">
																@icon.CircleX(icon.Props{Class: "h-4 w-4"})
															</div>
														}
													</div>
												}
											</div>
										</div>
									</details>
								}
							</div>
						}
					}
				</div>

				<!-- Actions -->
				<div class="flex items-center justify-center gap-4 pt-4 pb-12">
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Class: "flex items-center gap-2 h-12 px-6",
						Attributes: templ.Attributes{
							"onclick": fmt.Sprintf("window.location.href='/student/subject/%s/pdf'", param.Subject.ID.String()),
						},
					}) {
						@icon.Download(icon.Props{Class: "h-5 w-5"})
						Download PDF Report
					}
					@button.Button(button.Props{
						Class: "flex items-center gap-2 h-12 px-6",
						Attributes: templ.Attributes{
							"onclick": "window.location.href='/student/dashboard'",
						},
					}) {
						@icon.LayoutDashboard(icon.Props{Class: "h-5 w-5"})
						Back to Dashboard
					}
				</div>
			</main>
		}
	</div>
}
